#!/bin/bash
# Prometheus Station - execute les boutons de la page Mises a jour.
# La page depose un fichier vide dans /srv/prometheus/commande ; ce programme le lit et l'execute.
DOSSIER=/srv/prometheus/commande
for F in "$DOSSIER"/*; do
  [ -f "$F" ] || continue
  ORDRE=$(basename "$F")
  CONTENU=$(head -c 300 "$F")   # certains ordres portent une precision (ex. le fichier a supprimer)
  rm -f "$F"
  case "$ORDRE" in
    mettre-a-jour)
      echo "Mise a jour demandee depuis la page"
      systemctl start --no-block prometheus-telechargement.service
      sleep 5 ;;
    verifier)
      echo "Verification demandee depuis la page"
      # Liste des mises a jour du systeme (sans rien installer), au plus une fois par heure
      if [ -z "$(find /var/lib/apt/lists -maxdepth 0 -mmin -60 2>/dev/null)" ]; then
        timeout 120 apt-get -o DPkg::Lock::Timeout=60 update -qq >/dev/null 2>&1 || true
        touch /var/lib/apt/lists
      fi ;;
    systeme)
      echo "Mise a jour du systeme demandee depuis la page"
      # Garde nos fichiers de reglage (--force-confold) ; tourne a part pour ne pas bloquer la page
      if ! systemctl is-active --quiet prometheus-maj-systeme; then
        systemctl reset-failed prometheus-maj-systeme 2>/dev/null
        systemd-run --unit=prometheus-maj-systeme --description="Prometheus Station - mise a jour du systeme" \
          --setenv=DEBIAN_FRONTEND=noninteractive bash -c \
          'O="-o DPkg::Lock::Timeout=600 -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"
           apt-get $O update -qq && apt-get $O -y full-upgrade && apt-get $O -y autoremove
           echo $? > /srv/prometheus/.maj-systeme ; /usr/local/bin/prometheus-etat'
      fi
      sleep 3 ;;
    redemarrer)
      echo "Redemarrage demande depuis la page"
      /usr/local/bin/prometheus-etat
      systemd-run --on-active=5 systemctl reboot
      exit 0 ;;
    restaurer)
      # Fichier depose par Parametres > Sauvegarde > Remettre une sauvegarde
      echo "Remise d'une sauvegarde demandee depuis la page"
      F=/srv/prometheus/restauration/sauvegarde.tar.gz
      if [ -f "$F" ] && /usr/local/bin/prometheus-restaurer "$F"; then
        echo "ok $(date +%s)" > /srv/prometheus/.restauration
        rm -f "$F"
        /usr/local/bin/prometheus-etat
        systemd-run --on-active=5 systemctl reboot   # les wifis et le nom du wifi sont repris au redemarrage
        exit 0
      fi
      echo "refuse $(date +%s)" > /srv/prometheus/.restauration
      rm -f "$F" ;;
    sauvegarder)
      echo "Sauvegarde demandee depuis la page"
      /usr/local/bin/prometheus-sauvegarde ;;
    supprimer-*)
      # Le contenu de l'ordre = le nom du fichier a supprimer (un nom simple, jamais un chemin)
      NOM=$CONTENU
      case "$NOM" in */*|.*|"") echo "Suppression refusee : nom invalide" ; continue ;; esac
      if [ -f "/srv/prometheus/encyclopedies/$NOM" ] && [[ "$NOM" == *.zim ]]; then
        rm -f "/srv/prometheus/encyclopedies/$NOM"
        # On ne la retelecharge plus : on la retire de la liste des contenus
        BASE=$(echo "$NOM" | sed -E 's/_[0-9]{4}-[0-9]{2}[a-z]?\.zim$//')
        sed -i "/^${BASE}\$/d" /srv/prometheus/contenus.txt
        runuser -u prometheus -- /usr/local/bin/prometheus-catalogue
        runuser -u prometheus -- /usr/local/bin/prometheus-index-livres >/dev/null
        systemctl restart prometheus-kiwix   # libere vraiment la place (Kiwix gardait le fichier ouvert)
        echo "Encyclopedie supprimee : $NOM"
      elif [ -f "/srv/prometheus/bibliotheque/$NOM" ] && [[ "${NOM,,}" == *.epub || "${NOM,,}" == *.pdf ]]; then
        rm -f "/srv/prometheus/bibliotheque/$NOM"
        runuser -u prometheus -- /usr/local/bin/prometheus-index-livres >/dev/null
        echo "Livre supprime : $NOM"
      else
        echo "Suppression refusee : $NOM introuvable"
      fi ;;
    *) echo "Ordre inconnu ignore : $ORDRE" ;;
  esac
done
/usr/local/bin/prometheus-etat
exit 0
