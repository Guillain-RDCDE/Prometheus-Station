def mt_distant(p):
    """{id, quoi: lire|ecrire|proprietaire|canal|infos|action, section, genre, valeurs, action}"""
    from meshtastic.protobuf import admin_pb2
    distance_permise()
    num, n = noeud_distant(p.get('id'))
    quoi = p.get('quoi')
    ident = 'd' + secrets.token_hex(5)
    a = admin_pb2.AdminMessage()
    type_ = 'distant-config'
    if quoi == 'lire':
        section, genre = str(p.get('section', '')), p.get('genre')
        if genre == 'config':
            try:
                a.get_config_request = admin_pb2.AdminMessage.ConfigType.Value(section.upper() + '_CONFIG')
            except ValueError:
                raise Refus('Section inconnue.')
        elif genre == 'module':
            try:
                a.get_module_config_request = admin_pb2.AdminMessage.ModuleConfigType.Value(section.upper() + '_CONFIG')
            except ValueError:
                raise Refus('Section inconnue.')
        else:
            raise Refus('Section inconnue.')
    elif quoi == 'proprietaire':
        a.get_owner_request = True
        type_ = 'distant-proprietaire'
    elif quoi == 'canal':
        i = p.get('index')
        if type(i) is not int or not 0 <= i < 8:
            raise Refus('Canal invalide.')
        a.get_channel_request = i + 1
        type_ = 'distant-canal'
    elif quoi == 'infos':
        a.get_device_metadata_request = True
        type_ = 'distant-infos'
    elif quoi == 'ecrire':
        # On ecrit a partir des reglages lus juste avant (la radio d'en face exige une lecture recente)
        section, genre, valeurs = str(p.get('section', '')), p.get('genre'), p.get('valeurs')
        lu = next((r for r in reversed(lire(RESULTATS, [])) if r.get('type') == 'distant-config' and r.get('noeud') == ident_de_num(num)
                   and (r.get('donnees') or {}).get('section') == section), None)
        if not lu or time.time() - lu['heure'] > 280:
            raise Refus('Relisez d’abord cette section (la radio exige une lecture de moins de 5 minutes).')
        from meshtastic.protobuf import config_pb2, module_config_pb2
        racine = config_pb2.Config() if genre == 'config' else module_config_pb2.ModuleConfig()
        if section not in racine.DESCRIPTOR.fields_by_name or not isinstance(valeurs, dict):
            raise Refus('Section inconnue.')
        from google.protobuf.json_format import ParseDict
        actuel = getattr(racine, section)
        ParseDict(lu['donnees']['valeurs'], actuel, ignore_unknown_fields=True)
        getattr(a.set_config if genre == 'config' else a.set_module_config, section).CopyFrom(appliquer(actuel, valeurs))
        type_ = 'distant-ecrit'
    elif quoi == 'action':
        act = p.get('action')
        if act == 'redemarrer':
            a.reboot_seconds = 5
        elif act == 'eteindre':
            a.shutdown_seconds = 5
        elif act == 'oublier-tout':
            a.nodedb_reset = True
        elif act == 'heure':
            a.set_time_only = int(time.time())
        else:
            raise Refus('Action inconnue.')
        type_ = 'distant-action'
    else:
        raise Refus('Demande inconnue.')

    def rappel(packet, ident=ident, type_=type_):
        demandes.pop(ident, None)
        d = packet.get('decoded') or {}
        r = d.get('routing') or {}
        if r.get('errorReason') not in (None, 'NONE'):
            noter_resultat(type_, ident_de_num(num), {'erreur': r['errorReason']}, ident)
        elif 'admin' in d:
            noter_resultat(type_, ident_de_num(num), reponse_admin(d), ident)
        else:
            noter_resultat(type_, ident_de_num(num), {'accuse': True}, ident)
    # Envoi a la main (et non n._sendAdmin) : une ecriture n'a pas de reponse, seulement un accuse de reception,
    # que la bibliotheque ne transmet que si on le demande (onResponseAckPermitted) ; vu le 19/10/2026
    from meshtastic.protobuf import portnums_pb2
    cle = radio._getOrCreateByNum(num).get('adminSessionPassKey')
    if cle:
        a.session_passkey = cle
    lecture = type_ not in ('distant-ecrit', 'distant-action')
    radio.sendData(a, num, portNum=portnums_pb2.PortNum.ADMIN_APP, wantAck=True, wantResponse=lecture, onResponse=rappel,
                   onResponseAckPermitted=not lecture, channelIndex=radio.localNode._getAdminChannelIndex(), pkiEncrypted=True)
    demander(type_, ident_de_num(num), ident, 180)
    return {'demande': ident}


