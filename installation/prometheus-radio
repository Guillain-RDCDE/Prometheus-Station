def ecrire_schema():
    """schema.json : la description de tous les reglages que connait la bibliotheque Meshtastic installee
    (nom, type, valeurs possibles). Les formulaires de la section Mesh en sont tires : aucun reglage oublie."""
    try:
        from meshtastic.protobuf import config_pb2, module_config_pb2, channel_pb2
        from google.protobuf.descriptor import FieldDescriptor as F
        TYPES = {F.TYPE_BOOL: 'bool', F.TYPE_STRING: 'texte', F.TYPE_BYTES: 'octets', F.TYPE_FLOAT: 'decimal',
                 F.TYPE_DOUBLE: 'decimal', F.TYPE_ENUM: 'choix', F.TYPE_MESSAGE: 'groupe', F.TYPE_FIXED32: 'ip'}

        def champs(desc, profondeur=0):
            res = []
            for f in desc.fields:
                c = {'nom': f.name, 'type': TYPES.get(f.type, 'entier'), 'repete': bool(getattr(f, 'is_repeated', False))}
                if f.type in (F.TYPE_INT32, F.TYPE_SINT32, F.TYPE_SFIXED32, F.TYPE_INT64, F.TYPE_SINT64):
                    c['signe'] = True
                if f.type == F.TYPE_ENUM:
                    c['valeurs'] = [v.name for v in f.enum_type.values]
                if f.type == F.TYPE_MESSAGE and profondeur < 3:
                    c['champs'] = champs(f.message_type, profondeur + 1)
                res.append(c)
            return res
        schema = {'config': {f.name: champs(f.message_type) for f in config_pb2.Config.DESCRIPTOR.fields
                             if f.name not in ('sessionkey',)},
                  'module': {f.name: champs(f.message_type) for f in module_config_pb2.ModuleConfig.DESCRIPTOR.fields},
                  'canal': champs(channel_pb2.ChannelSettings.DESCRIPTOR)}
        # Drapeaux : des cases a cocher dont la somme fait le nombre enregistre
        schema['drapeaux'] = {
            'config.position.position_flags': {v.name: v.number for v in config_pb2.Config.PositionConfig.PositionFlags.DESCRIPTOR.values},
            'config.network.enabled_protocols': {v.name: v.number for v in config_pb2.Config.NetworkConfig.ProtocolFlags.DESCRIPTOR.values}}
        import meshtastic.version
        schema['bibliotheque'] = meshtastic.version.get_active_version()
        ecrire(SCHEMA, schema)
    except Exception as e:
        print('Schema des reglages impossible :', e, flush=True)


