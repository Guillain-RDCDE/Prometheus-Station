def ordre_mesh(action, p):
    """Depose un ordre pour prometheus-radio et attend sa reponse (20 s au plus)."""
    ident = secrets.token_hex(8)
    os.makedirs(os.path.join(RADIO, 'ordres'), exist_ok=True)
    ecrire_public(os.path.join(RADIO, 'ordres', '%d-%s.json' % (time.time() * 1000, ident)),
                  json.dumps({'id': ident, 'action': action, 'p': p, 'heure': time.time()}, ensure_ascii=False))
    reponse = os.path.join(RADIO, 'reponses', ident + '.json')
    fin = time.time() + 20
    while time.time() < fin:
        r = lire_json(reponse, None)
        if r:
            return r
        time.sleep(0.25)
    return {'id': ident, 'attente': True}


def historique(q):
    """Lecture de l'historique (SQLite ecrit par prometheus-radio)."""
    import sqlite3
    chemin = os.path.join(RADIO, 'historique.db')
    if not os.path.exists(chemin):
        return []
    db = sqlite3.connect('file:%s?mode=ro' % chemin, uri=True, timeout=5)
    try:
        def nombre(cle, defaut):
            try:
                return float(q.get(cle, [defaut])[0])
            except (TypeError, ValueError):
                return defaut
        quoi = q.get('quoi', [''])[0]
        depuis = nombre('depuis', time.time() - 86400)
        limite = int(min(max(nombre('limite', 300), 1), 5000))
        noeud = q.get('noeud', [''])[0][:80]
        res_ = q.get('reseau', [''])[0]
        filtre_reseau = ' AND reseau = ?' if res_ in ('meshtastic', 'meshcore') else ''
        arg_reseau = (res_,) if filtre_reseau else ()
        if quoi == 'paquets':
            sql = 'SELECT heure, reseau, sens, de, nom, a, port, canal, snr, rssi, sauts, relais, resume FROM paquets WHERE heure > ?' + filtre_reseau
            args = [depuis, *arg_reseau]
            if noeud:
                sql += ' AND (de = ? OR a = ?)'
                args += [noeud, noeud]
            port = q.get('port', [''])[0]
            if port:
                sql += ' AND port = ?'
                args.append(port[:40])
            lignes = db.execute(sql + ' ORDER BY heure DESC LIMIT ?', (*args, limite)).fetchall()
            cles = ('heure', 'reseau', 'sens', 'de', 'nom', 'a', 'port', 'canal', 'snr', 'rssi', 'sauts', 'relais', 'resume')
            return [dict(zip(cles, l[:-1] + (json.loads(l[-1]) if l[-1] else None,))) for l in lignes]
        if quoi == 'stats':
            # Une valeur par tranche (300 tranches au plus sur la periode demandee)
            pas = max(60, (time.time() - depuis) / 300)
            lignes = db.execute('SELECT MAX(heure), reseau, donnees FROM stats WHERE heure > ?' + filtre_reseau +
                                ' GROUP BY CAST(heure / ? AS INTEGER), reseau ORDER BY 1', (depuis, *arg_reseau, pas)).fetchall()
            return [dict(json.loads(l[2]), heure=l[0], reseau=l[1]) for l in lignes]
        if quoi == 'signal':
            lignes = db.execute('SELECT heure, snr, rssi, sauts, port FROM paquets WHERE de = ? AND heure > ? AND sens = ? '
                                'ORDER BY heure DESC LIMIT ?', (noeud, depuis, 'recu', limite)).fetchall()
            return [dict(zip(('heure', 'snr', 'rssi', 'sauts', 'port'), l)) for l in reversed(lignes)]
        if quoi == 'telemetrie':
            lignes = db.execute('SELECT heure, donnees FROM telemetrie WHERE noeud = ? AND heure > ? ORDER BY heure DESC LIMIT ?',
                                (noeud, depuis, limite)).fetchall()
            return [dict(json.loads(l[1]), heure=l[0]) for l in reversed(lignes)]
        if quoi == 'comptes':
            # Paquets par genre, par radio et par heure sur la periode : le resume de la page Statistiques
            par_genre = db.execute('SELECT port, sens, COUNT(*) FROM paquets WHERE heure > ?' + filtre_reseau + ' GROUP BY port, sens',
                                   (depuis, *arg_reseau)).fetchall()
            par_radio = db.execute('SELECT de, MAX(nom), COUNT(*), AVG(snr), MAX(heure) FROM paquets WHERE heure > ? AND sens = ?' +
                                   filtre_reseau + ' GROUP BY de ORDER BY 3 DESC LIMIT 50', (depuis, 'recu', *arg_reseau)).fetchall()
            pas = 3600 if time.time() - depuis <= 2 * 86400 else 86400
            par_heure = db.execute('SELECT CAST(heure / ? AS INTEGER) * ?, sens, COUNT(*) FROM paquets WHERE heure > ?' + filtre_reseau +
                                   ' GROUP BY 1, sens ORDER BY 1', (pas, pas, depuis, *arg_reseau)).fetchall()
            total = db.execute('SELECT COUNT(*), MIN(heure) FROM paquets').fetchone()
            return {'par_genre': [{'port': a, 'sens': b, 'n': c} for a, b, c in par_genre],
                    'par_radio': [{'id': a, 'nom': b, 'n': c, 'snr': d, 'vu': e} for a, b, c, d, e in par_radio],
                    'par_tranche': [{'heure': a, 'sens': b, 'n': c} for a, b, c in par_heure], 'pas': pas,
                    'total': total[0], 'premier': total[1], 'taille': os.path.getsize(chemin)}
        return []
    finally:
        db.close()


def port_station():
    """Le port de la T-Beam de la station (nom dans /dev/serial/by-id) : celui note par l'outil radio, sinon sa puce."""
    ports = [os.path.basename(p) for p in sorted(glob.glob('/dev/serial/by-id/*'))]
    note = lire_json(os.path.join(RADIO, 'reseau.json'), {}).get('port')
    if note in ports:
        return note
    return next((p for p in ports if any(m in p for m in ('1a86', 'CP210', 'Silicon_Labs'))), '')


def sauvegardes_mesh():
    """Les reglages gardes avant chaque changement (section Mesh et outil radio), les plus recents d'abord."""
    res = []
    for f in glob.glob(os.path.join(RADIO, 'mesh-sauvegardes', '*')):
        try:
            premiere = open(f, errors='replace').readline().strip()
        except OSError:
            continue
        raison = premiere[len('# Prometheus Station - '):] if premiere.startswith('# Prometheus Station - ') else ''
        if f.endswith('.json'):
            raison = lire_json(f, {}).get('raison', '')
        res.append({'fichier': os.path.basename(f), 'heure': os.path.getmtime(f), 'raison': raison,
                    'reseau': 'meshcore' if os.path.basename(f).startswith('meshcore') else 'meshtastic'})
    return sorted(res, key=lambda x: -x['heure'])


