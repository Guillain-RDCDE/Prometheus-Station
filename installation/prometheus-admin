def personnes():
    """Combien de personnes sont connectees. Wifi de la station ouvert : les telephones accroches a ce wifi.
    Sinon (a la maison) : les appareils qui ont une page de la station ouverte depuis moins de 3 minutes
    (chaque page interroge la station chaque minute)."""
    def lancer(*a):
        try:
            return subprocess.run(a, capture_output=True, text=True, timeout=10).stdout
        except Exception:
            return ''
    if lancer('nmcli', '-g', 'GENERAL.CONNECTION', 'device', 'show', 'wlan0').strip() == 'prometheus-wifi':
        return sum(1 for l in lancer('/usr/sbin/iw', 'dev', 'wlan0', 'station', 'dump').splitlines() if l.startswith('Station'))
    maintenant = time.time()
    for ip in [ip for ip, t in VUS.items() if maintenant - t > 3600]:
        del VUS[ip]
    return sum(1 for t in VUS.values() if maintenant - t < 180)


def sante():
    """Temperature du processeur, tension (relevee par prometheus-tension), duree depuis l'allumage."""
    t = lire_fichier('/sys/class/thermal/thermal_zone0/temp')
    try:
        v = int(lire_fichier('/run/prometheus/tension'), 16)
    except ValueError:
        v = None
    # bit 0 : tension trop basse en ce moment ; bit 16 : elle l'a ete depuis l'allumage
    tension = None if v is None else 'basse' if v & 0x1 else 'basse_avant' if v & 0x10000 else 'ok'
    return {'temperature': round(int(t) / 1000) if t.isdigit() else None, 'tension': tension,
            'allumee': int(float(lire_fichier('/proc/uptime', '0').split()[0])), 'personnes': personnes()}


def regler_heure(ms):
    """Sans internet, le Pi ne sait pas l'heure (pas de pile) : on prend celle du telephone.
    Seulement si la station n'est pas a l'heure par internet et qu'elle a plus de 2 minutes d'ecart."""
    try:
        tel = float(ms) / 1000
    except (TypeError, ValueError):
        return False
    if not 1.7e9 < tel < 4.1e9 or abs(tel - time.time()) < 120:
        return False
    sync = subprocess.run(['timedatectl', 'show', '-p', 'NTPSynchronized', '--value'],
                          capture_output=True, text=True).stdout.strip()
    if sync == 'yes':
        return False
    # Le service a le droit de regler l'horloge (CAP_SYS_TIME, voir prometheus-admin.service)
    return subprocess.run(['date', '-s', '@%d' % tel], capture_output=True).returncode == 0


class Admin(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def repondre(self, code, donnees=None, cookie=None):
        corps = json.dumps(donnees or {}).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Cache-Control', 'no-store')
        if cookie:
            self.send_header('Set-Cookie', cookie)
        self.send_header('Content-Length', str(len(corps)))
        self.end_headers()
        self.wfile.write(corps)

    def jeton(self):
        c = SimpleCookie(self.headers.get('Cookie', ''))
        return c['prometheus'].value if 'prometheus' in c else ''

    def connecte(self):
        j = self.jeton()
        return bool(j) and j in sessions()

    def ouvrir_session(self):
        s = sessions()
        j = secrets.token_urlsafe(32)
        s[j] = time.time() + DUREE
        ecrire(SESSIONS, json.dumps(s))
        return 'prometheus=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict' % (j, DUREE)

    def lire(self):
        n = int(self.headers.get('Content-Length') or 0)
        try:
            # 64 Ko au plus (le texte du panneau d'accueil) ; nginx limite deja les pages publiques a 4 Ko
            return json.loads(self.rfile.read(min(n, 65536)) or b'{}')
        except ValueError:
            return {}

    def do_GET(self):
        if self.path.startswith('/api/'):
            VUS[self.headers.get('X-Real-IP', '?')] = time.time()
        if self.path == '/recherches':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            try:
                r = json.load(open(RECHERCHES))
            except (OSError, ValueError):
                r = {}
            sujets = sorted(({'lien': l, 'titre': v['titre'], 'n': v['n']} for l, v in r.items()), key=lambda x: -x['n'])[:30]
            return self.repondre(200, {'sujets': sujets, 'epingles': reglages()['recherches']['epingles']})
        if self.path.startswith('/mesh/') or self.path == '/mesh':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            from urllib.parse import urlsplit, parse_qs
            u = urlsplit(self.path)
            q = parse_qs(u.query)
            if u.path == '/mesh/reponse':
                ident = ''.join(c for c in q.get('id', [''])[0] if c.isalnum())[:32]
                r = lire_json(os.path.join(RADIO, 'reponses', ident + '.json'), None) if ident else None
                return self.repondre(200, r or {'id': ident, 'attente': True})
            if u.path == '/mesh/resultats':
                try:
                    depuis = float(q.get('depuis', ['0'])[0])
                except ValueError:
                    depuis = 0
                return self.repondre(200, {'resultats': [r for r in lire_json(os.path.join(RADIO, 'resultats.json'), [])
                                                         if r.get('heure', 0) > depuis], 'maintenant': time.time()})
            if u.path == '/mesh/historique':
                try:
                    return self.repondre(200, {'donnees': historique(q), 'maintenant': time.time()})
                except Exception as e:
                    return self.repondre(500, {'erreur': 'Historique illisible : %s' % e})
            if u.path == '/mesh/schema':
                return self.repondre(200, lire_json(os.path.join(RADIO, 'schema.json'), {}))
            if u.path == '/mesh/sauvegardes':
                return self.repondre(200, {'sauvegardes': sauvegardes_mesh()})
            if u.path == '/mesh/atelier':
                return self.repondre(200, {'atelier': lire_json(os.path.join(RADIO, 'atelier.json'), {}),
                                           'outil': lire_json(os.path.join(RADIO, 'outil.json'), {}),
                                           'catalogue': lire_json(os.path.join(RADIO, 'catalogue.json'), {}),
                                           'suivies': lire_json(os.path.join(RADIO, 'cartes-suivies.json'), {}),
                                           'station': port_station(),
                                           'toutes_cartes': reglages()['mesh']['toutes_cartes'],
                                           'ports': [os.path.basename(p) for p in sorted(glob.glob('/dev/serial/by-id/*'))],
                                           'maintenant': time.time()})
            return self.repondre(404)
        if self.path == '/radio':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            def lu(nom, defaut):
                try:
                    return json.load(open(os.path.join(RADIO, nom)))
                except (OSError, ValueError):
                    return defaut
            reseau = lu('reseau.json', {})
            outil = lu('outil.json', {})
            # Radios branchees en USB autres que celle de la station (les T-Echo), vues en direct, avec ce que
            # l'outil radio en sait (logiciel, version, nom ; par numero de serie, qui ne change pas)
            ports = sorted(glob.glob('/dev/serial/by-id/*'))
            station = next((p for p in ports if any(m in p for m in ('1a86', 'CP210', 'Silicon_Labs'))), None)
            if reseau.get('port') and '/dev/serial/by-id/' + reseau['port'] in ports:
                station = '/dev/serial/by-id/' + reseau['port']   # le port de la T-Beam, note par l'outil radio
            connus = outil.pop('t_echo', {})
            outil['radios'] = []
            for p in ports:
                if p == station:
                    continue
                m = re.search(r'_([0-9A-Fa-f]{12,})-if\d+$', p)
                serie = m.group(1).upper() if m else ''
                fiche = dict(connus.get(serie, {}))
                # Le logiciel note ne vaut que si le port est toujours le meme (sinon il a change de logiciel)
                if fiche.get('port') != os.path.basename(p):
                    fiche = {'nom': fiche.get('nom', '')}
                outil['radios'].append(dict(fiche, port=os.path.basename(p), serie=serie))
            return self.repondre(200, {'etat': etat_radio(True), 'maintenant': time.time(),
                                       'details': lu('details.json', {}), 'journal': lu('journal.json', []),
                                       # outil radio : versions gardees, sauvegardes, radios branchees (outil.json)
                                       'outil': outil,
                                       'reseau': {'reseau': reseau.get('reseau', 'meshtastic'), 'puce': reseau.get('puce')},
                                       # section Mesh : ses reglages, et le garde-fou en cours apres un reglage risque
                                       'mesh': reglages()['mesh'], 'garde_fou': lu('garde-fou.json', None)})
        if self.path == '/api/messages':
            with VERROU:
                fusionner_radio()
            admin = self.connecte()
            return self.repondre(200, {'messages': lire_messages(), 'maintenant': time.time(),
                                       'admin': admin, 'radio': etat_radio(admin)})
        if self.path == '/api/radio':
            return self.repondre(200, etat_radio(self.connecte()))
        if self.path == '/api/panneau':
            return self.repondre(200, {'texte': lire_fichier(PANNEAU)})
        if self.path == '/api/reglages':
            return self.repondre(200, reglages())
        if self.path == '/api/registre':
            r = reglages()['registre']
            return self.repondre(200, {'fiches': [publique(f) for f in lire_liste(REGISTRE)], 'maintenant': time.time(),
                                       'admin': self.connecte(), 'active': r['active'], 'lieu': r['lieu']})
        if self.path == '/api/entraide':
            r = reglages()['entraide']
            return self.repondre(200, {'annonces': [publique(a) for a in entraide_valables(lire_liste(ENTRAIDE))],
                                       'maintenant': time.time(), 'admin': self.connecte(), 'active': r['active'],
                                       'categories': r['categories'], 'duree': r['duree']})
        if self.path == '/verif':
            self.repondre(200 if self.connecte() else 401)
        elif self.path == '/etat':
            self.repondre(200, {'defini': os.path.exists(MDP), 'connecte': self.connecte()})
        elif self.path == '/energie':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            self.repondre(200, energie())
        elif self.path == '/sante':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            self.repondre(200, sante())
        else:
            self.repondre(404)

    def do_POST(self):
        d = self.lire()
        ip = self.headers.get('X-Real-IP', '?')

        if self.path == '/api/messages':
            texte = ' '.join(str(d.get('texte', '')).split())[:500]
            nom = ' '.join(str(d.get('nom', '')).split())[:40]
            if not texte:
                return self.repondre(400, {'erreur': 'Message vide.'})
            par_radio = d.get('radio') is True
            if par_radio:
                r = etat_radio(self.connecte())
                if not r['active']:
                    return self.repondre(403, {'erreur': 'Cette fonction est désactivée.'})
                if not r['peut']:
                    return self.repondre(403, {'erreur': 'Réservé à l’administrateur.'})
                # Le nom part devant le texte : sur les radios, tout semble venir de la station
                envoi = (nom + ' : ' if nom else '') + texte
                if len(envoi.encode()) > r['max']:
                    return self.repondre(400, {'erreur': 'Trop long pour la radio.'})
                if time.time() - DERNIER_RADIO.get(ip, 0) < r['delai']:
                    return self.repondre(429, {'erreur': 'Un seul message radio à la fois : réessayez dans un moment.'})
            if time.time() - DERNIER_MESSAGE.get(ip, 0) < 20:
                return self.repondre(429, {'erreur': 'Attendez quelques secondes avant le message suivant.'})
            DERNIER_MESSAGE[ip] = time.time()
            message = {'id': secrets.token_hex(6), 'heure': time.time(), 'nom': nom, 'texte': texte}
            with VERROU:
                if par_radio:
                    DERNIER_RADIO[ip] = time.time()
                    message['radio'] = 'attente'
                    f = os.path.join(RADIO, 'a-envoyer', '%d-%s.json' % (time.time() * 1000, message['id']))
                    ecrire_public(f, json.dumps({'id': message['id'], 'texte': envoi}, ensure_ascii=False))
                m = lire_messages()
                m.insert(0, message)
                ecrire_public(MESSAGES, json.dumps(m[:MAX_MESSAGES], ensure_ascii=False))
            return self.repondre(200)

        if self.path == '/api/messages/effacer':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                m = [x for x in lire_messages() if x.get('id') != d.get('id')]
                ecrire_public(MESSAGES, json.dumps(m, ensure_ascii=False))
                annuler_radio({str(d.get('id'))})
            return self.repondre(200)

        if self.path == '/api/messages/vider':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                ecrire_public(MESSAGES, '[]')
                annules = annuler_radio()
            return self.repondre(200, {'annules': annules})

        if self.path == '/api/heure':
            return self.repondre(200, {'regle': regler_heure(d.get('ms'))})

        # ----- Registre « sain et sauf / je cherche quelqu'un » et entraide « je cherche / je propose »
        if self.path in ('/api/registre', '/api/entraide'):
            fonction = self.path[5:]
            r = reglages()[fonction]
            if not r['active']:
                return self.repondre(403, {'erreur': 'Cette fonction est désactivée.'})
            def champ(nom, n):
                return ' '.join(str(d.get(nom, '')).split())[:n]
            if fonction == 'registre':
                fiche = {'type': d.get('type'), 'nom': champ('nom', 60), 'lieu': champ('lieu', 80) if r['lieu'] else '',
                         'message': champ('message', 300)}
                if fiche['type'] not in ('sauf', 'cherche') or len(fiche['nom']) < 2:
                    return self.repondre(400, {'erreur': 'Indiquez un nom.'})
                chemin = REGISTRE
            else:
                fiche = {'type': d.get('type'), 'categorie': d.get('categorie'), 'texte': champ('texte', 300),
                         'nom': champ('nom', 40), 'contact': champ('contact', 80)}
                if fiche['type'] not in ('cherche', 'propose') or fiche['categorie'] not in r['categories']:
                    return self.repondre(400, {'erreur': 'Réglage invalide.'})
                if not fiche['texte']:
                    return self.repondre(400, {'erreur': 'Message vide.'})
                chemin = ENTRAIDE
            if time.time() - DERNIER_ENVOI.get((ip, fonction), 0) < 20:
                return self.repondre(429, {'erreur': 'Attendez quelques secondes avant le message suivant.'})
            DERNIER_ENVOI[(ip, fonction)] = time.time()
            fiche.update({'id': secrets.token_hex(6), 'cle': secrets.token_urlsafe(16), 'heure': time.time()})
            with VERROU:
                liste = lire_liste(chemin)
                if fonction == 'entraide':
                    liste = entraide_valables(liste)   # les annonces perimees partent a cette occasion
                liste.insert(0, fiche)
                os.makedirs(COMMUNAUTE, exist_ok=True)
                ecrire_public(chemin, json.dumps(liste[:MAX_FICHES], ensure_ascii=False))
            return self.repondre(200, {'id': fiche['id'], 'cle': fiche['cle']})

        if self.path == '/api/recherche':
            titre = ' '.join(str(d.get('titre', '')).split())[:120]
            lien = str(d.get('lien', ''))[:400]
            if not titre or not lien.startswith('/encyclopedies/content/') or any(c in lien for c in '"<> '):
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            if time.time() - DEJA_COMPTE.get((ip, lien), 0) < 3600:
                return self.repondre(200)   # deja compte pour ce telephone dans l'heure
            DEJA_COMPTE[(ip, lien)] = time.time()
            if len(DEJA_COMPTE) > 20000:
                DEJA_COMPTE.clear()
            with VERROU:
                try:
                    r = json.load(open(RECHERCHES))
                except (OSError, ValueError):
                    r = {}
                e = r.setdefault(lien, {'titre': titre, 'n': 0})
                e['n'] += 1
                if len(r) > 2000:   # on garde les 2 000 sujets les plus demandes
                    r = dict(sorted(r.items(), key=lambda x: -x[1]['n'])[:2000])
                os.makedirs(COMMUNAUTE, exist_ok=True)
                ecrire_public(RECHERCHES, json.dumps(r, ensure_ascii=False))
            return self.repondre(200)

        if self.path in ('/api/registre/effacer', '/api/entraide/effacer'):
            chemin = REGISTRE if 'registre' in self.path else ENTRAIDE
            admin = self.connecte()
            with VERROU:
                liste = lire_liste(chemin)
                garde = [f for f in liste if not (f.get('id') == d.get('id') and
                                                   (admin or hmac.compare_digest(str(f.get('cle', '')), str(d.get('cle', '')))))]
                if len(garde) == len(liste):
                    return self.repondre(403, {'erreur': 'Effacement refusé.'})
                ecrire_public(chemin, json.dumps(garde, ensure_ascii=False))
            return self.repondre(200)

        if self.path in ('/api/registre/vider', '/api/entraide/vider'):
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                ecrire_public(REGISTRE if 'registre' in self.path else ENTRAIDE, '[]')
            return self.repondre(200)

        echecs, quand = ESSAIS.get(ip, (0, 0))
        if echecs >= 5 and time.time() - quand < 60:
            return self.repondre(429, {'erreur': 'Trop d’essais. Attendez une minute.'})

        if self.path == '/premier':
            if os.path.exists(MDP):
                return self.repondre(403, {'erreur': 'Le mot de passe est déjà choisi.'})
            if len(d.get('nouveau', '')) < 4:
                return self.repondre(400, {'erreur': 'Au moins 4 caractères.'})
            ecrire(MDP, hacher(d['nouveau']))
            return self.repondre(200, {}, self.ouvrir_session())

        if self.path == '/connexion':
            if bon(d.get('mdp', '')):
                ESSAIS.pop(ip, None)
                return self.repondre(200, {}, self.ouvrir_session())
            ESSAIS[ip] = (echecs + 1, time.time())
            return self.repondre(401, {'erreur': 'Mot de passe incorrect.'})

        if self.path == '/changer':
            if not self.connecte() or not bon(d.get('ancien', '')):
                ESSAIS[ip] = (echecs + 1, time.time())
                return self.repondre(401, {'erreur': 'Ancien mot de passe incorrect.'})
            if len(d.get('nouveau', '')) < 4:
                return self.repondre(400, {'erreur': 'Au moins 4 caractères.'})
            ecrire(MDP, hacher(d['nouveau']))
            ecrire(SESSIONS, '{}')   # deconnecte tous les autres appareils
            return self.repondre(200, {}, self.ouvrir_session())

        if self.path == '/theme':
            nom = os.path.basename(str(d.get('nom', '')))
            source = os.path.join(THEMES, nom + '.css')
            if not self.connecte() or not os.path.isfile(source):
                return self.repondre(400, {'erreur': 'Couleurs inconnues.'})
            with open(THEME_ACTIF, 'w') as f:
                f.write(open(source).read())
            with open(THEME_CHOIX, 'w') as f:
                f.write(nom)
            return self.repondre(200)

        if self.path == '/wifi':
            nom = str(d.get('nom', '')).strip()
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            if not 1 <= len(nom.encode()) <= 32 or any(ord(c) < 32 for c in nom):
                return self.repondre(400, {'erreur': 'Entre 1 et 32 caractères.'})
            ecrire(os.path.join(DOSSIER, 'ssid-demande'), nom)
            return self.repondre(200)

        if self.path == '/adresse':
            nom = str(d.get('nom', '')).strip().lower()
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            if not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?', nom):
                return self.repondre(400, {'erreur': 'Lettres minuscules, chiffres et tirets seulement.'})
            ecrire(os.path.join(DOSSIER, 'nom-demande'), nom)
            return self.repondre(200)

        if self.path in ('/recherches/epingler', '/recherches/vider'):
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                if self.path.endswith('vider'):
                    ecrire_public(RECHERCHES, '{}')
                    return self.repondre(200)
                lien = str(d.get('lien', ''))[:400]
                titre = ' '.join(str(d.get('titre', '')).split())[:120]
                if not titre or not lien.startswith('/encyclopedies/content/') or any(c in lien for c in '"<> '):
                    return self.repondre(400, {'erreur': 'Réglage invalide.'})
                tout = reglages()
                ep = [x for x in tout['recherches']['epingles'] if x.get('lien') != lien]
                if d.get('epingle') is True:
                    if len(ep) >= MAX_EPINGLES:
                        return self.repondre(400, {'erreur': 'Huit sujets au plus.'})
                    ep.append({'titre': titre, 'lien': lien})
                tout['recherches']['epingles'] = ep
                os.makedirs(COMMUNAUTE, exist_ok=True)
                ecrire_public(REGLAGES, json.dumps(tout, ensure_ascii=False))
            return self.repondre(200, {'epingles': ep})

        if self.path == '/radio/envoyer':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            r = etat_radio(True)
            if not r['active']:
                return self.repondre(403, {'erreur': 'Cette fonction est désactivée.'})
            texte = ' '.join(str(d.get('texte', '')).split())
            canal, a = d.get('canal', 0), str(d.get('a') or '')
            if not texte:
                return self.repondre(400, {'erreur': 'Message vide.'})
            if len(texte.encode()) > r['max']:
                return self.repondre(400, {'erreur': 'Trop long pour la radio.'})
            if type(canal) is not int or not 0 <= canal < 8 or len(a) > 80 or any(c in a for c in '/\\"<> '):
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            ident = 'r' + secrets.token_hex(6)
            f = os.path.join(RADIO, 'a-envoyer', '%d-%s.json' % (time.time() * 1000, ident))
            ecrire_public(f, json.dumps({'id': ident, 'texte': texte, 'canal': canal, 'a': a}, ensure_ascii=False))
            return self.repondre(200, {'id': ident})

        if self.path == '/mesh/ordre':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            action, p = d.get('action'), d.get('p', {})
            if action not in ORDRES_MESH or not isinstance(p, dict):
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            if not reglages()['radio']['active']:
                return self.repondre(403, {'erreur': 'La radio est désactivée dans les Paramètres.'})
            r = ordre_mesh(action, p)
            if r.get('attente'):
                return self.repondre(202, r)
            return self.repondre(200 if r.get('ok') else 400, r if r.get('ok') else {'erreur': r.get('erreur') or 'Refusé.'})

        if self.path == '/mesh/atelier/suivies':
            # Les cartes dont la station garde les logiciels (cochees dans l'atelier) : {meshtastic: [cibles], meshcore: [cartes]}
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            s = {}
            for k in ('meshtastic', 'meshcore'):
                v = d.get(k, [])
                if not isinstance(v, list) or len(v) > 300 or not all(isinstance(x, str) and re.fullmatch(r'[\w.+-]{1,60}', x) for x in v):
                    return self.repondre(400, {'erreur': 'Réglage invalide.'})
                s[k] = sorted(set(v))
            ecrire_public(os.path.join(RADIO, 'cartes-suivies.json'), json.dumps(s))
            return self.repondre(200, s)

        if self.path == '/radio/code':
            # Premier passage a MeshCore : le code a 6 chiffres affiche sur l'ecran de la radio (lu par prometheus-radio-outil)
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            code = str(d.get('code', '')).strip()
            if not re.fullmatch(r'\d{6}', code):
                return self.repondre(400, {'erreur': 'Six chiffres.'})
            ecrire_public(os.path.join(RADIO, 'code-ble'), code)
            return self.repondre(200)

        if self.path == '/effacer-ecrits':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                n = {'messages': len(lire_messages()), 'registre': len(lire_liste(REGISTRE)), 'entraide': len(lire_liste(ENTRAIDE))}
                ecrire_public(MESSAGES, '[]')
                n['radio_annules'] = annuler_radio()
                # Le journal de la page Radio aussi : prometheus-radio le vide en voyant cette demande
                ecrire_public(os.path.join(RADIO, 'effacer-journal'), '1')
                os.makedirs(COMMUNAUTE, exist_ok=True)
                ecrire_public(REGISTRE, '[]')
                ecrire_public(ENTRAIDE, '[]')
            return self.repondre(200, n)

        if self.path == '/reglages':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                s = regler(d.get('section'), d.get('valeurs'))
            if s is None:
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            if d.get('section') == 'radio':
                # Le mode sobre coupe les prises USB, sauf quand la radio est activee : on le lui fait reappliquer
                ecrire(os.path.join(DOSSIER, 'sobre-demande'), 'oui' if energie()['sobre'] else 'non')
            return self.repondre(200, s)

        if self.path == '/panneau':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            texte = str(d.get('texte', '')).replace('\r\n', '\n')
            if len(texte) > 20000:
                return self.repondre(400, {'erreur': 'Texte trop long.'})
            ecrire_public(PANNEAU, texte)
            return self.repondre(200)

        if self.path == '/energie':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            m = d.get('extinction')
            if m is not None and (type(m) is not int or not 0 <= m <= 1440):
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            if 'sobre' in d:
                ecrire(os.path.join(DOSSIER, 'sobre-demande'), 'oui' if d['sobre'] is True else 'non')
            if m is not None:
                ecrire_public(EXTINCTION, str(m))
                # Le compte repart de maintenant (le surveillant le tiendra a jour dans les 30 secondes)
                if m:
                    ecrire_public(EXTINCTION_RESTANT, str(m * 60))
                elif os.path.exists(EXTINCTION_RESTANT):
                    os.remove(EXTINCTION_RESTANT)
            return self.repondre(200, energie())

        self.repondre(404)


