def action_regler(texte):
    try:
        r = json.loads(texte)
        assert isinstance(r, dict)
    except (ValueError, AssertionError):
        raise Echec('Réglage invalide.')
    nom = ' '.join(str(r.get('nom', '')).split())[:36] if 'nom' in r else None
    court = str(r.get('court', ''))[:4] if 'court' in r else None
    if court is not None and len(court.encode()) > 4:
        raise Echec('Nom court : 4 octets au plus.')
    if 'role' in r and r['role'] not in ROLES:
        raise Echec('Rôle inconnu.')
    if 'preset' in r and r['preset'] not in PRESETS:
        raise Echec('Préréglage inconnu.')
    pos = r.get('position', 'absent')
    if pos not in ('absent', None):
        try:
            lat, lon = float(pos['lat']), float(pos['lon'])
            assert -90 <= lat <= 90 and -180 <= lon <= 180
        except (KeyError, TypeError, ValueError, AssertionError):
            raise Echec('Position invalide.')
    arreter_service()
    try:
        if reseau_actuel() == 'meshtastic':
            sauvegarder_meshtastic()
            dire('== Réglages Meshtastic')
            if nom:
                mt('--set-owner', nom)
            if court:
                mt('--set-owner-short', court)
            if 'role' in r:
                mt('--set', 'device.role', r['role'])
                attendre_meshtastic()
            if 'preset' in r:
                mt('--set', 'lora.modem_preset', r['preset'])
                attendre_meshtastic()
            if pos is None:
                mt('--remove-position')
            elif pos != 'absent':
                mt('--setlat', str(lat), '--setlon', str(lon))
            dire('   la radio s’appelle maintenant :', attendre_meshtastic())
        else:
            bluetooth(True)
            adresse = lire_json(RESEAU, {})['ble']

            async def regler():
                await meshcore_sauvegarder(adresse)
                mc = await meshcore_connecter(adresse)
                try:
                    dire('== Réglages MeshCore')
                    if nom:
                        await mc.commands.set_name(nom)
                    if pos is None:
                        await mc.commands.set_coords(0, 0)
                    elif pos != 'absent':
                        await mc.commands.set_coords(lat, lon)
                    await mc.commands.send_advert(flood=True)
                finally:
                    await mc.disconnect()
            asyncio.run(regler())
        dire('   réglages appliqués')
    finally:
        relancer_service()


def action_reseau(cible):
    if cible not in ('meshtastic', 'meshcore'):
        raise Echec('Réseau inconnu.')
    depart = reseau_actuel()
    if cible == depart:
        raise Echec('La station est déjà sur ' + cible.capitalize() + '.')
    dire('== Passage de', depart.capitalize(), 'à', cible.capitalize(), '— la radio sera hors réseau une à trois minutes')
    arreter_service()
    try:
        if cible == 'meshcore':
            puce = detecter_puce()
            fichier_logiciel('meshcore', 'station-complet', puce)        # avant d'effacer : le fichier existe ?
            sauvegarder_meshtastic()
            nom = re.search(r'^owner: (.+)$', open(os.path.join(SAUVEGARDES, 'meshtastic-dernier.yaml')).read(), re.M)
            nom = nom.group(1).strip().strip('"') if nom else 'Prometheus Station'
            try:
                installer_station('meshcore', complet=True)
                remise = remettre_memoire_meshcore()
                if remise:
                    time.sleep(8)        # esptool vient de la redemarrer, sur la memoire remise
                adresse = adresse_ble()
                bluetooth(True)
                # Memoire remise : le code fixe de la station ; sinon (toute premiere fois) le code lu sur l'ecran
                asyncio.run(appairer(adresse, PIN_BLE if remise else attendre_code()))
                noter_reseau(reseau='meshcore', ble=adresse)
                asyncio.run(meshcore_regler_depart(adresse, nom, remise))
            except Exception as e:
                dire('!! Échec :', e)
                dire('== Retour sur Meshtastic pour ne pas laisser la station sans radio')
                bluetooth(False)
                installer_station('meshtastic', complet=True)
                attendre_meshtastic()
                restaurer_meshtastic()
                noter_reseau(reseau='meshtastic')
                raise Echec('Le passage à MeshCore a échoué ; la radio est revenue sur Meshtastic.')
        else:
            fichier_logiciel('meshtastic', 'station-complet')
            bluetooth(True)
            adresse = lire_json(RESEAU, {}).get('ble') or adresse_ble()
            try:
                asyncio.run(meshcore_sauvegarder(adresse))
            except Exception as e:
                dire('!! Sauvegarde MeshCore impossible (', e, ') : on continue, les réglages MeshCore précédents restent gardés')
            bluetooth(False)
            copier_memoire_meshcore()
            installer_station('meshtastic', complet=True)
            attendre_meshtastic()
            restaurer_meshtastic()
            dire('   la radio s’appelle :', attendre_meshtastic())
            noter_reseau(reseau='meshtastic')
        dire('== La station est sur', cible.capitalize())
    finally:
        if reseau_actuel() == 'meshtastic':
            bluetooth(False)
        relancer_service()


def telecharger(url, attendu=None):
    req = urllib.request.Request(url, headers={'User-Agent': 'prometheus-station'})
    with urllib.request.urlopen(req, timeout=60) as r:
        donnees = r.read()
    if attendu and hashlib.sha256(donnees).hexdigest() != attendu:
        raise Echec('Fichier abîmé pendant le téléchargement : ' + url.rsplit('/', 1)[-1])
    return donnees


def github(depot):
    return json.loads(telecharger('https://api.github.com/repos/%s/releases?per_page=30' % depot))


def empreinte(asset):
    d = asset.get('digest') or ''
    return d[7:] if d.startswith('sha256:') else None


def action_chercher(_):
    puce = lire_json(RESEAU, {}).get('puce')
    dire('== Recherche des dernières versions stables (internet)')
    # Meshtastic : la derniere version qui n'est pas une « alpha » (pre-release)
    r = next(x for x in github('meshtastic/firmware') if not x['prerelease'] and not x['draft'])
    v = r['tag_name'].lstrip('v')
    d = os.path.join(LOGICIELS, 'meshtastic', v)
    if os.path.isdir(d):
        dire('   Meshtastic', v, ': déjà sur la station')
    else:
        dire('   Meshtastic', v, ': téléchargement…')
        os.makedirs(d + '.tmp', exist_ok=True)
        for prefixe, motifs in (('firmware-esp32-', (r'^firmware-tbeam-[0-9].*\.bin$',)),
                                ('firmware-nrf52840-', (r'^firmware-t-echo-[0-9].*\.uf2$', r'^firmware-t-echo-inkhud-.*\.uf2$'))):
            a = next(x for x in r['assets'] if x['name'].startswith(prefixe) and x['name'].endswith('.zip'))
            dire('     ', a['name'], '(%d Mo)' % (a['size'] // 1000000))
            z = zipfile.ZipFile(io.BytesIO(telecharger(a['browser_download_url'], empreinte(a))))
            for n in z.namelist():
                if any(re.match(m, os.path.basename(n)) for m in motifs):
                    with open(os.path.join(d + '.tmp', os.path.basename(n)), 'wb') as f:
                        f.write(z.read(n))
                    dire('       gardé :', os.path.basename(n))
        os.replace(d + '.tmp', d)
    # MeshCore : la derniere version « companion »
    r = next(x for x in github('meshcore-dev/MeshCore') if x['tag_name'].startswith('companion-v') and not x['prerelease'] and not x['draft'])
    v = r['tag_name'][len('companion-v'):]
    d = os.path.join(LOGICIELS, 'meshcore', v)
    if os.path.isdir(d):
        dire('   MeshCore', v, ': déjà sur la station')
    else:
        dire('   MeshCore', v, ': téléchargement…')
        os.makedirs(d + '.tmp', exist_ok=True)
        puces = [puce] if puce else ['SX1276', 'SX1262']
        motifs = [r'^Tbeam_%s_companion_radio_ble-' % p for p in puces] + [r'^LilyGo_T-Echo_companion_radio_(ble|usb)-.*\.uf2$']
        for a in r['assets']:
            if any(re.match(m, a['name']) for m in motifs) and a['name'].endswith(('.bin', '.uf2')):
                with open(os.path.join(d + '.tmp', a['name']), 'wb') as f:
                    f.write(telecharger(a['browser_download_url'], empreinte(a)))
                dire('       gardé :', a['name'])
        os.replace(d + '.tmp', d)
    # On garde les deux dernieres versions de chaque reseau
    for reseau in ('meshtastic', 'meshcore'):
        for vieux in versions(reseau)[GARDER_VERSIONS:]:
            shutil.rmtree(os.path.join(LOGICIELS, reseau, vieux))
            dire('   ancienne version retirée :', reseau, vieux)


def radios_branchees():
    """Les radios en USB autres que celle de la station (les T-Echo)."""
    try:
        station = port_station()
    except Echec:
        station = None
    return [p for p in sorted(glob.glob('/dev/serial/by-id/*')) if p != station]


def disque_uf2(attente=40):
    for _ in range(attente):
        for p in glob.glob('/dev/disk/by-label/*'):
            if os.path.basename(p).upper().endswith('BOOT'):
                return p
        time.sleep(1)
    return None


def installer_t_echo(port):
    """Met a jour un T-Echo branche en USB, sous Meshtastic, avec son fichier .uf2 (reglages gardes)."""
    fichier, version = fichier_logiciel('meshtastic', 't-echo')
    dire('== Mise à jour du T-Echo vers Meshtastic', version)
    code, sortie = lancer([MESHTASTIC, '--port', port, '--info'], montrer=False, delai=60)
    m = re.search(r'Owner: (.+?) \(', sortie)
    if code != 0 or not m:
        raise Echec('Ce T-Echo ne répond pas sous Meshtastic.')
    dire('   radio :', m.group(1))
    dire('   passage en mode mise à jour…')
    lancer([MESHTASTIC, '--port', port, '--enter-dfu'], montrer=False, delai=60)
    disque = disque_uf2()
    if not disque:
        raise Echec('Le T-Echo n’est pas passé en mode mise à jour.')
    point = '/run/prometheus-uf2'
    os.makedirs(point, exist_ok=True)
    if subprocess.run(['mount', disque, point]).returncode != 0:
        raise Echec('Impossible d’ouvrir le disque du T-Echo.')
    try:
        dire('   copie de', os.path.basename(fichier))
        shutil.copyfile(fichier, os.path.join(point, os.path.basename(fichier)))
        os.sync()
    finally:
        subprocess.run(['umount', point])
    dire('   écrit ; le T-Echo redémarre')
    time.sleep(15)
    for p in glob.glob('/dev/serial/by-id/*'):
        if p == port:
            code, sortie = lancer([MESHTASTIC, '--port', port, '--info'], montrer=False, delai=60)
            v = re.search(r'"firmwareVersion": "([^"]+)"', sortie)
            dire('   version installée :', v.group(1) if v else '?')


def action_installer(texte):
    try:
        r = json.loads(texte)
        radio = str(r['radio'])
    except (ValueError, KeyError, TypeError):
        raise Echec('Réglage invalide.')
    if radio == 'station':
        arreter_service()
        try:
            reseau = reseau_actuel()
            if reseau == 'meshtastic':
                sauvegarder_meshtastic()
            installer_station(reseau, complet=False)
            if reseau == 'meshtastic':
                dire('   la radio répond :', attendre_meshtastic())
        finally:
            relancer_service()
        return
    port = '/dev/serial/by-id/' + os.path.basename(radio)
    if port not in radios_branchees():
        raise Echec('Cette radio n’est plus branchée.')
    installer_t_echo(port)


