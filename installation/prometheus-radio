def appliquer(message, valeurs):
    """Copie de message avec les valeurs donnees (noms des reglages ; enum par leur nom ; octets en base64)."""
    from google.protobuf.json_format import ParseDict, ParseError
    neuf = type(message)()
    neuf.CopyFrom(message)
    for k, v in valeurs.items():
        if k not in neuf.DESCRIPTOR.fields_by_name:
            raise Refus('Réglage inconnu : %s' % k)
        neuf.ClearField(k)
        try:
            ParseDict({k: v}, neuf)
        except (ParseError, ValueError, TypeError) as e:
            raise Refus('Valeur refusée pour %s : %s' % (k, str(e)[:120]))
    return neuf


def admin_message():
    from meshtastic.protobuf import admin_pb2
    return admin_pb2.AdminMessage()


def mt_ecrire_config(p, noeud=None):
    """{sections: {'config.lora': {...}, 'module.mqtt': {...}}} : une seule ecriture groupee, un redemarrage."""
    sections = p.get('sections')
    if not isinstance(sections, dict) or not sections:
        raise Refus('Rien à écrire.')
    n = radio.localNode if noeud is None else noeud
    base = {'config': n.localConfig, 'module': n.moduleConfig}
    a_ecrire, risques = [], []
    for cle, valeurs in sections.items():
        genre, _, nom = str(cle).partition('.')
        if genre not in base or nom not in base[genre].DESCRIPTOR.fields_by_name or not isinstance(valeurs, dict):
            raise Refus('Section inconnue : %s' % cle)
        a_ecrire.append((genre, nom, appliquer(getattr(base[genre], nom), valeurs)))
        risques += ['%s.%s' % (cle, k) for k in valeurs if '%s.%s' % (cle, k) in RISQUE_LIAISON]
    sauvegarde = sauvegarder_meshtastic_ici('avant : ' + ', '.join(s.split('.')[1] for s in sections)) if noeud is None else None
    n.beginSettingsTransaction()
    for genre, nom, neuf in a_ecrire:
        a = admin_message()
        getattr(a.set_config if genre == 'config' else a.set_module_config, nom).CopyFrom(neuf)
        n._sendAdmin(a)
        getattr(base[genre], nom).CopyFrom(neuf)
    n.commitSettingsTransaction()
    if risques and noeud is None:
        garde_fou(sauvegarde, ', '.join(risques))
    return {'sauvegarde': sauvegarde, 'risques': risques, 'redemarre': True}


def psk_de(valeur, actuelle=b''):
    """Cle d'un canal : 'defaut' (la cle publique connue de tous), 'aucune', 'aleatoire', 'garder' ou base64."""
    if valeur in (None, 'garder'):
        return actuelle
    if valeur == 'defaut':
        return b'\x01'
    if valeur == 'aucune':
        return b''
    if valeur == 'aleatoire':
        return os.urandom(32)
    try:
        cle = base64.b64decode(str(valeur), validate=True)
    except ValueError:
        raise Refus('Clé de canal illisible (base64 attendu).')
    if len(cle) not in (0, 1, 16, 32):
        raise Refus('Une clé de canal fait 1, 16 ou 32 octets.')
    return cle


def mt_canal(p):
    """{index (absent : nouveau canal), nom, psk, montee, descente, precision, muet, supprimer}"""
    from meshtastic.protobuf import channel_pb2
    n = radio.localNode
    if p.get('supprimer'):
        i = p.get('index')
        if type(i) is not int or not 1 <= i < 8:
            raise Refus('Seul un canal secondaire se supprime.')
        sauvegarde = sauvegarder_meshtastic_ici('avant : suppression du canal %d' % i)
        n.deleteChannel(i)
        return {'sauvegarde': sauvegarde}
    i = p.get('index')
    if i is None:
        libres = [c.index for c in n.channels if c.role == channel_pb2.Channel.Role.DISABLED]
        if not libres:
            raise Refus('Les 8 canaux sont pris.')
        i = libres[0]
    if type(i) is not int or not 0 <= i < 8:
        raise Refus('Canal invalide.')
    c = n.channels[i]
    nom = str(p.get('nom', c.settings.name))
    if len(nom.encode()) > 11:
        raise Refus('Nom de canal : 11 octets au plus.')
    sauvegarde = sauvegarder_meshtastic_ici('avant : canal %d' % i)
    c.settings.name = nom
    c.settings.psk = psk_de(p.get('psk'), c.settings.psk)
    for cle, champ in (('montee', 'uplink_enabled'), ('descente', 'downlink_enabled')):
        if cle in p:
            setattr(c.settings, champ, p[cle] is True)
    if 'precision' in p:
        if type(p['precision']) is not int or not 0 <= p['precision'] <= 32:
            raise Refus('Précision de position : de 0 à 32.')
        c.settings.module_settings.position_precision = p['precision']
    if 'muet' in p:
        c.settings.module_settings.is_muted = p['muet'] is True
    if c.role == channel_pb2.Channel.Role.DISABLED:
        c.role = channel_pb2.Channel.Role.SECONDARY
    n.writeChannel(i)
    return {'index': i, 'sauvegarde': sauvegarde}


def mt_lien(p):
    """Importer des canaux par un lien Meshtastic (https://meshtastic.org/e/#...) : remplacer ou ajouter."""
    url = str(p.get('url', '')).strip()
    if '/e/' not in url or len(url) > 1000:
        raise Refus('Lien de canaux invalide (https://meshtastic.org/e/#…).')
    sauvegarde = sauvegarder_meshtastic_ici('avant : import de canaux')
    radio.localNode.setURL(url, addOnly=p.get('ajouter') is True)
    return {'sauvegarde': sauvegarde, 'redemarre': p.get('ajouter') is not True}


def mt_proprietaire(p):
    nom = ' '.join(str(p.get('long', '')).split())[:39]
    court = str(p.get('court', ''))
    if not nom:
        raise Refus('Indiquez un nom.')
    if not court or len(court.encode()) > 4:
        raise Refus('Nom court : de 1 à 4 octets (un émoji en prend 4).')
    sauvegarde = sauvegarder_meshtastic_ici('avant : nom de la radio')
    radio.localNode.setOwner(long_name=nom, short_name=court, is_licensed=p.get('licence') is True,
                             is_unmessagable=p.get('muet') is True)
    return {'sauvegarde': sauvegarde}


def mt_position(p):
    sauvegarde = sauvegarder_meshtastic_ici('avant : position')
    if p.get('fixe') is False:
        radio.localNode.removeFixedPosition()
        return {'sauvegarde': sauvegarde}
    try:
        lat, lon, alt = float(p['lat']), float(p['lon']), int(p.get('alt') or 0)
        assert -90 <= lat <= 90 and -180 <= lon <= 180 and -500 < alt < 10000
    except (KeyError, TypeError, ValueError, AssertionError):
        raise Refus('Position invalide.')
    radio.localNode.setFixedPosition(lat, lon, alt)
    return {'sauvegarde': sauvegarde}


def mt_messages_prets(p):
    """Messages tout prets (module « canned messages ») : separes par |, 200 caracteres au total."""
    texte = str(p.get('texte', ''))
    if len(texte) > 200:
        raise Refus('200 caractères au plus.')
    radio.localNode.set_canned_message(texte)
    return {}


def mt_noeud(p):
    """Actions sur une radio de la liste : favori, ignorer, oublier."""
    num = noeud_cible(p.get('id'))
    n, quoi, oui = radio.localNode, p.get('quoi'), p.get('oui') is not False
    fiche = (radio.nodes or {}).get(ident_de_num(num))
    # La radio note le changement ; la copie de la liste tenue par la bibliotheque, elle, est mise a jour ici
    if quoi == 'favori':
        (n.setFavorite if oui else n.removeFavorite)(num)
        if fiche is not None:
            fiche['isFavorite'] = oui
    elif quoi == 'ignorer':
        (n.setIgnored if oui else n.removeIgnored)(num)
        if fiche is not None:
            fiche['isIgnored'] = oui
    elif quoi == 'oublier':
        n.removeNode(num)
        radio.nodes.pop(ident_de_num(num), None)
    else:
        raise Refus('Action inconnue.')
    photographier()
    return {}


def reponse_radio(type_, noeud, ident):
    """La fonction appelee par la bibliotheque quand la reponse arrive (ou un refus de la radio d'en face)."""
    def recevoir(packet):
        demandes.pop(ident, None)
        try:
            d = packet.get('decoded') or {}
            r = d.get('routing') or {}
            if r.get('errorReason') not in (None, 'NONE'):
                noter_resultat(type_, noeud, {'erreur': r['errorReason']}, ident)
                return
            if type_ == 'traceroute':
                t = d.get('traceroute') or {}
                nom = lambda num: {'id': ident_de_num(num), 'nom': nom_de(ident_de_num(num))}
                donnees = {'aller': [nom(x) for x in t.get('route', [])], 'snr_aller': [s / 4 for s in t.get('snrTowards', [])],
                           'retour': [nom(x) for x in t.get('routeBack', [])], 'snr_retour': [s / 4 for s in t.get('snrBack', [])]}
            elif type_ in ('distant-config', 'distant-proprietaire', 'distant-canal', 'distant-infos'):
                donnees = reponse_admin(d)
            else:
                donnees = resumer_paquet(d.get('portnum'), d)
            donnees['snr'] = packet.get('rxSnr')
            noter_resultat(type_, noeud, donnees, ident)
        except Exception as e:
            noter_resultat(type_, noeud, {'erreur': str(e)[:200]}, ident)
    return recevoir


def demander(type_, noeud, ident, delai=120):
    demandes[ident] = {'type': type_, 'noeud': noeud, 'limite': time.time() + delai, 'heure': time.time()}


def mt_demande(p):
    """Demandes par radio : traceroute, position, telemetrie, fiche (nodeinfo). La reponse arrive plus tard
    (resultats.json, montree par la page)."""
    from meshtastic.protobuf import portnums_pb2, mesh_pb2, telemetry_pb2
    num = noeud_cible(p.get('id'))
    quoi = p.get('quoi')
    canal = p.get('canal') if type(p.get('canal')) is int and 0 <= p.get('canal') < 8 else 0
    ident = 'q' + secrets.token_hex(5)
    rappel = reponse_radio(quoi, ident_de_num(num), ident)
    if quoi == 'traceroute':
        sauts = p.get('sauts') if type(p.get('sauts')) is int and 1 <= p.get('sauts') <= 7 else 7
        radio.sendData(mesh_pb2.RouteDiscovery(), num, portNum=portnums_pb2.PortNum.TRACEROUTE_APP, wantResponse=True,
                       onResponse=rappel, channelIndex=canal, hopLimit=sauts)
    elif quoi == 'position':
        radio.sendData(mesh_pb2.Position(), num, portNum=portnums_pb2.PortNum.POSITION_APP, wantResponse=True,
                       onResponse=rappel, channelIndex=canal)
    elif quoi == 'telemetrie':
        t = telemetry_pb2.Telemetry()
        genre = p.get('genre', 'device_metrics')
        if genre not in ('device_metrics', 'environment_metrics', 'power_metrics', 'local_stats', 'air_quality_metrics'):
            raise Refus('Mesure inconnue.')
        getattr(t, genre).SetInParent()
        radio.sendData(t, num, portNum=portnums_pb2.PortNum.TELEMETRY_APP, wantResponse=True, onResponse=rappel,
                       channelIndex=canal)
    elif quoi == 'fiche':
        moi = (radio.nodes or {}).get(ident_de_num(radio.myInfo.my_node_num), {}).get('user') or {}
        u = mesh_pb2.User(id=moi.get('id', ''), long_name=moi.get('longName', ''), short_name=moi.get('shortName', ''))
        radio.sendData(u, num, portNum=portnums_pb2.PortNum.NODEINFO_APP, wantResponse=True, onResponse=rappel,
                       channelIndex=canal)
    else:
        raise Refus('Demande inconnue.')
    port = {'traceroute': 'TRACEROUTE_APP', 'position': 'POSITION_APP', 'telemetrie': 'TELEMETRY_APP', 'fiche': 'NODEINFO_APP'}[quoi]
    HISTO.paquet('meshtastic', 'emis', '', radio.getLongName() or '', ident_de_num(num), port, canal,
                 None, None, None, None, {'demande': quoi})
    demander(quoi, ident_de_num(num), ident)
    return {'demande': ident}


def mt_action(p):
    """La radio de la station : redemarrer, eteindre, heure, oublier toutes les radios, remise a zero."""
    n, quoi = radio.localNode, p.get('quoi')
    if quoi == 'redemarrer':
        n.reboot(5)
    elif quoi == 'eteindre':
        n.shutdown(5)
    elif quoi == 'heure':
        n.setTime(int(time.time()))
    elif quoi == 'oublier-tout':
        sauvegarde = sauvegarder_meshtastic_ici('avant : oubli de toutes les radios')
        n.resetNodeDb()
        return {'sauvegarde': sauvegarde}
    elif quoi in ('usine', 'usine-complete'):
        # Remise a zero : la radio repart de zero (identite comprise pour la complete). La sauvegarde permet de revenir.
        sauvegarde = sauvegarder_meshtastic_ici('avant : remise à zéro')
        n.factoryReset(full=quoi == 'usine-complete')
        return {'sauvegarde': sauvegarde, 'redemarre': True}
    elif quoi == 'annonce':
        # La fiche de la station (nom, cle publique) envoyee a tout le canal, comme le fait la radio de temps en temps
        from meshtastic.protobuf import mesh_pb2, portnums_pb2
        from google.protobuf.json_format import ParseDict
        moi = (radio.nodes or {}).get(ident_de_num(radio.myInfo.my_node_num), {}).get('user') or {}
        u = ParseDict({k: v for k, v in moi.items() if k in ('id', 'longName', 'shortName', 'hwModel', 'role', 'publicKey',
                                                              'isLicensed')}, mesh_pb2.User(), ignore_unknown_fields=True)
        # « reponse voulue » : les radios voisines renvoient leur fiche (utile apres un changement de reseau, liste vide)
        radio.sendData(u, '^all', portNum=portnums_pb2.PortNum.NODEINFO_APP, wantResponse=True)
        HISTO.paquet('meshtastic', 'emis', '', radio.getLongName() or '', '^all', 'NODEINFO_APP', 0, None, None, None, None,
                     {'demande': 'annonce'})
    elif quoi == 'sauvegarder':
        return {'sauvegarde': sauvegarder_meshtastic_ici('à la demande')}
    else:
        raise Refus('Action inconnue.')
    return {}


# ---- A distance (desactive par defaut : Parametres > Mesh) : reglages d'une autre radio Meshtastic
# Il faut que la cle publique de la station soit dans les « cles admin » de cette radio (Securite).
def reponse_admin(d):
    a = (d.get('admin') or {}).get('raw')
    if a is None:
        return {'erreur': 'réponse illisible'}
    for champ in ('get_config_response', 'get_module_config_response'):
        if a.HasField(champ):
            r = getattr(a, champ)
            quoi = r.WhichOneof('payload_variant')
            return {'genre': 'config' if champ == 'get_config_response' else 'module', 'section': quoi,
                    'valeurs': dict_proto(getattr(r, quoi))}
    if a.HasField('get_owner_response'):
        return {'proprietaire': dict_proto(a.get_owner_response)}
    if a.HasField('get_channel_response'):
        return {'canal': {'index': a.get_channel_response.index, 'role': a.get_channel_response.role,
                          'reglages': dict_proto(a.get_channel_response.settings)}}
    if a.HasField('get_device_metadata_response'):
        return {'infos': dict_proto(a.get_device_metadata_response)}
    return {'erreur': 'réponse inattendue'}


