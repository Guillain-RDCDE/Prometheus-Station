def version_num(v):
    return [int(x) for x in re.findall(r'\d+', str(v).lstrip('v').split('-')[0])]


def maj_radio(reseau):
    """La plus recente version gardee pour le reseau de la station, si elle est plus recente que celle de sa radio."""
    try:
        gardees = json.load(open(os.path.join(RADIO, 'outil.json'))).get('versions', {}).get(reseau, [])
        installee = json.load(open(os.path.join(RADIO, 'details.json'))).get('moi', {}).get('version', '')
    except (OSError, ValueError):
        return ''
    if gardees and installee and version_num(gardees[0])[:3] > version_num(installee)[:3]:
        return gardees[0]
    return ''


