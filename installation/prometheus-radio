def dict_proto(message):
    from google.protobuf.json_format import MessageToDict
    try:
        return MessageToDict(message, preserving_proto_field_name=True, always_print_fields_with_no_presence=True)
    except TypeError:   # ancienne bibliotheque protobuf
        return MessageToDict(message, preserving_proto_field_name=True, including_default_value_fields=True)


def sauvegarder_meshtastic_ici(raison):
    """Les reglages complets de la radio (le meme format que « meshtastic --export-config », que l'outil radio
    sait remettre), garde avant chaque changement. Renvoie le nom du fichier."""
    from meshtastic.__main__ import export_config
    texte = export_config(radio)
    return ranger_sauvegarde('meshtastic-%s.yaml' % time.strftime('%Y-%m-%d-%H%M%S'),
                             '# Prometheus Station - %s\n%s' % (raison, texte))


def noeud_cible(ident):
    """Le numero d'une radio, a partir de « !1a2b3c4d » ou du numero."""
    ident = str(ident or '')
    if ident.startswith('!'):
        try:
            return int(ident[1:], 16)
        except ValueError:
            pass
    try:
        return int(ident)
    except ValueError:
        raise Refus('Radio inconnue.')


