#!/opt/prometheus-radio/bin/python3
# Prometheus Station - outil radio (plan radio R3, R4, R5). Tourne en root, lance par prometheus-commande
# (ordres radio-*) dans le service a part prometheus-radio-outil : un seul a la fois.
# Tout ce qu'il fait s'ecrit dans /var/www/prometheus/ajouter/radio-outil.txt (la page Radio le fait defiler),
# derniere ligne « ### FIN <code> » (0 = reussi).
#
#   prometheus-radio-outil sauvegarder               sauvegarde les reglages de la radio de la station
#   prometheus-radio-outil regler '<json>'           {nom, court, role, preset, position: {lat, lon} | null}
#   prometheus-radio-outil reseau meshcore|meshtastic   change de reseau : sauvegarde, efface, installe, restaure
#   prometheus-radio-outil chercher                  telecharge les dernieres versions stables (internet)
#   prometheus-radio-outil chercher-auto             la meme, chaque jour (minuterie), son propre journal, rien sans internet
#   prometheus-radio-outil installer '<json>'        {radio: 'station' | nom d'un port USB} : mise a jour, reglages gardes
#   prometheus-radio-outil t-echo '<json>'           {radio: port, cible: meshtastic | meshtastic-inkhud | meshcore-ble
#                                                     | meshcore-usb | maj}
#   prometheus-radio-outil detecter                  reconnait les T-Echo branches (logiciel, version, nom)
#   prometheus-radio-outil restaurer '<json>'        {fichier} : remet une sauvegarde de la section Mesh (garde-fou compris)
#   prometheus-radio-outil identifier                atelier : reconnait toute radio branchee et les disques UF2
#   prometheus-radio-outil carte '<json>'            atelier : installe Meshtastic ou MeshCore sur une carte (voir action_carte)
#
# Ce qu'il garde, dans /srv/prometheus/radio :
#   reseau.json      {reseau: meshtastic|meshcore, puce: SX1276|SX1262, mac, ble}  (lu par prometheus-radio)
#   logiciels/<reseau>/<version>/   les fichiers a installer, telecharges par « chercher »
#   sauvegardes/     reglages de chaque reseau (meshtastic-dernier.yaml, meshcore-dernier.json) + copies datees
#   outil.json       resume pour la page (versions disponibles, sauvegardes, radios branchees)
import asyncio, glob, hashlib, io, json, os, re, shutil, subprocess, sys, time, urllib.request, zipfile

RADIO = '/srv/prometheus/radio'
LOGICIELS = os.path.join(RADIO, 'logiciels')
SAUVEGARDES = os.path.join(RADIO, 'sauvegardes')
RESEAU = os.path.join(RADIO, 'reseau.json')
RESUME = os.path.join(RADIO, 'outil.json')
JOURNAL = '/var/www/prometheus/ajouter/radio-outil.txt'
JOURNAL_AUTO = '/var/www/prometheus/ajouter/radio-chercher.txt'
BIN = '/opt/prometheus-radio/bin'
MESHTASTIC = os.path.join(BIN, 'meshtastic')
ESPTOOL = os.path.join(BIN, 'esptool')
PIN_BLE = '123456'          # code Bluetooth fixe des T-Beam sous MeshCore (BLE_PIN_CODE de leur logiciel)
# Reglage radio MeshCore conseille en Europe (« EU/UK Narrow ») : frequence (MHz), largeur (kHz), SF, CR
MESHCORE_EU = {'freq': 869.618, 'bw': 62.5, 'sf': 8, 'cr': 8}
ROLES = ('CLIENT', 'CLIENT_MUTE', 'ROUTER', 'ROUTER_LATE')
PRESETS = ('LONG_FAST', 'LONG_SLOW', 'LONG_MODERATE', 'MEDIUM_FAST', 'MEDIUM_SLOW', 'SHORT_FAST', 'SHORT_SLOW')
GARDER_VERSIONS = 2         # versions gardees par reseau


# ---------------------------------------------------------------- journal de l'operation
# Le journal est lisible depuis la page : jamais de cle ni de mot de passe dedans (meshtastic --configure les affiche)
SECRET = re.compile(r'((?:private|public|admin)_?[kK]ey|password|psk)( to |: |=)\S+')
MAC = re.compile(r'MAC:\s+([0-9a-f]{2}(?::[0-9a-f]{2}){5})')


class Journal:
    def __init__(self, chemin=None):
        chemin = chemin or JOURNAL
        self.f = open(chemin + '.tmp', 'w', encoding='utf-8')
        os.chmod(chemin + '.tmp', 0o644)
        os.replace(chemin + '.tmp', chemin)

    def __call__(self, *morceaux):
        ligne = SECRET.sub(r'\1\2[masqué]', ' '.join(str(m) for m in morceaux))
        print(ligne, flush=True)
        self.f.write(ligne + '\n')
        self.f.flush()


dire = None


class Echec(Exception):
    pass


def lancer(cmd, montrer=True, garder=False, delai=600):
    """Lance une commande ; montre sa sortie ligne par ligne dans le journal. Renvoie (code, sortie)."""
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors='replace')
    # Une commande muette (radio qui ne repond pas) n'ecrit rien : le delai doit tomber quand meme (16/10/2026)
    import threading
    minuteur = threading.Timer(delai, p.kill)
    minuteur.start()
    sortie, progression = [], 0
    fin = time.time() + delai
    for ligne in p.stdout:
        ligne = ligne.rstrip()
        sortie.append(ligne)
        # esptool ecrit une ligne de progression par bloc : on n'en montre qu'une sur dix
        if 'Writing at 0x' in ligne or 'Reading from 0x' in ligne:
            progression += 1
            if progression % 10:
                continue
        if montrer and ligne:
            dire('   ' + ligne[:200])
        if time.time() > fin:
            p.kill()
            break
    p.wait()
    minuteur.cancel()
    return p.returncode, '\n'.join(sortie)


def ecrire_json(chemin, donnees, public=True):
    tmp = chemin + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(donnees, f, ensure_ascii=False, indent=1)
    os.chmod(tmp, 0o644 if public else 0o600)
    os.replace(tmp, chemin)


def lire_json(chemin, defaut):
    try:
        return json.load(open(chemin))
    except (OSError, ValueError):
        return defaut


def reseau_actuel():
    return lire_json(RESEAU, {}).get('reseau', 'meshtastic')


def noter_reseau(**valeurs):
    r = lire_json(RESEAU, {})
    r.update(valeurs)
    ecrire_json(RESEAU, r)
    os.chown(RESEAU, *proprietaire())


def proprietaire():
    import pwd
    p = pwd.getpwnam('prometheus')
    return p.pw_uid, p.pw_gid


# ---------------------------------------------------------------- la radio de la station
def port_station():
    """La T-Beam : le port note dans reseau.json (son numero de serie USB, qui ne change pas), sinon sa puce
    USB-serie (1a86 = CH9102, CP210x). Le port est note des qu'on le trouve : une autre carte de la meme marque
    branchee pour l'atelier ne sera jamais prise pour la radio de la station."""
    note = lire_json(RESEAU, {}).get('port')
    if note and os.path.exists('/dev/serial/by-id/' + note):
        return '/dev/serial/by-id/' + note
    for p in sorted(glob.glob('/dev/serial/by-id/*')):
        if any(m in p for m in ('1a86', 'CP210', 'Silicon_Labs')):
            if not note:
                noter_reseau(port=os.path.basename(p))
            return p
    raise Echec('La radio de la station n’est pas branchée.')


def arreter_service():
    dire('== Arrêt du service radio (un seul programme à la fois peut parler à la radio)')
    subprocess.run(['systemctl', 'stop', 'prometheus-radio'])


def relancer_service():
    dire('== Relance du service radio')
    subprocess.run(['systemctl', 'start', 'prometheus-radio'])


def mt(*args, montrer=True, delai=120, port=None):
    """L'outil Meshtastic, sur la radio de la station ou sur le port donne (un T-Echo)."""
    return lancer([MESHTASTIC, '--port', port or port_station(), *args], montrer=montrer, delai=delai)


def attendre_meshtastic(essais=12, port=None, delai=60):
    """Attend que la radio reponde sous Meshtastic (apres un redemarrage). Renvoie son nom long."""
    for _ in range(essais):
        p = port() if callable(port) else port   # un T-Echo peut changer de port en redemarrant
        if not p and port is not None:
            time.sleep(5)
            continue
        code, sortie = mt('--info', montrer=False, delai=delai, port=p)
        m = re.search(r'Owner: (.+?) \(', sortie)
        if code == 0 and m:
            return m.group(1)
        time.sleep(5)
    raise Echec('La radio ne répond pas sous Meshtastic.')


def horodatage():
    return time.strftime('%Y-%m-%d-%H%M%S')


def ranger_sauvegarde(nom, contenu):
    """Ecrit nom-dernier.ext et une copie datee ; garde les 10 dernieres copies datees."""
    os.makedirs(SAUVEGARDES, mode=0o700, exist_ok=True)
    base, ext = nom.split('.')
    for chemin in (os.path.join(SAUVEGARDES, '%s-dernier.%s' % (base, ext)),
                   os.path.join(SAUVEGARDES, '%s-%s.%s' % (base, horodatage(), ext))):
        with open(chemin + '.tmp', 'w') as f:
            f.write(contenu)
        os.chmod(chemin + '.tmp', 0o600)
        os.replace(chemin + '.tmp', chemin)
    datees = sorted(glob.glob(os.path.join(SAUVEGARDES, '%s-2*.%s' % (base, ext))))
    for vieux in datees[:-10]:
        os.remove(vieux)


def sauvegarder_meshtastic(port=None, nom='meshtastic'):
    """Sauvegarde les reglages Meshtastic d'une radio. nom : 'meshtastic' (la station) ou 't-echo-<serie>-meshtastic'."""
    dire('== Sauvegarde des réglages Meshtastic (nom, canaux, identité, réglages)')
    code, sortie = mt('--export-config', montrer=False, port=port)
    debut = sortie.find('# start of Meshtastic configure yaml')
    if code != 0 or debut < 0 or 'owner:' not in sortie:
        raise Echec('Impossible de lire les réglages de la radio.')
    ranger_sauvegarde(nom + '.yaml', sortie[debut:] + '\n')
    dire('   gardés dans', os.path.join(SAUVEGARDES, nom + '-dernier.yaml'))
    return sortie[debut:]


def restaurer_meshtastic(port=None, nom='meshtastic', fichier=None):
    """Remet les reglages Meshtastic sauvegardes (identite comprise, verifiee). port peut etre une fonction."""
    p = (lambda: port() if callable(port) else port) if port is not None else (lambda: None)
    fichier = fichier or os.path.join(SAUVEGARDES, nom + '-dernier.yaml')
    if not os.path.exists(fichier):
        dire('   (aucune sauvegarde Meshtastic pour cette radio : réglages d’usine, région Europe 868 MHz)')
        mt('--set', 'lora.region', 'EU_868', port=p())
        return
    dire('== Remise des réglages Meshtastic sauvegardés')
    code, _ = mt('--configure', fichier, delai=300, port=p())
    if code != 0:
        raise Echec('La remise des réglages Meshtastic a échoué.')
    # L'identite (cle privee) remise en bloc avec le reste n'est pas reprise par la radio, qui s'en fabrique une
    # nouvelle (vu le 14/10/2026) : on la remet seule, puis on verifie que la radio a bien retrouve la sienne.
    sauvee = open(fichier).read()
    privee = re.search(r'^\s*(?:privateKey|private_key):\s*(\S+)', sauvee, re.M)
    publique = re.search(r'^\s*(?:publicKey|public_key):\s*(\S+)', sauvee, re.M)
    if privee and publique:
        dire('== Remise de l’identité de la radio')
        attendre_meshtastic(port=port)
        mt('--set', 'security.private_key', privee.group(1), port=p())
        time.sleep(15)
        attendre_meshtastic(port=port)
        _, sortie = mt('--export-config', montrer=False, port=p())
        lue = re.search(r'^\s*(?:publicKey|public_key):\s*(\S+)', sortie, re.M)
        if not lue or lue.group(1) != publique.group(1):
            raise Echec('La radio n’a pas repris son identité.')
        dire('   identité vérifiée : c’est bien la même radio pour les autres')


def detecter_puce():
    """SX1276 ou SX1262 : lu dans le journal de demarrage de Meshtastic (RF95 = SX1276)."""
    connue = lire_json(RESEAU, {}).get('puce')
    if connue:
        return connue
    import serial
    dire('== Lecture de la puce radio (redémarrage de la radio)')
    s = serial.Serial(port_station(), 115200, timeout=0.5)
    s.dtr = False
    s.rts = True
    time.sleep(0.2)
    s.rts = False
    fin, tampon = time.time() + 25, b''
    while time.time() < fin and b'init success' not in tampon:
        tampon += s.read(4096)
    s.close()
    t = tampon.decode('utf-8', 'replace')
    puce = 'SX1276' if 'RF95' in t or 'SX1276' in t else 'SX1262' if 'SX1262' in t or 'SX126x' in t else None
    if not puce:
        raise Echec('Puce radio inconnue : changement de réseau impossible.')
    dire('   puce', puce)
    noter_reseau(puce=puce)
    return puce


# ---------------------------------------------------------------- les logiciels gardes sur la station
def versions(reseau):
    """Versions disponibles sur la station, la plus recente d'abord."""
    d = os.path.join(LOGICIELS, reseau)
    v = [x for x in os.listdir(d) if os.path.isdir(os.path.join(d, x))] if os.path.isdir(d) else []
    return sorted(v, key=lambda x: [int(n) if n.isdigit() else 0 for n in re.findall(r'\d+', x)], reverse=True)


# Ce que la station garde de chaque reseau (motifs des noms de fichiers) ; « chercher » complete ce qui manque.
#   T-Echo : .uf2 (copie sur son disque de mise a jour) et .zip (installation par le port serie, quand le disque
#   n'apparait pas). MeshCore a deux versions pour le T-Echo : « ble » (avec l'appli du telephone) et « usb » (pilote
#   par la station).
MOTIFS = {
    'meshtastic': {'station-complet': r'^firmware-tbeam-\d.*\.factory\.bin$',
                   'station-maj': r'^firmware-tbeam-\d.*(?<!factory)\.bin$',
                   't-echo': r'^firmware-t-echo-\d.*(?<!-ota)\.uf2$',
                   't-echo-zip': r'^firmware-t-echo-\d.*-ota\.zip$',
                   # InkHUD : l'interface simplifiee officielle de Meshtastic pour les ecrans e-ink
                   't-echo-inkhud': r'^firmware-t-echo-inkhud-\d.*(?<!-ota)\.uf2$',
                   't-echo-inkhud-zip': r'^firmware-t-echo-inkhud-\d.*-ota\.zip$'},
    'meshcore': {'station-complet': r'^Tbeam_{puce}_companion_radio_ble-.*-merged\.bin$',
                 'station-maj': r'^Tbeam_{puce}_companion_radio_ble-.*(?<!merged)\.bin$',
                 't-echo-ble': r'^LilyGo_T-Echo_companion_radio_ble-.*\.uf2$',
                 't-echo-ble-zip': r'^LilyGo_T-Echo_companion_radio_ble-.*\.zip$',
                 't-echo-usb': r'^LilyGo_T-Echo_companion_radio_usb-.*\.uf2$',
                 't-echo-usb-zip': r'^LilyGo_T-Echo_companion_radio_usb-.*\.zip$'},
}


def fichier_logiciel(reseau, quoi, puce=None):
    """Le fichier a installer (le plus recent), et sa version. quoi : une cle de MOTIFS[reseau]."""
    for v in versions(reseau):
        d = os.path.join(LOGICIELS, reseau, v)
        noms = os.listdir(d)
        motif = MOTIFS[reseau][quoi].replace('{puce}', puce or 'SX1276')
        for n in noms:
            if re.match(motif, n):
                return os.path.join(d, n), v
    raise Echec('Aucun logiciel %s (%s) sur la station : cherchez d’abord les logiciels avec internet.' % (reseau, quoi))


def esptool(*args):
    code, sortie = lancer([ESPTOOL, '--port', port_station(), '--baud', '460800', *args], delai=600)
    if code != 0:
        raise Echec('L’écriture dans la radio a échoué.')
    return sortie


def installer_station(reseau, complet):
    """Ecrit le logiciel dans la T-Beam. complet : efface tout (changement de reseau) ; sinon mise a jour."""
    puce = lire_json(RESEAU, {}).get('puce') if reseau == 'meshcore' else None
    fichier, version = fichier_logiciel(reseau, 'station-complet' if complet else 'station-maj', puce)
    dire('== %s %s %s' % ('Installation de' if complet else 'Mise à jour vers', reseau.capitalize(), version), '(' + os.path.basename(fichier) + ')')
    if complet:
        dire('   effacement complet de la radio…')
        sortie = esptool('erase-flash')
        mac = MAC.search(sortie)
        if mac:
            noter_reseau(mac=mac.group(1))
    esptool('write-flash', '0x0' if complet else '0x10000', fichier)
    dire('   écrit ; la radio redémarre')
    time.sleep(8)


# ---------------------------------------------------------------- MeshCore par Bluetooth
def adresse_ble():
    """Adresse Bluetooth de la T-Beam : adresse de la puce + 2 (regle des ESP32)."""
    mac = lire_json(RESEAU, {}).get('mac')
    if not mac:
        sortie = esptool('read-mac')
        trouve = MAC.search(sortie)
        if not trouve:
            raise Echec('Adresse de la radio illisible.')
        mac = trouve.group(1)
        noter_reseau(mac=mac)
    n = (int(mac.replace(':', ''), 16) + 2) & 0xFFFFFFFFFFFF
    return ':'.join('%02X' % ((n >> s) & 0xFF) for s in range(40, -1, -8))


def bloquer_bluetooth(bloque):
    """Blocage logiciel de la puce Bluetooth (rfkill) : bloquee sur Meshtastic (economie), debloquee sur MeshCore."""
    for f in glob.glob('/sys/class/rfkill/rfkill*'):
        try:
            if open(os.path.join(f, 'type')).read().strip() == 'bluetooth':
                with open(os.path.join(f, 'soft'), 'w') as s:
                    s.write('1' if bloque else '0')
        except OSError:
            pass


def bluetooth(allume):
    if allume:
        bloquer_bluetooth(False)
        subprocess.run(['systemctl', 'start', 'bluetooth'])
        time.sleep(3)
    else:
        subprocess.run(['systemctl', 'stop', 'bluetooth'])
        bloquer_bluetooth(True)


CODE_BLE = os.path.join(RADIO, 'code-ble')     # depose par la page Radio (prometheus-admin) : le code lu sur l'ecran


def attendre_code(minutes=10):
    """Premier passage a MeshCore : la radio (avec ecran) tire un code Bluetooth au hasard et l'affiche.
    On attend que l'administrateur le tape dans la page Radio."""
    if os.path.exists(CODE_BLE):
        os.remove(CODE_BLE)
    dire('== CODE À TAPER : regardez l’écran de la radio de la station et tapez dans la page Radio le code à 6 chiffres qui s’y affiche')
    dire('   (une seule fois : ensuite la station s’en souvient ; attente', minutes, 'minutes au plus)')
    fin = time.time() + minutes * 60
    while time.time() < fin:
        if os.path.exists(CODE_BLE):
            code = open(CODE_BLE).read().strip()
            os.remove(CODE_BLE)
            if re.fullmatch(r'\d{6}', code):
                dire('   code reçu')
                return code
        time.sleep(1)
    raise Echec('Aucun code tapé : appairage abandonné.')


# La memoire de reglages de MeshCore (partition « spiffs ») : copiee en quittant MeshCore, remise en y revenant.
# Elle contient tout (identite, contacts, canaux, nom, radio, code Bluetooth fixe) : MeshCore revient a l'identique.
MEMOIRE_MESHCORE = os.path.join(SAUVEGARDES, 'meshcore-memoire.bin')


def partition_reglages():
    """(adresse, taille) de la partition de donnees du logiciel actuellement installe, lue dans sa table."""
    tmp = '/run/prometheus-table.bin'
    esptool('read-flash', '0x8000', '0xc00', tmp)
    table = open(tmp, 'rb').read()
    os.remove(tmp)
    for i in range(0, len(table), 32):
        e = table[i:i + 32]
        if e[:2] != b'\xaa\x50':
            break
        if e[2] == 1 and e[3] in (0x82, 0x83):      # donnees : spiffs ou littlefs
            return int.from_bytes(e[4:8], 'little'), int.from_bytes(e[8:12], 'little')
    raise Echec('Table des partitions illisible.')


def copier_memoire_meshcore():
    dire('== Copie de la mémoire de réglages MeshCore de la radio')
    adresse, taille = partition_reglages()
    tmp = MEMOIRE_MESHCORE + '.tmp'
    esptool('read-flash', hex(adresse), hex(taille), tmp)
    os.chmod(tmp, 0o600)
    os.replace(tmp, MEMOIRE_MESHCORE)
    with open(MEMOIRE_MESHCORE + '.json', 'w') as f:
        json.dump({'adresse': adresse, 'taille': taille, 'heure': time.time()}, f)
    dire('   gardée (%d Ko)' % (taille // 1024))


def remettre_memoire_meshcore():
    """Apres l'installation de MeshCore : remet sa memoire si on en a une de la meme taille. Renvoie True si remise."""
    if not os.path.exists(MEMOIRE_MESHCORE):
        return False
    adresse, taille = partition_reglages()
    infos = lire_json(MEMOIRE_MESHCORE + '.json', {})
    if infos.get('adresse') != adresse or infos.get('taille') != taille or os.path.getsize(MEMOIRE_MESHCORE) != taille:
        dire('   (mémoire MeshCore gardée d’une autre forme : on ne la remet pas)')
        return False
    dire('== Remise de la mémoire de réglages MeshCore (identité, contacts, canaux)')
    esptool('write-flash', hex(adresse), MEMOIRE_MESHCORE)
    return True


async def appairer(adresse, pin=PIN_BLE):
    """Appaire la station et la T-Beam. Un petit agent repond le code au systeme Bluetooth."""
    from dbus_fast import BusType, Variant
    from dbus_fast.aio import MessageBus
    from dbus_fast.service import ServiceInterface, method

    class Agent(ServiceInterface):
        def __init__(self):
            super().__init__('org.bluez.Agent1')

        @method()
        def Release(self):
            pass

        @method()
        def RequestPinCode(self, device: 'o') -> 's':
            return pin

        @method()
        def RequestPasskey(self, device: 'o') -> 'u':
            return int(pin)

        @method()
        def DisplayPasskey(self, device: 'o', passkey: 'u', entered: 'q'):
            pass

        @method()
        def DisplayPinCode(self, device: 'o', pincode: 's'):
            pass

        @method()
        def RequestConfirmation(self, device: 'o', passkey: 'u'):
            pass

        @method()
        def RequestAuthorization(self, device: 'o'):
            pass

        @method()
        def AuthorizeService(self, device: 'o', uuid: 's'):
            pass

        @method()
        def Cancel(self):
            pass

    bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
    bus.export('/prometheus/agent', Agent())

    async def interface(chemin, nom):
        intro = await bus.introspect('org.bluez', chemin)
        return bus.get_proxy_object('org.bluez', chemin, intro).get_interface(nom)

    gestion = await interface('/org/bluez', 'org.bluez.AgentManager1')
    await gestion.call_register_agent('/prometheus/agent', 'KeyboardDisplay')
    await gestion.call_request_default_agent('/prometheus/agent')
    props = await interface('/org/bluez/hci0', 'org.freedesktop.DBus.Properties')
    await props.call_set('org.bluez.Adapter1', 'Powered', Variant('b', True))
    adaptateur = await interface('/org/bluez/hci0', 'org.bluez.Adapter1')
    chemin = '/org/bluez/hci0/dev_' + adresse.replace(':', '_')
    # Une ancienne association (avant l'effacement de la radio) empecherait la nouvelle
    try:
        await adaptateur.call_remove_device(chemin)
        dire('   ancienne association oubliée')
    except Exception:
        pass
    dire('   recherche de la radio', adresse, '…')
    await adaptateur.call_start_discovery()
    objets = await interface('/', 'org.freedesktop.DBus.ObjectManager')
    trouve = False
    for _ in range(40):
        if chemin in await objets.call_get_managed_objects():
            trouve = True
            break
        await asyncio.sleep(1)
    try:
        await adaptateur.call_stop_discovery()
    except Exception:
        pass
    if not trouve:
        raise Echec('La radio n’apparaît pas en Bluetooth.')
    appareil = await interface(chemin, 'org.bluez.Device1')
    dire('   appairage…')
    for essai in range(3):
        try:
            await appareil.call_pair()
            break
        except Exception as e:
            if 'AlreadyExists' in str(e):
                break
            dire('   essai', essai + 1, ':', e)
            await asyncio.sleep(3)
    else:
        raise Echec('Appairage Bluetooth refusé.')
    p = await interface(chemin, 'org.freedesktop.DBus.Properties')
    await p.call_set('org.bluez.Device1', 'Trusted', Variant('b', True))
    try:
        await appareil.call_disconnect()
    except Exception:
        pass
    await gestion.call_unregister_agent('/prometheus/agent')
    bus.disconnect()
    dire('   appairée')


async def meshcore_connecter(adresse, essais=6):
    from meshcore import MeshCore
    # Le service radio vient d'etre arrete : le systeme Bluetooth peut garder sa connexion ouverte, ce qui
    # empeche la notre (vu le 15/10/2026). On la coupe d'abord.
    subprocess.run(['bluetoothctl', 'disconnect', adresse], capture_output=True, timeout=20)
    await asyncio.sleep(2)
    for i in range(essais):
        try:
            mc = await asyncio.wait_for(MeshCore.create_ble(adresse), 40)
            if mc:
                return mc
        except Exception as e:
            dire('   connexion Bluetooth, essai', i + 1, ':', e)
        await asyncio.sleep(5)
    raise Echec('La radio ne répond pas sous MeshCore (Bluetooth).')


async def meshcore_lire(mc):
    """Tout ce qu'il faut pour remettre la radio comme elle etait (identite comprise)."""
    from meshcore import EventType
    moi = mc.self_info or {}
    cle = await mc.commands.export_private_key()
    canaux = []
    info = await mc.commands.send_device_query()
    for i in range(min(40, (info.payload or {}).get('max_channels') or 8) if info.type == EventType.DEVICE_INFO else 8):
        r = await mc.commands.get_channel(i)
        if r.type == EventType.CHANNEL_INFO and r.payload.get('channel_name'):
            canaux.append({'index': i, 'nom': r.payload['channel_name'], 'secret': r.payload['channel_secret'].hex()})
    contacts = await mc.commands.get_contacts()
    return {'nom': moi.get('name', ''), 'freq': moi.get('radio_freq'), 'bw': moi.get('radio_bw'), 'sf': moi.get('radio_sf'),
            'cr': moi.get('radio_cr'), 'tx': moi.get('tx_power'), 'lat': moi.get('adv_lat'), 'lon': moi.get('adv_lon'),
            'cle': cle.payload.get('private_key').hex() if cle.type == EventType.PRIVATE_KEY else '',
            'canaux': canaux,
            'contacts': list(contacts.payload.values()) if contacts.type == EventType.CONTACTS else []}


async def meshcore_ecrire(mc, s):
    """Remet des reglages MeshCore (sauvegarde, ou valeurs de depart)."""
    if s.get('cle'):
        dire('   identité de la station')
        await mc.commands.import_private_key(bytes.fromhex(s['cle']))
    dire('   nom :', s['nom'])
    await mc.commands.set_name(s['nom'])
    dire('   radio : %s MHz, %s kHz, SF%s, CR%s' % (s['freq'], s['bw'], s['sf'], s['cr']))
    await mc.commands.set_radio(s['freq'], s['bw'], s['sf'], s['cr'])
    if s.get('tx'):
        await mc.commands.set_tx_power(s['tx'])
    if s.get('lat') or s.get('lon'):
        await mc.commands.set_coords(s.get('lat') or 0, s.get('lon') or 0)
    for c in s.get('canaux', []):
        await mc.commands.set_channel(c['index'], c['nom'], bytes.fromhex(c['secret']))
    for c in s.get('contacts', []):
        try:
            await mc.commands.add_contact(c)
        except Exception:
            pass
    if s.get('contacts'):
        dire('   contacts remis :', len(s['contacts']))


async def meshcore_regler_depart(adresse, nom, memoire_remise):
    """Apres l'installation. Memoire remise : tout est deja la, on verifie seulement. Sinon : reglages sauvegardes
    par la bibliotheque (s'il y en a) ou reglages de depart, et code Bluetooth fixe pour les fois suivantes."""
    mc = await meshcore_connecter(adresse)
    try:
        fichier = os.path.join(SAUVEGARDES, 'meshcore-dernier.json')
        if memoire_remise:
            dire('   la radio est revenue telle qu’elle était :', (mc.self_info or {}).get('name', '?'))
        else:
            if os.path.exists(fichier):
                dire('== Remise des réglages MeshCore sauvegardés')
                s = json.load(open(fichier))
            else:
                dire('== Premiers réglages MeshCore (réglage européen conseillé)')
                s = dict(MESHCORE_EU, nom=nom)
            await meshcore_ecrire(mc, s)
            dire('   code Bluetooth fixé (la station n’aura plus besoin de lire l’écran)')
            await mc.commands.set_devicepin(int(PIN_BLE))
        dire('   la station s’annonce sur le réseau')
        await mc.commands.send_advert(flood=True)
        # La cle d'identite et le code ne prennent effet qu'au redemarrage
        if not memoire_remise:
            await mc.commands.reboot()
    finally:
        try:
            await mc.disconnect()
        except Exception:
            pass


async def meshcore_sauvegarder(adresse):
    dire('== Sauvegarde des réglages MeshCore (nom, radio, canaux, contacts, identité)')
    mc = await meshcore_connecter(adresse)
    try:
        s = await meshcore_lire(mc)
    finally:
        await mc.disconnect()
    ranger_sauvegarde('meshcore.json', json.dumps(s, ensure_ascii=False, indent=1))
    dire('   gardés dans', os.path.join(SAUVEGARDES, 'meshcore-dernier.json'), '(%d contacts)' % len(s['contacts']))
    return s


