#!/opt/prometheus-radio/bin/python3
# Prometheus Station - la radio de la station (T-Beam) reliee au tableau des messages et a la section Mesh.
# Deux reseaux possibles (plan radio) : Meshtastic (carte en USB) ou MeshCore (meme carte, par Bluetooth).
# Le reseau en service est ecrit par prometheus-radio-outil dans reseau.json ; changer de reseau = cet outil.
# Ne fait rien tant que la radio est desactivee dans Parametres > Radio.
# Echange avec prometheus-admin par des fichiers, dans /srv/prometheus/radio :
#   a-envoyer/  messages a emettre   {id, texte, canal, a}  (a vide : tout le canal ; sinon message direct)
#   partis/     messages emis        {id}                   (lu puis efface par prometheus-admin)
#   recus/      messages arrives par radio, pour le tableau {heure, nom, texte}  (idem)
#   etat.json   {etat: eteinte|absente|muette|ok, nom, depuis, reseau, max (octets par message)}
#   details.json  la radio vue de pres (reecrit toutes les 30 s) :
#                 {reseau, heure, depuis, moi: {...}, canaux: [{index, nom, role}], noeuds: [{...}]}
#   journal.json  les derniers messages radio, tous canaux et messages directs, recus et emis (300 au plus)
# Section Mesh (plan Mesh, 19/10/2026) :
#   ordres/<ms>-<id>.json   {id, action, p}  depose par prometheus-admin ; reponses/<id>.json {id, ok, r | erreur}
#   resultats.json          reponses venues par radio (traceroute, position, telemetrie, reglages a distance...)
#   schema.json             tous les reglages Meshtastic connus de la bibliotheque (pour les formulaires)
#   historique.db           SQLite : paquets entendus, statistiques, telemetrie (90 jours par defaut)
#   mesh-sauvegardes/       reglages gardes avant chaque changement fait depuis la section Mesh
#   garde-fou.json          un reglage risque vient d'etre ecrit : si la radio ne revient pas, on remet la sauvegarde
#   balise.json             dernier envoi de la balise (Parametres > Radio > Balise)
# Avant d'utiliser l'outil « meshtastic » a la main : sudo systemctl stop prometheus-radio (un seul programme a la fois).
import asyncio, base64, glob, json, os, secrets, sqlite3, threading, time

DOSSIER = '/srv/prometheus/radio'
A_ENVOYER = os.path.join(DOSSIER, 'a-envoyer')
PARTIS = os.path.join(DOSSIER, 'partis')
RECUS = os.path.join(DOSSIER, 'recus')
ETAT = os.path.join(DOSSIER, 'etat.json')
DETAILS = os.path.join(DOSSIER, 'details.json')
JOURNAL = os.path.join(DOSSIER, 'journal.json')
RESEAU = os.path.join(DOSSIER, 'reseau.json')                 # ecrit par prometheus-radio-outil
EFFACER_JOURNAL = os.path.join(DOSSIER, 'effacer-journal')   # depose par prometheus-admin (Effacer les ecrits)
ORDRES = os.path.join(DOSSIER, 'ordres')
REPONSES = os.path.join(DOSSIER, 'reponses')
RESULTATS = os.path.join(DOSSIER, 'resultats.json')
SCHEMA = os.path.join(DOSSIER, 'schema.json')
HISTORIQUE = os.path.join(DOSSIER, 'historique.db')
SAUVE_MESH = os.path.join(DOSSIER, 'mesh-sauvegardes')
GARDE_FOU = os.path.join(DOSSIER, 'garde-fou.json')
ATTENTE_CONTACTS = os.path.join(DOSSIER, 'contacts-attente.json')   # MeshCore : radios annoncees, pas encore ajoutees
COMMANDE = '/srv/prometheus/commande'                         # ordres pour prometheus-commande (outil radio, root)
REGLAGES = '/srv/prometheus/communaute/reglages.json'
ECART = 15            # secondes au moins entre deux emissions (temps d'emission limite en Europe)
SILENCE = 600         # sans nouvelles de la radio depuis 10 min : on verifie qu'elle repond encore
MAX_TEXTE = 500
MAX_JOURNAL = 300
PHOTO = 30            # secondes entre deux mises a jour de details.json
RELEVE = 60           # secondes entre deux releves des statistiques dans l'historique
MAX_MESHTASTIC = 228  # octets par message
MAX_MESHCORE = 160    # octets par message (MAX_TEXT_LEN) ; sur un canal, « Nom: » part devant
ANNONCE_MESHCORE = 6 * 3600   # MeshCore : la station s'annonce (advert) au plus toutes les 6 h, et a chaque connexion
ATTENTE_RADIO = 180   # garde-fou : secondes laissees a la radio pour revenir apres un reglage risque
MAX_RESULTATS = 200
GARDER_SAUVEGARDES = 30

radio = None          # la connexion Meshtastic en cours
connectee_depuis = 0
dernier_signe = 0     # derniere fois que la radio a donne signe de vie
derniere_emission = 0
derniere_photo = 0
dernier_releve = 0
deja_vus = []         # numeros des derniers paquets recus (une radio peut nous renvoyer le meme deux fois)
journal = []          # voir JOURNAL ; garde aussi en memoire
VERROU_JOURNAL = threading.Lock()
demandes = {}         # requetes envoyees par radio, en attente de reponse : id -> {type, noeud, limite, heure}


def reglages_section(nom):
    try:
        return json.load(open(REGLAGES)).get(nom, {})
    except (OSError, ValueError):
        return {}


def active():
    return reglages_section('radio').get('active') is True


def mesh_reglage(cle, defaut):
    v = reglages_section('mesh').get(cle, defaut)
    return defaut if v is None else v


def reseau():
    try:
        return json.load(open(RESEAU))
    except (OSError, ValueError):
        return {'reseau': 'meshtastic'}


def ecrire(chemin, donnees, mode=0o644):
    tmp = chemin + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(donnees, f, ensure_ascii=False, default=str)
    os.chmod(tmp, mode)
    os.replace(tmp, chemin)


def lire(chemin, defaut):
    try:
        return json.load(open(chemin))
    except (OSError, ValueError):
        return defaut


ETAT_ACTUEL = None
def noter_etat(etat, nom='', res='meshtastic', maxi=MAX_MESHTASTIC):
    global ETAT_ACTUEL
    if ETAT_ACTUEL != (etat, nom, res, maxi):
        ETAT_ACTUEL = (etat, nom, res, maxi)
        ecrire(ETAT, {'etat': etat, 'nom': nom, 'depuis': time.time(), 'reseau': res, 'max': maxi})
        print('Radio :', res, etat, nom, flush=True)


def noter_journal(entree):
    # Appele depuis le fil de la radio (reception) et depuis la boucle principale (emission)
    with VERROU_JOURNAL:
        journal.append(entree)
        del journal[:-MAX_JOURNAL]
        try:
            ecrire(JOURNAL, journal)
        except OSError as e:
            print('Journal radio impossible a ecrire :', e, flush=True)


def statut(ident, valeur, raison=''):
    """Message direct envoye : remis (accuse de reception) ou echec."""
    with VERROU_JOURNAL:
        for e in journal:
            if e.get('id') == ident and e.get('sens') == 'emis' and e.get('statut') == 'attente':
                e['statut'], e['raison'] = valeur, raison
        try:
            ecrire(JOURNAL, journal)
        except OSError:
            pass


def deposer_pour_tableau(nom, texte):
    ecrire(os.path.join(RECUS, '%d-%s.json' % (time.time() * 1000, secrets.token_hex(3))),
           {'heure': time.time(), 'nom': nom, 'texte': texte})


def effacer_journal_si_demande():
    # « Effacer les ecrits » des Parametres : le journal des messages radio part aussi, et les textes de l'historique
    if os.path.exists(EFFACER_JOURNAL):
        with VERROU_JOURNAL:
            del journal[:]
            ecrire(JOURNAL, journal)
        HISTO.effacer_textes()
        os.remove(EFFACER_JOURNAL)


def prochain_message():
    """Le plus ancien message en attente (fichier, contenu), en respectant l'ecart entre deux emissions."""
    if time.time() - derniere_emission < ECART:
        return None
    fichiers = sorted(glob.glob(os.path.join(A_ENVOYER, '*.json')))
    if not fichiers:
        return None
    f = fichiers[0]
    try:
        m = json.load(open(f))
    except (OSError, ValueError):   # efface entre-temps depuis le tableau, ou illisible
        try:
            os.remove(f)
        except OSError:
            pass
        return None
    if not os.path.exists(f):       # efface depuis le tableau a l'instant : on ne l'envoie pas
        return None
    m['texte'] = str(m.get('texte', ''))[:MAX_TEXTE]
    m['canal'] = m.get('canal') if isinstance(m.get('canal'), int) and 0 <= m.get('canal') < 8 else 0
    m['a'] = str(m.get('a') or '')
    return f, m


def message_parti(f, m):
    global derniere_emission
    derniere_emission = time.time()
    ecrire(os.path.join(PARTIS, os.path.basename(f)), {'id': m.get('id')})
    try:
        os.remove(f)
    except OSError:
        pass


def nettoyer(s, n):
    return ' '.join(str(s).split())[:n]


# =====================================================================  Balise (Parametres > Radio > Balise)
# Un message tout fait, envoye tout seul sur un canal a intervalle regulier (3 h par defaut), au depart seulement
# quand la page Urgence est allumee : pour que ceux qui ont une radio apprennent que la station existe et ou elle est.
# Il passe par la meme file que les messages du tableau (meme ecart entre deux emissions, meme journal).
BALISE = os.path.join(DOSSIER, 'balise.json')        # {derniere: heure du dernier envoi, texte: dernier texte envoye}
balise_ssid = [0, '']                                # le nom du wifi, relu toutes les 10 minutes


def nom_wifi():
    if time.time() - balise_ssid[0] > 600:
        try:
            import subprocess
            balise_ssid[1] = subprocess.run(['nmcli', '-g', '802-11-wireless.ssid', 'connection', 'show', 'prometheus-wifi'],
                                            capture_output=True, text=True, timeout=10).stdout.strip()
        except Exception:
            pass
        balise_ssid[0] = time.time()
    return balise_ssid[1]


def rendre_balise(texte, maxi):
    """Le texte de la balise, cases remplies : {nom} {position} {wifi} {heure} {batterie}. Le meme calcul est fait
    par prometheus-admin pour l'apercu des Parametres (garder les deux pareils)."""
    moi = lire(DETAILS, {}).get('moi', {})
    pos = '%.4f, %.4f' % (moi['lat'], moi['lon']) if moi.get('lat') and moi.get('lon') else ''
    bat = moi.get('batterie')
    valeurs = {'nom': moi.get('nom') or lire(ETAT, {}).get('nom', ''), 'position': pos, 'wifi': nom_wifi(),
               'heure': time.strftime('%H:%M'), 'batterie': '' if bat is None else ('secteur' if bat > 100 else '%d %%' % bat)}
    t = str(texte)
    for k, v in valeurs.items():
        t = t.replace('{%s}' % k, v)
    t = ' '.join(t.split())
    while len(t.encode()) > maxi:          # trop long pour le reseau en service : coupe a la fin
        t = t[:-1]
    return t


def balise():
    """A chaque tour de boucle : met la balise dans la file quand son heure est venue."""
    b = reglages_section('balise')
    if b.get('active') is not True or not str(b.get('texte', '')).strip():
        return
    if b.get('urgence_seulement', True) and reglages_section('urgence').get('active') is not True:
        return
    etat = lire(BALISE, {})
    heures = b.get('heures') if b.get('heures') in (1, 3, 6, 12) else 3
    if time.time() - etat.get('derniere', 0) < heures * 3600:
        return
    texte = rendre_balise(b['texte'], lire(ETAT, {}).get('max') or MAX_MESHTASTIC)
    if not texte:
        return
    canal = b.get('canal') if type(b.get('canal')) is int and 0 <= b.get('canal') < 8 else 0
    ident = 'b' + secrets.token_hex(6)
    ecrire(os.path.join(A_ENVOYER, '%d-%s.json' % (time.time() * 1000, ident)), {'id': ident, 'texte': texte, 'canal': canal, 'a': ''})
    ecrire(BALISE, {'derniere': time.time(), 'texte': texte, 'canal': canal})
    print('Balise mise dans la file :', texte, flush=True)


# =====================================================================  Historique (section Mesh)
class Historique:
    """Ce que la station a entendu et mesure, garde 90 jours (Parametres > Mesh). Lu par prometheus-admin."""

    def __init__(self):
        self.verrou = threading.Lock()
        self.db = None
        self.nettoye = 0

    def ouvrir(self):
        if self.db:
            return self.db
        self.db = sqlite3.connect(HISTORIQUE, check_same_thread=False, timeout=10)
        self.db.execute('PRAGMA journal_mode=WAL')
        self.db.executescript('''
            CREATE TABLE IF NOT EXISTS paquets (heure REAL, reseau TEXT, sens TEXT, de TEXT, nom TEXT, a TEXT,
                port TEXT, canal INTEGER, snr REAL, rssi INTEGER, sauts INTEGER, relais TEXT, resume TEXT);
            CREATE INDEX IF NOT EXISTS paquets_heure ON paquets(heure);
            CREATE INDEX IF NOT EXISTS paquets_de ON paquets(de, heure);
            CREATE TABLE IF NOT EXISTS stats (heure REAL, reseau TEXT, donnees TEXT);
            CREATE INDEX IF NOT EXISTS stats_heure ON stats(heure);
            CREATE TABLE IF NOT EXISTS telemetrie (heure REAL, reseau TEXT, noeud TEXT, donnees TEXT);
            CREATE INDEX IF NOT EXISTS telemetrie_noeud ON telemetrie(noeud, heure);
        ''')
        os.chmod(HISTORIQUE, 0o640)
        return self.db

    def ajouter(self, table, valeurs):
        try:
            with self.verrou:
                db = self.ouvrir()
                db.execute('INSERT INTO %s VALUES (%s)' % (table, ','.join('?' * len(valeurs))), valeurs)
                db.commit()
                if time.time() - self.nettoye > 3600:
                    self.nettoye = time.time()
                    jours = mesh_reglage('historique_jours', 90)
                    if jours:
                        limite = time.time() - jours * 86400
                        for t in ('paquets', 'stats', 'telemetrie'):
                            db.execute('DELETE FROM %s WHERE heure < ?' % t, (limite,))
                        db.commit()
        except Exception as e:
            print('Historique impossible a ecrire :', e, flush=True)

    def paquet(self, reseau_, sens, de, nom, a, port, canal, snr, rssi, sauts, relais, resume):
        self.ajouter('paquets', (time.time(), reseau_, sens, de, nom, a, port, canal, snr, rssi, sauts, relais,
                                 json.dumps(resume, ensure_ascii=False, default=str) if resume else None))

    def stats(self, reseau_, donnees):
        self.ajouter('stats', (time.time(), reseau_, json.dumps(donnees, default=str)))

    def telemetrie(self, reseau_, noeud, donnees):
        self.ajouter('telemetrie', (time.time(), reseau_, noeud, json.dumps(donnees, default=str)))

    def effacer_textes(self):
        try:
            with self.verrou:
                db = self.ouvrir()
                db.execute("UPDATE paquets SET resume = NULL WHERE resume LIKE '%\"texte\"%'")
                db.commit()
        except Exception as e:
            print('Historique : textes non effaces :', e, flush=True)


HISTO = Historique()


# =====================================================================  Ordres de la section Mesh
def ordres_en_attente():
    """Les ordres deposes par prometheus-admin, du plus ancien au plus recent (lus puis effaces)."""
    res = []
    for f in sorted(glob.glob(os.path.join(ORDRES, '*.json'))):
        try:
            o = json.load(open(f))
        except (OSError, ValueError):
            o = None
        try:
            os.remove(f)
        except OSError:
            pass
        # Un ordre reste valable 2 minutes (page fermee, radio absente : on ne le rejoue pas des heures apres)
        if isinstance(o, dict) and o.get('id') and time.time() - o.get('heure', 0) < 120:
            res.append(o)
    return res


def repondre(ordre, ok, r=None, erreur=''):
    ident = ''.join(c for c in str(ordre.get('id', '')) if c.isalnum())[:32]
    if not ident:
        return
    ecrire(os.path.join(REPONSES, ident + '.json'),
           {'id': ident, 'ok': ok, 'r': r if ok else None, 'erreur': '' if ok else str(erreur)[:300], 'heure': time.time()})
    # Les reponses de plus de 10 minutes partent
    for f in glob.glob(os.path.join(REPONSES, '*.json')):
        try:
            if time.time() - os.path.getmtime(f) > 600:
                os.remove(f)
        except OSError:
            pass


class Refus(Exception):
    """Un ordre impossible : le texte est montre tel quel a l'administrateur."""


VERROU_RESULTATS = threading.Lock()


def noter_resultat(type_, noeud, donnees, ident=None):
    """Une reponse venue par radio (traceroute, position, reglages lus a distance...), pour la page."""
    with VERROU_RESULTATS:
        liste = lire(RESULTATS, [])
        liste.append({'heure': time.time(), 'type': type_, 'noeud': noeud, 'id': ident, 'donnees': donnees})
        ecrire(RESULTATS, liste[-MAX_RESULTATS:])


def demandes_perimees():
    for ident, d in list(demandes.items()):
        if time.time() > d['limite']:
            demandes.pop(ident, None)
            noter_resultat(d['type'], d['noeud'], {'erreur': 'sans réponse'}, ident)


def ranger_sauvegarde(nom, contenu):
    """Une sauvegarde avant changement (dossier lisible par la station seulement : il contient les cles)."""
    os.makedirs(SAUVE_MESH, mode=0o700, exist_ok=True)
    f = os.path.join(SAUVE_MESH, nom)
    with open(f + '.tmp', 'w') as s:
        s.write(contenu)
    os.chmod(f + '.tmp', 0o600)
    os.replace(f + '.tmp', f)
    base = nom.split('-2')[0]
    for vieux in sorted(glob.glob(os.path.join(SAUVE_MESH, base + '-2*')))[:-GARDER_SAUVEGARDES]:
        os.remove(vieux)
    return nom


def demander_outil(ordre, contenu):
    """Fait faire une operation par l'outil radio (root), comme le ferait la page : un fichier dans commande/."""
    try:
        with open(os.path.join(COMMANDE, 'radio-' + ordre), 'w') as f:
            f.write(contenu)
        return True
    except OSError as e:
        print('Ordre pour l’outil radio impossible :', e, flush=True)
        return False


def garde_fou(fichier, raison):
    ecrire(GARDE_FOU, {'heure': time.time(), 'fichier': fichier, 'raison': raison})


def verifier_garde_fou(repond):
    """Apres un reglage risque : la radio repond de nouveau -> tout va bien ; muette trop longtemps -> on
    fait remettre la sauvegarde par l'outil radio (il reinstalle le logiciel s'il le faut)."""
    g = lire(GARDE_FOU, None)
    if not g:
        return
    if repond and time.time() - g.get('heure', 0) > 20:
        os.remove(GARDE_FOU)
        print('Garde-fou : la radio est revenue apres le reglage', flush=True)
    elif not repond and time.time() - g.get('heure', 0) > ATTENTE_RADIO:
        os.remove(GARDE_FOU)
        print('Garde-fou : la radio ne revient pas, remise de', g.get('fichier'), flush=True)
        demander_outil('restaurer', json.dumps({'fichier': g.get('fichier'), 'auto': True}))


# =====================================================================  Meshtastic (USB)
def trouver_port():
    """La carte radio : le port note par l'outil radio (numero de serie USB de la T-Beam), sinon sa puce USB-serie
    (1a86 = CH9102, CP210x), sinon le premier port. Une carte branchee pour l'atelier n'est jamais prise a sa place."""
    note = reseau().get('port')
    if note and os.path.exists('/dev/serial/by-id/' + note):
        return '/dev/serial/by-id/' + note
    ports = sorted(glob.glob('/dev/serial/by-id/*'))
    for p in ports:
        if any(m in p for m in ('1a86', 'CP210', 'Silicon_Labs')):
            return p
    return ports[0] if ports else None


def fermer():
    global radio
    if radio:
        try:
            radio.close()
        except Exception:
            pass
    radio = None


def accuse(ident, paquet):
    """Reponse a un message direct : accuse de reception (remis) ou abandon (non remis)."""
    try:
        raison = paquet['decoded']['routing'].get('errorReason', 'NONE')
    except (KeyError, TypeError, AttributeError):
        raison = 'NONE'
    statut(ident, 'remis' if raison == 'NONE' else 'echec', '' if raison == 'NONE' else raison)


def nom_de(ident):
    n = (radio.nodes or {}).get(ident or '', {}) if radio else {}
    return nettoyer((n.get('user') or {}).get('longName') or ident or '?', 40)


def ident_de_num(num):
    if num is None:
        return ''
    try:
        return '!%08x' % (int(num) & 0xFFFFFFFF)
    except (TypeError, ValueError):
        return str(num)


def recu(packet, interface):
    """Un message texte arrive par radio : on le note au journal et on le depose pour le tableau."""
    global dernier_signe
    if interface is not radio:
        return
    dernier_signe = time.time()
    try:
        if packet.get('from') == radio.myInfo.my_node_num or packet.get('id') in deja_vus:
            return
        deja_vus.append(packet.get('id'))
        del deja_vus[:-200]
        texte = nettoyer(packet['decoded'].get('text', ''), MAX_TEXTE)
        if not texte:
            return
        nom = nom_de(packet.get('fromId'))
        direct = packet.get('toId') not in (None, '^all')
        sauts = packet.get('hopStart', 0) - packet.get('hopLimit', 0) if 'hopStart' in packet else None
        noter_journal({'heure': time.time(), 'sens': 'recu', 'de': packet.get('fromId') or '', 'nom': nom,
                       'a': packet.get('toId') or '^all', 'direct': direct, 'canal': packet.get('channel', 0),
                       'texte': texte, 'snr': packet.get('rxSnr'), 'rssi': packet.get('rxRssi'), 'sauts': sauts})
        deposer_pour_tableau(nom, texte)
    except Exception as e:
        print('Message recu illisible :', e, flush=True)


def _sur(d, *cles):
    """Les cles demandees d'un dictionnaire (rien d'autre : jamais de cle secrete ni d'objet binaire)."""
    return {k: d[k] for k in cles if isinstance(d, dict) and k in d and isinstance(d[k], (int, float, str, bool, list))}


def resumer_paquet(port, d):
    """Ce qu'on garde d'un paquet Meshtastic pour l'historique et le journal technique."""
    if port == 'TEXT_MESSAGE_APP':
        return {'texte': nettoyer(d.get('text', ''), MAX_TEXTE)}
    if port == 'POSITION_APP':
        return _sur(d.get('position') or {}, 'latitude', 'longitude', 'altitude', 'satsInView', 'groundSpeed', 'precisionBits')
    if port == 'NODEINFO_APP':
        return _sur(d.get('user') or {}, 'id', 'longName', 'shortName', 'hwModel', 'role', 'isLicensed')
    if port == 'TELEMETRY_APP':
        t = d.get('telemetry') or {}
        return {k: t[k] for k in ('deviceMetrics', 'environmentMetrics', 'powerMetrics', 'localStats', 'airQualityMetrics',
                                   'healthMetrics') if isinstance(t.get(k), dict)}
    if port == 'ROUTING_APP':
        return _sur(d.get('routing') or {}, 'errorReason')
    if port == 'TRACEROUTE_APP':
        return _sur(d.get('traceroute') or {}, 'route', 'snrTowards', 'routeBack', 'snrBack')
    if port == 'NEIGHBORINFO_APP':
        n = d.get('neighborinfo') or {}
        return {'voisins': [_sur(x, 'nodeId', 'snr') for x in n.get('neighbors', []) if isinstance(x, dict)]}
    if port == 'WAYPOINT_APP':
        return _sur(d.get('waypoint') or {}, 'name', 'description', 'latitudeI', 'longitudeI')
    if port == 'RANGE_TEST_APP':
        return {'texte': nettoyer(d.get('text', '') or '', 80)}
    if port == 'STORE_FORWARD_APP':
        return _sur(d.get('storeforward') or {}, 'rr')
    return {}


def paquet_meshtastic(packet, interface):
    """Tout paquet arrive par la radio : historique (et telemetrie, statistiques de la station)."""
    global dernier_signe
    if interface is not radio:
        return
    dernier_signe = time.time()
    try:
        d = packet.get('decoded') or {}
        port = d.get('portnum') or ('CHIFFRE' if 'encrypted' in packet else '?')
        moi = radio.myInfo.my_node_num if radio.myInfo else None
        de = packet.get('fromId') or ident_de_num(packet.get('from'))
        resume = resumer_paquet(port, d)
        if port == 'TELEMETRY_APP':
            if packet.get('from') == moi:
                if resume.get('localStats'):
                    HISTO.stats('meshtastic', dict(resume.get('localStats'), source='radio'))
            elif resume:
                HISTO.telemetrie('meshtastic', de, resume)
        if packet.get('from') == moi:
            return    # ce que notre radio dit d'elle-meme n'a pas ete entendu par la radio
        # « Entendue a l'instant » a l'heure de la station (l'horloge de la radio peut retarder : vu le 19/10/2026)
        fiche = (radio.nodes or {}).get(de)
        if fiche is not None:
            fiche['lastHeard'] = int(time.time())
        sauts = packet.get('hopStart', 0) - packet.get('hopLimit', 0) if 'hopStart' in packet else None
        HISTO.paquet('meshtastic', 'recu', de, nom_de(de), packet.get('toId') or ident_de_num(packet.get('to')), port,
                     packet.get('channel', 0), packet.get('rxSnr'), packet.get('rxRssi'), sauts,
                     ident_de_num(packet.get('relayNode')) if packet.get('relayNode') else None, resume)
    except Exception as e:
        print('Paquet illisible :', e, flush=True)


def nom_preset(lora):
    """LONG_FAST -> LongFast : le nom que les applis donnent au canal principal sans nom."""
    try:
        from meshtastic.protobuf import config_pb2
        return ''.join(m.capitalize() for m in config_pb2.Config.LoRaConfig.ModemPreset.Name(lora.modem_preset).split('_'))
    except Exception:
        return ''


def _nom_enum(message, champ):
    try:
        return message.DESCRIPTOR.fields_by_name[champ].enum_type.values_by_number[getattr(message, champ)].name
    except Exception:
