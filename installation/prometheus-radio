def traiter_ordres_meshtastic():
    for o in ordres_en_attente():
        f = ACTIONS_MESHTASTIC.get(o.get('action'))
        if not f:
            repondre(o, False, erreur='Action inconnue sous Meshtastic.')
            continue
        if radio is None:
            repondre(o, False, erreur='La radio ne répond pas.')
            continue
        try:
            p = o.get('p') if isinstance(o.get('p'), dict) else {}
            repondre(o, True, f(p))
            print('Ordre Mesh :', o.get('action'), 'fait', flush=True)
        except Refus as e:
            repondre(o, False, erreur=e)
        except (Exception, SystemExit) as e:   # la bibliotheque Meshtastic quitte (SystemExit) sur certaines erreurs
            print('Ordre Mesh', o.get('action'), 'en echec :', repr(e), flush=True)
            repondre(o, False, erreur='La radio a refusé : %s' % (str(e) or e.__class__.__name__))


def boucle_meshtastic():
    """Tourne tant que le reseau reste Meshtastic."""
    from pubsub import pub
    pub.subscribe(recu, 'meshtastic.receive.text')
    pub.subscribe(paquet_meshtastic, 'meshtastic.receive')
    pub.subscribe(perdue, 'meshtastic.connection.lost')
    ecrire_schema()
    while reseau().get('reseau', 'meshtastic') == 'meshtastic':
        effacer_journal_si_demande()
        demandes_perimees()
        if not active():
            fermer()
            noter_etat('eteinte')
            for o in ordres_en_attente():
                repondre(o, False, erreur='La radio est désactivée dans les Paramètres.')
            time.sleep(10)
            continue
        if radio is None and not connecter():
            verifier_garde_fou(False)
            for o in ordres_en_attente():
                repondre(o, False, erreur='La radio ne répond pas.')
            time.sleep(15)
            continue
        verifier_garde_fou(True)
        # Sans nouvelles depuis longtemps : on reouvre la liaison, ce qui prouve que la radio repond encore
        if time.time() - dernier_signe > SILENCE:
            fermer()
            continue
        traiter_ordres_meshtastic()
        balise()
        if time.time() - derniere_photo > PHOTO:
            photographier()
        if time.time() - dernier_releve > RELEVE:
            relever_meshtastic()
        try:
            emettre()
        except Exception as e:
            print('Emission impossible :', e, flush=True)
            fermer()
            noter_etat('muette')
            time.sleep(10)
            continue
        time.sleep(1)
    fermer()


# =====================================================================  MeshCore (Bluetooth)
TYPES_MESHCORE = {1: 'compagnon', 2: 'répéteur', 3: 'salon', 4: 'capteur'}
PAQUETS_MESHCORE = {0: 'REQ', 1: 'RESPONSE', 2: 'TXT_MSG', 3: 'ACK', 4: 'ADVERT', 5: 'GRP_TXT', 6: 'GRP_DATA',
                    7: 'ANON_REQ', 8: 'PATH', 9: 'TRACE', 10: 'MULTIPART', 11: 'CONTROL', 15: 'RAW_CUSTOM'}


class StationMeshCore:
    """La T-Beam sous MeshCore, pilotee par Bluetooth (adresse dans reseau.json, appairee par prometheus-radio-outil)."""

    def __init__(self, adresse):
        self.adresse = adresse
        self.mc = None
        self.depuis = 0
        self.annonce = 0
        self.acks = {}        # code d'accuse attendu -> (id du message, heure limite)
        self.nom = ''
        self.taches = set()

    def maxi(self):
        # Sur un canal, MeshCore met « Nom: » devant le texte, dans la meme limite
        return MAX_MESHCORE - len(self.nom.encode()) - 2

    async def fermer(self):
        if self.mc:
            try:
                await self.mc.disconnect()
            except Exception:
                pass
        self.mc = None

    async def connecter(self):
        from meshcore import MeshCore, EventType
        # Apres un arret du service (ou de l'outil radio), le systeme Bluetooth peut garder l'ancienne
        # connexion ouverte : la nouvelle echoue alors en boucle (vu le 15/10/2026). On la coupe d'abord.
        try:
            import subprocess
            subprocess.run(['bluetoothctl', 'disconnect', self.adresse], capture_output=True, timeout=20)
            await asyncio.sleep(2)
        except Exception:
            pass
        try:
            self.mc = await asyncio.wait_for(MeshCore.create_ble(self.adresse), 45)
        except Exception as e:
            print('MeshCore : connexion impossible :', e, flush=True)
            self.mc = None
        if not self.mc:
            noter_etat('muette', res='meshcore', maxi=MAX_MESHCORE)
            return False
        mc = self.mc
        self.depuis = time.time()
        self.nom = (mc.self_info or {}).get('name', '')
        # La radio n'a pas d'horloge fiable : elle prend celle de la station
        try:
            await mc.commands.set_time(int(time.time()))
        except Exception:
            pass
        mc.subscribe(EventType.CONTACT_MSG_RECV, self.recu)
        mc.subscribe(EventType.CHANNEL_MSG_RECV, self.recu)
        mc.subscribe(EventType.ACK, self.ack)
        mc.subscribe(EventType.RX_LOG_DATA, self.entendu)
        mc.subscribe(EventType.NEW_CONTACT, self.nouveau_contact)
        for ev, type_ in ((EventType.TRACE_DATA, 'trace'), (EventType.PATH_RESPONSE, 'chemin'),
                          (EventType.TELEMETRY_RESPONSE, 'telemetrie'), (EventType.STATUS_RESPONSE, 'statut'),
                          (EventType.LOGIN_SUCCESS, 'connexion'), (EventType.LOGIN_FAILED, 'connexion'),
                          (EventType.NEIGHBOURS_RESPONSE, 'voisins'), (EventType.ACL_RESPONSE, 'acces')):
            mc.subscribe(ev, self.reponse_par_radio(type_, ev == EventType.LOGIN_FAILED))
        await mc.ensure_contacts()
        await mc.start_auto_message_fetching()
        noter_etat('ok', self.nom, 'meshcore', self.maxi())
        if time.time() - self.annonce > 3600:
            await mc.commands.send_advert(flood=True)
            self.annonce = time.time()
        await self.photographier()
        return True

    def nom_contact(self, prefixe):
        c = self.mc.get_contact_by_key_prefix(prefixe) if self.mc and prefixe else None
        return nettoyer(c['adv_name'], 40) if c else (prefixe or '?')[:12]

    async def recu(self, ev):
        p = ev.payload or {}
        texte = str(p.get('text', ''))
        if p.get('type') == 'CHAN':
            # « Nom: texte » : MeshCore met le nom de l'expediteur devant le texte d'un message de canal
            nom, _, reste = texte.partition(': ')
            if not reste:
                nom, reste = '?', texte
            de, direct = '', False
        else:
            de = p.get('pubkey_prefix', '')
            nom, reste, direct = self.nom_contact(de), texte, True
            c = self.mc.get_contact_by_key_prefix(de) if self.mc else None
            de = c['public_key'] if c else de
            if p.get('txt_type') == 1:
                # Reponse a une commande envoyee a un repeteur ou un salon (section Mesh > A distance) : pas un message
                ident = next((i for i, d in demandes.items() if d['type'] == 'commande' and str(d['noeud']).startswith(p.get('pubkey_prefix', '?'))), None)
                demandes.pop(ident, None)
                noter_resultat('commande', de, {'reponse': texte[:1000]}, ident)
                return
        reste = nettoyer(reste, MAX_TEXTE)
        if not reste:
            return
        nom = nettoyer(nom, 40)
        sauts = p.get('path_len')
        noter_journal({'heure': time.time(), 'sens': 'recu', 'de': de, 'nom': nom, 'a': 'moi' if direct else '^all',
                       'direct': direct, 'canal': p.get('channel_idx', 0), 'texte': reste, 'snr': p.get('SNR'),
                       'rssi': None, 'sauts': None if sauts in (None, 255, -1) else sauts})
        deposer_pour_tableau(nom, reste)

    async def entendu(self, ev):
        """Tout paquet radio entendu (journal du logiciel MeshCore) : historique et journal technique."""
        p = ev.payload or {}
        try:
            type_ = PAQUETS_MESHCORE.get(p.get('payload_type'), str(p.get('payload_type', '?')))
            de, nom = '', ''
            if type_ == 'ADVERT' and p.get('adv_key'):
                de = str(p.get('adv_key'))
                nom = nettoyer(p.get('adv_name') or '', 40)
            resume = {k: p[k] for k in ('route_typename', 'path_len', 'path', 'payload_length', 'adv_name', 'adv_lat', 'adv_lon',
                                        'adv_type', 'chan_name', 'payload_ver') if k in p and isinstance(p[k], (int, float, str))}
            if isinstance(p.get('message'), str):
                resume['texte'] = nettoyer(p['message'], MAX_TEXTE)   # message d'un canal que la station sait lire
            HISTO.paquet('meshcore', 'recu', de, nom, '', type_, None, p.get('snr'), p.get('rssi'),
                         p.get('path_len') if isinstance(p.get('path_len'), int) else None, None, resume)
        except Exception as e:
            print('MeshCore : paquet illisible :', e, flush=True)

    async def nouveau_contact(self, ev):
        """Ajout manuel des contacts choisi : la radio annoncee attend qu'on l'ajoute depuis la page Noeuds."""
        c = ev.payload or {}
        if not c.get('public_key'):
            return
        liste = [x for x in lire(ATTENTE_CONTACTS, []) if x.get('public_key') != c['public_key']]
        liste.append(dict(c, heure=time.time()))
        ecrire(ATTENTE_CONTACTS, liste[-100:])

    def reponse_par_radio(self, type_, echec=False):
        """Une reponse arrivee par radio : on la rattache a la demande en attente du meme genre (et de la meme radio)."""
        async def recevoir(ev):
            p = dict(ev.payload or {})
            prefixe = str(p.get('pubkey_prefix') or p.get('pubkey_pre') or '')
            ident, noeud = None, prefixe
            for i, d in sorted(demandes.items(), key=lambda x: x[1]['heure']):
                if d['type'] == type_ and (not prefixe or str(d['noeud']).startswith(prefixe)):
                    ident, noeud = i, d['noeud']
                    demandes.pop(i, None)
                    break
            if echec:
                p['erreur'] = 'mot de passe refusé'
            noter_resultat(type_, noeud, {k: v for k, v in p.items() if isinstance(v, (int, float, str, bool, list, dict))}, ident)
        return recevoir

    async def ack(self, ev):
        code = (ev.payload or {}).get('code', '')
        if code in self.acks:
            statut(self.acks.pop(code)[0], 'remis')

    async def emettre(self):
        from meshcore import EventType
        # Accuses jamais venus : non remis
        for code, (ident, limite) in list(self.acks.items()):
            if time.time() > limite:
                del self.acks[code]
                statut(ident, 'echec', 'sans réponse')
        suivant = prochain_message()
        if not suivant:
            return
        f, m = suivant
        entree = {'heure': time.time(), 'sens': 'emis', 'de': '', 'nom': self.nom, 'a': m['a'] or '^all',
                  'direct': bool(m['a']), 'canal': m['canal'], 'texte': m['texte'], 'id': m.get('id')}
        if m['a']:
            contact = self.mc.get_contact_by_key_prefix(m['a'][:12])
            if not contact:
                print('MeshCore : contact inconnu', m['a'][:12], flush=True)
                entree.update(statut='echec', raison='contact inconnu', nom_a=m['a'][:12])
                noter_journal(entree)
                message_parti(f, m)
                return
            r = await self.mc.commands.send_msg(contact, m['texte'])
            entree.update(statut='attente', nom_a=nettoyer(contact['adv_name'], 40))
            if r.type == EventType.MSG_SENT:
                attente = max(30, r.payload.get('suggested_timeout', 0) / 1000 * 1.5)
                self.acks[r.payload['expected_ack'].hex()] = (m.get('id'), time.time() + attente)
            else:
                entree.update(statut='echec', raison='refusé par la radio')
        else:
            r = await self.mc.commands.send_chan_msg(m['canal'], m['texte'])
            if r.type == EventType.ERROR:
                raise RuntimeError('canal refusé')
        noter_journal(entree)
        HISTO.paquet('meshcore', 'emis', '', self.nom, m['a'] or '^all', 'TXT_MSG' if m['a'] else 'GRP_TXT', m['canal'],
                     None, None, None, None, {'texte': m['texte']})
        message_parti(f, m)

    async def photographier(self):
        global derniere_photo
        from meshcore import EventType
        derniere_photo = time.time()
        mc = self.mc
        try:
            moi = mc.self_info or {}
            self.nom = moi.get('name', self.nom)
            bat = await mc.commands.get_bat()
            mv = bat.payload.get('level') if bat.type == EventType.BATTERY else None
            info = await mc.commands.send_device_query()
            version = info.payload.get('ver', '') if info.type == EventType.DEVICE_INFO else ''
            canaux = []
            for i in range(min(40, info.payload.get('max_channels') or 8) if info.type == EventType.DEVICE_INFO else 8):
                r = await mc.commands.get_channel(i)
                if r.type == EventType.CHANNEL_INFO and r.payload.get('channel_name'):
                    canaux.append({'index': i, 'role': 'principal' if i == 0 else 'secondaire', 'nom': r.payload['channel_name']})
            await mc.ensure_contacts()
            noeuds = []
            for c in list(mc.contacts.values()):
                lat, lon = c.get('adv_lat') or None, c.get('adv_lon') or None
                noeuds.append({'id': c['public_key'], 'nom': nettoyer(c.get('adv_name') or c['public_key'][:12], 40),
                               'court': '', 'materiel': TYPES_MESHCORE.get(c.get('type'), ''),
                               # derniere annonce entendue (lastmod change aussi quand la station modifie le contact)
                               'vu': c.get('last_advert') or c.get('lastmod'),
                               'snr': None, 'sauts': None if c.get('out_path_len', -1) < 0 else c['out_path_len'],
                               'batterie': None, 'tension': None, 'lat': lat, 'lon': lon,
                               # Section Mesh : le reste de la fiche
                               'cle': c['public_key'], 'type': c.get('type'), 'drapeaux': c.get('flags', 0),
                               'favori': bool(c.get('flags', 0) & 1), 'chemin': c.get('out_path', ''),
                               'annonce': c.get('last_advert'), 'modifie': c.get('lastmod')})
            noeuds.sort(key=lambda x: -(x['vu'] or 0))
            ecrire(DETAILS, {'reseau': 'meshcore', 'heure': time.time(), 'depuis': self.depuis,
                             'moi': {'id': moi.get('public_key', ''), 'nom': self.nom, 'materiel': 'T-Beam', 'version': version,
                                     # tension en mV ; pourcentage approche (3,3 V vide, 4,2 V plein)
                                     'batterie': None if mv is None else max(0, min(100, round((mv - 3300) / 9))),
                                     'tension': None if mv is None else mv / 1000,
                                     'region': '%s MHz' % moi.get('radio_freq'), 'preset': '%s kHz · SF%s · CR%s' % (
                                         moi.get('radio_bw'), moi.get('radio_sf'), moi.get('radio_cr')),
                                     'lat': moi.get('adv_lat') or None, 'lon': moi.get('adv_lon') or None,
                                     'occupation': None, 'emission': None, 'cle': moi.get('public_key', '')},
                             'canaux': canaux, 'noeuds': noeuds[:500],
                             'attente': lire(ATTENTE_CONTACTS, [])})
            noter_etat('ok', self.nom, 'meshcore', self.maxi())
        except Exception as e:
            print('MeshCore : details illisibles :', e, flush=True)

    async def relever(self):
        """Chaque minute : compteurs du logiciel MeshCore (paquets, temps d'emission, bruit), dans l'historique."""
        global dernier_releve
        from meshcore import EventType
        dernier_releve = time.time()
        d = {'source': 'station'}
        for f, t in ((self.mc.commands.get_stats_core, EventType.STATS_CORE), (self.mc.commands.get_stats_radio, EventType.STATS_RADIO),
                     (self.mc.commands.get_stats_packets, EventType.STATS_PACKETS)):
            try:
                r = await f()
                if r.type == t:
                    d.update(r.payload)
            except Exception:
                pass
        d['attente'] = len(glob.glob(os.path.join(A_ENVOYER, '*.json')))
        HISTO.stats('meshcore', d)

    # ---- les ordres de la section Mesh
    async def sauvegarder(self, raison):
        from meshcore import EventType
        mc = self.mc
        moi = (await mc.commands.send_appstart()).payload or {}
        cle = await mc.commands.export_private_key()
        canaux = []
        info = await mc.commands.send_device_query()
        for i in range(min(40, (info.payload or {}).get('max_channels') or 8) if info.type == EventType.DEVICE_INFO else 8):
            r = await mc.commands.get_channel(i)
            if r.type == EventType.CHANNEL_INFO and r.payload.get('channel_name'):
                canaux.append({'index': i, 'nom': r.payload['channel_name'], 'secret': r.payload['channel_secret'].hex()})
        contacts = await mc.commands.get_contacts()
        s = {'raison': raison, 'nom': moi.get('name', ''), 'freq': moi.get('radio_freq'), 'bw': moi.get('radio_bw'),
             'sf': moi.get('radio_sf'), 'cr': moi.get('radio_cr'), 'tx': moi.get('tx_power'), 'lat': moi.get('adv_lat'),
             'lon': moi.get('adv_lon'), 'autres': {k: moi.get(k) for k in ('manual_add_contacts', 'telemetry_mode_base',
                                                                           'telemetry_mode_loc', 'telemetry_mode_env',
                                                                           'adv_loc_policy', 'multi_acks')},
             'cle': cle.payload.get('private_key').hex() if cle.type == EventType.PRIVATE_KEY else '', 'canaux': canaux,
             'contacts': list(contacts.payload.values()) if contacts.type == EventType.CONTACTS else []}
        return ranger_sauvegarde('meshcore-%s.json' % time.strftime('%Y-%m-%d-%H%M%S'), json.dumps(s, ensure_ascii=False, indent=1))

    async def o_config_lire(self, p):
        from meshcore import EventType
        mc = self.mc
        res = {}
        for nom, f, t in (('moi', mc.commands.send_appstart, EventType.SELF_INFO),
                          ('appareil', mc.commands.send_device_query, EventType.DEVICE_INFO),
                          ('variables', mc.commands.get_custom_vars, EventType.CUSTOM_VARS),
                          ('ajout_auto', mc.commands.get_autoadd_config, EventType.AUTOADD_CONFIG),
                          ('reglage_fin', mc.commands.get_tuning, EventType.TUNING_PARAMS),
                          ('batterie', mc.commands.get_bat, EventType.BATTERY),
                          ('frequences_relais', mc.commands.get_allowed_repeat_freq, EventType.ALLOWED_REPEAT_FREQ),
                          ('portee_defaut', mc.commands.get_default_flood_scope, EventType.DEFAULT_FLOOD_SCOPE)):
            try:
                r = await f()
                res[nom] = {k: v for k, v in (r.payload or {}).items() if isinstance(v, (int, float, str, bool, list, dict))} \
                    if r.type == t else None
            except Exception:
                res[nom] = None
        canaux = []
        n = (res.get('appareil') or {}).get('max_channels') or 8
        for i in range(n):
            r = await mc.commands.get_channel(i)
            if r.type == EventType.CHANNEL_INFO:
                canaux.append({'index': i, 'nom': r.payload.get('channel_name', ''), 'secret': r.payload['channel_secret'].hex(),
                               'empreinte': r.payload.get('channel_hash')})
        res['canaux'] = canaux
        return res

    async def o_config_ecrire(self, p):
        """{valeurs: {name, lat, lon, radio: {freq, bw, sf, cr, repeat}, tx_power, autres: {...}, ajout_auto: {config},
        chemin_mode, reglage_fin: {rx_delay, airtime_factor}, code, variables: {cle: valeur}, portee_defaut}}"""
        from meshcore import EventType
        v = p.get('valeurs')
        if not isinstance(v, dict) or not v:
            raise Refus('Rien à écrire.')
        mc = self.mc
        NOMS = {'name': 'nom', 'lat': 'position', 'lon': 'position', 'radio': 'réglage radio', 'tx_power': 'puissance',
                'autres': 'contacts et télémétrie', 'ajout_auto': 'ajout automatique', 'chemin_mode': 'chemin',
                'reglage_fin': 'réglage fin', 'code': 'code Bluetooth', 'variables': 'variables', 'portee_defaut': 'portée'}
        sauvegarde = await self.sauvegarder('avant : ' + ', '.join(sorted({NOMS.get(k, k) for k in v})))

        async def ok(r, quoi):
            if r is None or r.type == EventType.ERROR:
                raise Refus('La radio a refusé : %s' % quoi)
        if 'name' in v:
            nom = ' '.join(str(v['name']).split())
            if not nom or len(nom.encode()) > 31:
                raise Refus('Nom : de 1 à 31 octets.')
            await ok(await mc.commands.set_name(nom), 'nom')
        if 'lat' in v or 'lon' in v:
            try:
                lat, lon = float(v.get('lat') or 0), float(v.get('lon') or 0)
                assert -90 <= lat <= 90 and -180 <= lon <= 180
            except (TypeError, ValueError, AssertionError):
                raise Refus('Position invalide.')
            await ok(await mc.commands.set_coords(lat, lon), 'position')
        if 'radio' in v:
            r = v['radio']
            try:
                freq, bw, sf, cr = float(r['freq']), float(r['bw']), int(r['sf']), int(r['cr'])
                assert 150 <= freq <= 2500 and bw in (7.8, 10.4, 15.6, 20.8, 31.25, 41.7, 62.5, 125, 250, 500) \
                    and 5 <= sf <= 12 and 5 <= cr <= 8
            except (KeyError, TypeError, ValueError, AssertionError):
                raise Refus('Réglage radio invalide (fréquence, largeur, SF de 5 à 12, CR de 5 à 8).')
            await ok(await mc.commands.set_radio(freq, bw, sf, cr, r.get('repeat') if isinstance(r.get('repeat'), int) else None), 'radio')
        if 'tx_power' in v:
            if type(v['tx_power']) is not int or not -9 <= v['tx_power'] <= 30:
                raise Refus('Puissance invalide.')
            await ok(await mc.commands.set_tx_power(v['tx_power']), 'puissance')
        if 'autres' in v:
            infos = (await mc.commands.send_appstart()).payload or {}
            for k, x in v['autres'].items():
                if k not in ('manual_add_contacts', 'telemetry_mode_base', 'telemetry_mode_loc', 'telemetry_mode_env',
                             'adv_loc_policy', 'multi_acks') or type(x) not in (int, bool):
                    raise Refus('Réglage inconnu : %s' % k)
                infos[k] = x
            infos['manual_add_contacts'] = bool(infos.get('manual_add_contacts'))
            await ok(await mc.commands.set_other_params_from_infos(infos), 'réglages divers')
        if 'ajout_auto' in v:
            if type(v['ajout_auto']) is not int or not 0 <= v['ajout_auto'] <= 255:
                raise Refus('Ajout automatique invalide.')
            await ok(await mc.commands.set_autoadd_config(v['ajout_auto']), 'ajout automatique')
        if 'chemin_mode' in v:
            if v['chemin_mode'] not in (0, 1, 2):
                raise Refus('Mode de chemin invalide.')
            await ok(await mc.commands.set_path_hash_mode(v['chemin_mode']), 'mode de chemin')
        if 'reglage_fin' in v:
            t = v['reglage_fin']
            try:
                await ok(await mc.commands.set_tuning(int(t['rx_delay']), int(t['airtime_factor'])), 'réglage fin')
            except (KeyError, TypeError, ValueError):
                raise Refus('Réglage fin invalide.')
        if 'code' in v:
            if type(v['code']) is not int or not 0 <= v['code'] <= 999999:
                raise Refus('Code Bluetooth : 6 chiffres.')
            await ok(await mc.commands.set_devicepin(v['code']), 'code Bluetooth')
        if 'variables' in v:
            for k, x in (v['variables'] or {}).items():
                if not str(k).replace('_', '').isalnum() or ':' in str(x) or ',' in str(x):
                    raise Refus('Variable invalide : %s' % k)
                await ok(await mc.commands.set_custom_var(str(k), str(x)), 'variable %s' % k)
        if 'portee_defaut' in v:
            s = str(v['portee_defaut'] or '')
            await ok(await (mc.commands.set_default_flood_scope(s) if s else mc.commands.reset_default_flood_scope()), 'portée')
        self.nom = ((await mc.commands.send_appstart()).payload or {}).get('name', self.nom)
        await self.photographier()
        return {'sauvegarde': sauvegarde, 'redemarre': 'radio' in v}

    def contact(self, cle):
        c = self.mc.get_contact_by_key_prefix(str(cle or '')[:12]) if cle else None
        if not c:
            raise Refus('Contact inconnu.')
        return c

    async def o_noeud(self, p):
        """Actions sur un contact : favori, oublier, chemin-zero, partager, exporter, ajouter (en attente), importer."""
        from meshcore import EventType
        mc, quoi = self.mc, p.get('quoi')
        if quoi == 'importer':
            uri = str(p.get('uri', '')).strip()
            if not uri.startswith('meshcore://'):
                raise Refus('Carte de contact invalide (meshcore://…).')
            try:
                r = await mc.commands.import_contact(bytes.fromhex(uri[len('meshcore://'):]))
            except ValueError:
                raise Refus('Carte de contact illisible.')
            if r.type == EventType.ERROR:
                raise Refus('La radio a refusé la carte.')
        elif quoi == 'ajouter':
            attente = lire(ATTENTE_CONTACTS, [])
            c = next((x for x in attente if x.get('public_key') == p.get('id')), None)
            if not c:
                raise Refus('Cette radio n’attend plus.')
            r = await mc.commands.add_contact({k: v for k, v in c.items() if k != 'heure'})
            if r.type == EventType.ERROR:
                raise Refus('La radio a refusé (liste pleine ?).')
            ecrire(ATTENTE_CONTACTS, [x for x in attente if x.get('public_key') != p.get('id')])
        elif quoi == 'ecarter':
            ecrire(ATTENTE_CONTACTS, [x for x in lire(ATTENTE_CONTACTS, []) if x.get('public_key') != p.get('id')])
        else:
            c = self.contact(p.get('id'))
            if quoi == 'favori':
                r = await mc.commands.change_contact_flags(c, (c.get('flags', 0) | 1) if p.get('oui') is not False else (c.get('flags', 0) & ~1))
            elif quoi == 'oublier':
                r = await mc.commands.remove_contact(c['public_key'])
            elif quoi == 'chemin-zero':
                r = await mc.commands.reset_path(c['public_key'])
            elif quoi == 'partager':
                r = await mc.commands.share_contact(c['public_key'])
            elif quoi == 'exporter':
                r = await mc.commands.export_contact(c['public_key'])
                if r.type == EventType.CONTACT_URI:
                    return {'uri': r.payload.get('uri')}
            else:
                raise Refus('Action inconnue.')
            if r.type == EventType.ERROR:
                raise Refus('La radio a refusé.')
        await mc.ensure_contacts(follow=True)
        await self.photographier()
        return {}

    async def o_demande(self, p):
        """Par radio : chemin (decouverte), trace, telemetrie, statut (repeteur), voisins, acces, connexion, commande."""
        from meshcore import EventType
        mc, quoi = self.mc, p.get('quoi')
        ident = 'q' + secrets.token_hex(5)
        if quoi == 'annonce':
            r = await mc.commands.send_advert(flood=p.get('loin') is not False)
            self.annonce = time.time()
            return {}
        c = self.contact(p.get('id'))
        cle = c['public_key']
        if quoi == 'chemin':
            r = await mc.commands.send_path_discovery(c)
        elif quoi == 'trace':
            # Le chemin connu vers cette radio (les relais), puis elle-meme (premier octet de sa cle)
            r = await mc.commands.send_trace(path=bytes.fromhex((c.get('out_path') or '') + cle[:2]))
        elif quoi == 'telemetrie':
            r = await mc.commands.send_telemetry_req(c)
        elif quoi == 'statut':
            r = await mc.commands.send_statusreq(c)
        elif quoi in ('voisins', 'acces'):
            distance_permise()
            tache = mc.commands.req_neighbours_sync(c) if quoi == 'voisins' else mc.commands.req_acl_sync(c)
            r = await asyncio.wait_for(tache, 60)
            noter_resultat(quoi, cle, r if isinstance(r, (dict, list)) else {'reponse': str(r)[:500]}, ident)
            return {'demande': ident, 'fini': True}
        elif quoi == 'connexion':
            distance_permise()
            r = await mc.commands.send_login(c, str(p.get('mot_de_passe', ''))[:15])
        elif quoi == 'deconnexion':
            r = await mc.commands.send_logout(c)
            return {}
        elif quoi == 'commande':
            # Ligne de commande d'un repeteur ou d'un salon (apres connexion administrateur)
            distance_permise()
            cmd = ' '.join(str(p.get('commande', '')).split())[:120]
            if not cmd:
                raise Refus('Commande vide.')
            r = await mc.commands.send_cmd(c, cmd)
            demander('commande', cle, ident, 60)
            noter_resultat('commande-envoyee', cle, {'commande': cmd}, ident)
            return {'demande': ident}
        else:
            raise Refus('Demande inconnue.')
        if r is None or r.type == EventType.ERROR:
            raise Refus('La radio a refusé la demande.')
        demander(quoi, cle, ident, 120)
        return {'demande': ident}

    async def o_canal(self, p):
        """{index, nom, secret (hex 32 caracteres) | hashtag (nom commencant par #), supprimer}"""
        from meshcore import EventType
        i = p.get('index')
        if type(i) is not int or not 0 <= i < 40:
            raise Refus('Canal invalide.')
        sauvegarde = await self.sauvegarder('avant : canal %d' % i)
        if p.get('supprimer'):
            if i == 0:
                raise Refus('Le canal public ne se supprime pas.')
            r = await self.mc.commands.set_channel(i, '', b'\0' * 16)
        else:
            nom = str(p.get('nom', '')).strip()
            if not nom or len(nom.encode()) > 31:
                raise Refus('Nom de canal : de 1 à 31 octets.')
            secret = None
            if not nom.startswith('#'):
                s = str(p.get('secret') or '')
                if s == 'aleatoire' or not s:
                    secret = os.urandom(16)
                else:
                    try:
                        secret = bytes.fromhex(s)
                        assert len(secret) == 16
                    except (ValueError, AssertionError):
                        raise Refus('Secret : 32 caractères hexadécimaux.')
            r = await self.mc.commands.set_channel(i, nom, secret)
        if r.type == EventType.ERROR:
            raise Refus('La radio a refusé.')
        await self.photographier()
        return {'sauvegarde': sauvegarde}

    async def o_action(self, p):
        from meshcore import EventType
        quoi, mc = p.get('quoi'), self.mc
        if quoi == 'redemarrer':
            await mc.commands.reboot()
        elif quoi == 'heure':
            await mc.commands.set_time(int(time.time()))
        elif quoi == 'sauvegarder':
            return {'sauvegarde': await self.sauvegarder('à la demande')}
        elif quoi == 'cle':
            r = await mc.commands.export_private_key()
            if r.type != EventType.PRIVATE_KEY:
                raise Refus('La radio refuse de donner sa clé.')
            return {'cle': r.payload['private_key'].hex()}
        elif quoi == 'usine':
            sauvegarde = await self.sauvegarder('avant : remise à zéro')
            jeton = await mc.commands.request_factory_reset()
            await mc.commands.confirm_factory_reset(jeton)
            return {'sauvegarde': sauvegarde, 'redemarre': True}
        else:
            raise Refus('Action inconnue.')
        return {}

    async def traiter_ordres(self):
        actions = {'config-lire': self.o_config_lire, 'config-ecrire': self.o_config_ecrire, 'noeud': self.o_noeud,
                   'demande': self.o_demande, 'canal': self.o_canal, 'action': self.o_action}
        for o in ordres_en_attente():
            f = actions.get(o.get('action'))
            if not f:
                repondre(o, False, erreur='Action inconnue sous MeshCore.')
                continue

            async def faire(o=o, f=f):
                try:
                    repondre(o, True, await asyncio.wait_for(f(o.get('p') if isinstance(o.get('p'), dict) else {}), 90))
                    print('Ordre Mesh :', o.get('action'), 'fait', flush=True)
                except Refus as e:
                    repondre(o, False, erreur=e)
                except Exception as e:
                    print('Ordre Mesh', o.get('action'), 'en echec :', repr(e), flush=True)
                    repondre(o, False, erreur='La radio a refusé : %s' % (str(e) or e.__class__.__name__))
            t = asyncio.create_task(faire())
            self.taches.add(t)
            t.add_done_callback(self.taches.discard)

    async def boucle(self):
        while reseau().get('reseau') == 'meshcore':
            effacer_journal_si_demande()
            demandes_perimees()
            if not active():
                await self.fermer()
                noter_etat('eteinte', res='meshcore', maxi=MAX_MESHCORE)
                for o in ordres_en_attente():
                    repondre(o, False, erreur='La radio est désactivée dans les Paramètres.')
                await asyncio.sleep(10)
                continue
            if (self.mc is None or not self.mc.is_connected) and not await self.connecter():
                await self.fermer()
                for o in ordres_en_attente():
                    repondre(o, False, erreur='La radio ne répond pas.')
                await asyncio.sleep(30)
                continue
            try:
                await self.traiter_ordres()
                balise()
                if time.time() - derniere_photo > PHOTO:
                    await self.photographier()
                if time.time() - dernier_releve > RELEVE:
                    await self.relever()
                if time.time() - self.annonce > ANNONCE_MESHCORE:
                    await self.mc.commands.send_advert(flood=True)
                    self.annonce = time.time()
                await self.emettre()
            except Exception as e:
                print('MeshCore : liaison perdue :', e, flush=True)
                await self.fermer()
                noter_etat('muette', res='meshcore', maxi=MAX_MESHCORE)
                await asyncio.sleep(10)
                continue
            await asyncio.sleep(1)
        await self.fermer()


