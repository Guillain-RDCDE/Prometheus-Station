def connecter():
    """Ouvre la liaison ; renvoie True si la radio a repondu."""
    global radio, dernier_signe, connectee_depuis
    import meshtastic.serial_interface
    port = trouver_port()
    if not port:
        noter_etat('absente')
        return False
    try:
        radio = meshtastic.serial_interface.SerialInterface(devPath=port, timeout=30)
        dernier_signe = connectee_depuis = time.time()
        noter_etat('ok', radio.getLongName() or '')
        # La T-Beam sans GPS n'a pas d'horloge fiable : elle prend celle de la station (si celle-ci est a l'heure)
        if time.time() > 1.77e9:
            try:
                radio.localNode.setTime(int(time.time()))
            except (Exception, SystemExit):
                pass
        photographier()
        return True
    except (Exception, SystemExit) as e:
        print('La radio ne repond pas :', e, flush=True)
        fermer()
        noter_etat('muette')
        return False


def emettre():
    """Envoie le plus ancien message en attente."""
    suivant = prochain_message()
    if not suivant:
        return
    f, m = suivant
    entree = {'heure': time.time(), 'sens': 'emis', 'de': '', 'nom': radio.getLongName() or '', 'a': m['a'] or '^all',
              'direct': bool(m['a']), 'canal': m['canal'], 'texte': m['texte'], 'id': m.get('id')}
    if m['a']:
        # Message direct : la radio d'en face accuse reception (ou la notre finit par abandonner)
        entree['statut'] = 'attente'
        entree['nom_a'] = nom_de(m['a'])
        from meshtastic.protobuf import portnums_pb2
        radio.sendData(m['texte'].encode(), m['a'], portNum=portnums_pb2.PortNum.TEXT_MESSAGE_APP, wantAck=True,
                       onResponse=lambda p, ident=m.get('id'): accuse(ident, p), onResponseAckPermitted=True,
                       channelIndex=m['canal'])
    else:
        radio.sendText(m['texte'], channelIndex=m['canal'])   # une erreur ici = liaison perdue, le message reste en attente
    noter_journal(entree)
    HISTO.paquet('meshtastic', 'emis', '', entree['nom'], m['a'] or '^all', 'TEXT_MESSAGE_APP', m['canal'],
                 None, None, None, None, {'texte': m['texte']})
    message_parti(f, m)


