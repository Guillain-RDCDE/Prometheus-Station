# ---------------------------------------------------------------- section Mesh : remettre une sauvegarde
SAUVE_MESH = os.path.join(RADIO, 'mesh-sauvegardes')     # ecrit par prometheus-radio avant chaque changement


def action_restaurer(texte):
    """{fichier: nom dans mesh-sauvegardes/ (ou sauvegardes/), auto: true si demande par le garde-fou}
    Remet tous les reglages d'une sauvegarde dans la radio de la station. Meshtastic : si la radio ne repond
    plus par le cable (reglage qui coupe la liaison), on reinstalle d'abord son logiciel, puis on remet tout."""
    try:
        r = json.loads(texte)
        nom = os.path.basename(str(r['fichier']))
    except (ValueError, KeyError, TypeError):
        raise Echec('Réglage invalide.')
    fichier = next((f for f in (os.path.join(SAUVE_MESH, nom), os.path.join(SAUVEGARDES, nom)) if os.path.isfile(f)), None)
    if not fichier:
        raise Echec('Sauvegarde introuvable : %s' % nom)
    reseau = 'meshcore' if nom.startswith('meshcore') else 'meshtastic'
    if reseau != reseau_actuel():
        raise Echec('Cette sauvegarde est pour %s : la station est sur %s.' % (reseau.capitalize(), reseau_actuel().capitalize()))
    if r.get('auto'):
        dire('== Garde-fou : la radio ne répond plus depuis un réglage risqué ; remise des réglages d’avant')
    dire('== Remise de la sauvegarde', nom)
    arreter_service()
    try:
        if reseau == 'meshtastic':
            try:
                attendre_meshtastic(essais=3, delai=30)
            except Echec:
                dire('   la radio ne répond pas par le câble : réinstallation de Meshtastic avant de remettre ses réglages')
                installer_station('meshtastic', complet=True)
                attendre_meshtastic()
            restaurer_meshtastic(fichier=fichier)
            dire('   la radio s’appelle :', attendre_meshtastic())
        else:
            bluetooth(True)
            s = json.load(open(fichier))

            async def remettre():
                mc = await meshcore_connecter(lire_json(RESEAU, {})['ble'])
                try:
                    # Les canaux crees depuis la sauvegarde partent (la sauvegarde dit tous ceux qui existaient)
                    gardes = {c['index'] for c in s.get('canaux', [])}
                    actuels = await meshcore_lire(mc)
                    for c in actuels['canaux']:
                        if c['index'] not in gardes and c['index']:
                            dire('   canal retiré :', c['nom'])
                            await mc.commands.set_channel(c['index'], '', b'\0' * 16)
                    await meshcore_ecrire(mc, s)
                    autres = s.get('autres') or {}
                    if autres:
                        infos = (await mc.commands.send_appstart()).payload or {}
                        infos.update({k: v for k, v in autres.items() if v is not None})
                        infos['manual_add_contacts'] = bool(infos.get('manual_add_contacts'))
                        await mc.commands.set_other_params_from_infos(infos)
                    await mc.commands.reboot()
                finally:
                    try:
                        await mc.disconnect()
                    except Exception:
                        pass
            asyncio.run(remettre())
            dire('   réglages MeshCore remis ; la radio redémarre')
    finally:
        relancer_service()


