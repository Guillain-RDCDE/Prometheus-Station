#!/usr/bin/env python3
# Prometheus Station - mot de passe des pages d'administration (Ajouter, Mises a jour).
# Un seul mot de passe, pas d'identifiant. Petit serveur interne (127.0.0.1:8091) interroge par nginx.
#   GET  /verif     -> 200 si le navigateur est connecte, 401 sinon (utilise par nginx)
#   GET  /etat      -> {"defini": true/false}
#   POST /premier   -> choisir le mot de passe, seulement s'il n'y en a pas encore
#   POST /connexion -> se connecter
#   POST /changer   -> changer le mot de passe (ancien + nouveau)
#   POST /theme     -> changer les couleurs de la station (immediat)
#   POST /wifi      -> renommer le wifi de la station (applique par le service prometheus-ssid)
#   GET  /sante     -> {temperature (degres), tension ('ok' / 'basse' / 'basse_avant'), allumee (secondes)}
#   GET  /energie   -> {sobre, extinction (minutes, 0 = jamais), restant (secondes ou null)}
#   POST /energie   -> {sobre: true/false} (applique par prometheus-sobre) et/ou {extinction: minutes}
# Pour tous les visiteurs (nginx : /api/...) :
#   GET  /api/messages          -> les messages du tableau, les plus recents d'abord
#   POST /api/messages          -> publier un message {nom, texte}
#   POST /api/messages/effacer  -> effacer un message {id} (administrateur connecte seulement)
#   POST /api/messages/vider    -> effacer tous les messages (administrateur connecte seulement)
#   POST /api/heure             -> heure du telephone {ms}, pour regler la station quand elle n'a pas internet
#   GET  /api/panneau           -> le texte du panneau d'accueil {texte}
#   GET  /api/reglages          -> ce qui est allume : annonce, registre, entraide, urgence (et leurs options)
#   GET  /api/registre          -> registre « sain et sauf / je cherche quelqu'un » (sans les cles)
#   POST /api/registre          -> ajouter une fiche {type: sauf|cherche, nom, lieu, message} -> {id, cle}
#   POST /api/registre/effacer  -> effacer une fiche {id, cle} (sa cle, ou administrateur connecte)
#   POST /api/registre/vider    -> tout effacer (administrateur connecte)
#   GET  /api/entraide          -> annonces d'entraide encore valables
#   POST /api/entraide          -> ajouter {type: cherche|propose, categorie, texte, nom, contact} -> {id, cle}
#   POST /api/entraide/effacer  -> effacer une annonce {id, cle} (sa cle, ou administrateur connecte)
#   POST /api/entraide/vider    -> tout effacer (administrateur connecte)
# Et pour l'administrateur connecte :
#   POST /panneau   -> enregistrer le texte du panneau d'accueil {texte}
#   POST /reglages  -> allumer, eteindre, regler une fonction {section, valeurs}
import hashlib, hmac, json, os, secrets, subprocess, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from http.cookies import SimpleCookie

DOSSIER = '/srv/prometheus/.admin'
MDP = os.path.join(DOSSIER, 'mot-de-passe')
SESSIONS = os.path.join(DOSSIER, 'sessions.json')
THEMES = '/var/www/prometheus/themes'
THEME_ACTIF = '/var/www/prometheus/theme.css'
THEME_CHOIX = os.path.join(DOSSIER, 'theme')
DUREE = 90 * 24 * 3600          # on reste connecte 90 jours
ESSAIS = {}                     # anti-devinette : adresse -> (nombre d'echecs, heure)
MESSAGES = '/srv/prometheus/messages/messages.json'
MAX_MESSAGES = 500
DERNIER_MESSAGE = {}            # adresse -> heure du dernier message (un message toutes les 20 s au plus)
VERROU = threading.Lock()
SOBRE = os.path.join(DOSSIER, 'sobre')                  # oui / non, ecrit par prometheus-sobre
EXTINCTION = '/run/prometheus/extinction'               # minutes ; /run est vide a chaque demarrage
EXTINCTION_RESTANT = '/run/prometheus/extinction-restant'
PANNEAU = '/srv/prometheus/panneau/panneau.txt'          # texte du panneau d'accueil

# Fonctions « communaute » : annonce, registre des personnes, entraide, page Urgence. Toutes eteintes au depart.
COMMUNAUTE = '/srv/prometheus/communaute'
REGLAGES = os.path.join(COMMUNAUTE, 'reglages.json')
REGISTRE = os.path.join(COMMUNAUTE, 'registre.json')
ENTRAIDE = os.path.join(COMMUNAUTE, 'entraide.json')
CATEGORIES = ['eau', 'nourriture', 'sante', 'abri', 'energie', 'transport', 'outils', 'competences', 'autre']
DEFAUT = {
    'annonce': {'active': False, 'texte': '', 'couleur': 'info', 'defile': True, 'vitesse': 'normale', 'ecran': False},
    'registre': {'active': False, 'lieu': True},
    'entraide': {'active': False, 'categories': CATEGORIES, 'duree': 72},
    'urgence': {'active': False},
}
CHOIX = {'couleur': ('info', 'important', 'urgent'), 'vitesse': ('lente', 'normale', 'rapide'), 'duree': (0, 24, 72, 168)}
MAX_FICHES = 2000
DERNIER_ENVOI = {}              # (adresse, fonction) -> heure du dernier envoi (un toutes les 20 s au plus)


def hacher(mdp, sel=None):
    sel = sel or secrets.token_hex(16)
    h = hashlib.pbkdf2_hmac('sha256', mdp.encode(), bytes.fromhex(sel), 200000).hex()
    return sel + ':' + h


def bon(mdp):
    try:
        sel, _ = open(MDP).read().strip().split(':')
    except (OSError, ValueError):
        return False
    return hmac.compare_digest(hacher(mdp, sel), open(MDP).read().strip())


def ecrire(chemin, texte):
    tmp = chemin + '.tmp'
    with open(tmp, 'w') as f:
        f.write(texte)
    os.chmod(tmp, 0o600)
    os.replace(tmp, chemin)


def sessions():
    try:
        s = json.load(open(SESSIONS))
    except (OSError, ValueError):
        s = {}
    now = time.time()
    return {k: v for k, v in s.items() if v > now}


def ecrire_public(chemin, texte):
    tmp = chemin + '.tmp'
    with open(tmp, 'w') as f:
        f.write(texte)
    os.chmod(tmp, 0o644)
    os.replace(tmp, chemin)


def lire_messages():
    try:
        return json.load(open(MESSAGES))
    except (OSError, ValueError):
        return []


def lire_fichier(chemin, defaut=''):
    try:
        return open(chemin).read().strip()
    except OSError:
        return defaut


def energie():
    demande = lire_fichier(os.path.join(DOSSIER, 'sobre-demande'))
    m = lire_fichier(EXTINCTION, '0')
    r = lire_fichier(EXTINCTION_RESTANT)
    return {'sobre': (demande or lire_fichier(SOBRE, 'non')) == 'oui',
            'extinction': int(m) if m.isdigit() else 0,
            'restant': int(r) if r.lstrip('-').isdigit() else None}


def reglages():
    """Les reglages des fonctions communaute, completes par les valeurs par defaut."""
    r = json.loads(json.dumps(DEFAUT))
    try:
        lu = json.load(open(REGLAGES))
    except (OSError, ValueError):
        lu = {}
    for section, valeurs in r.items():
        if isinstance(lu.get(section), dict):
            for k in valeurs:
                if k in lu[section]:
                    valeurs[k] = lu[section][k]
    return r


def regler(section, valeurs):
    """Verifie et enregistre une modification. Renvoie la section a jour, ou None si quelque chose est invalide."""
    tout = reglages()
    if section not in tout or not isinstance(valeurs, dict):
        return None
    s = tout[section]
    for k, v in valeurs.items():
        if k not in s:
            return None
        if isinstance(DEFAUT[section][k], bool):
            if not isinstance(v, bool):
                return None
        elif k == 'texte':
            v = ' '.join(str(v).split())[:200]
        elif k == 'categories':
            if not isinstance(v, list) or not all(c in CATEGORIES for c in v):
                return None
            v = [c for c in CATEGORIES if c in v]
        elif k in CHOIX:
            if v not in CHOIX[k] or isinstance(v, bool):
                return None
        s[k] = v
    os.makedirs(COMMUNAUTE, exist_ok=True)
    ecrire_public(REGLAGES, json.dumps(tout, ensure_ascii=False))
    return s


def lire_liste(chemin):
    try:
        return json.load(open(chemin))
    except (OSError, ValueError):
        return []


def entraide_valables(liste):
    """Les annonces d'entraide encore dans leur duree d'affichage (0 = sans limite)."""
    duree = reglages()['entraide']['duree']
    if not duree:
        return liste
    return [a for a in liste if time.time() - a.get('heure', 0) < duree * 3600]


def publique(fiche):
    return {k: v for k, v in fiche.items() if k != 'cle'}


def sante():
    """Temperature du processeur, tension (relevee par prometheus-tension), duree depuis l'allumage."""
    t = lire_fichier('/sys/class/thermal/thermal_zone0/temp')
    try:
        v = int(lire_fichier('/run/prometheus/tension'), 16)
    except ValueError:
        v = None
    # bit 0 : tension trop basse en ce moment ; bit 16 : elle l'a ete depuis l'allumage
    tension = None if v is None else 'basse' if v & 0x1 else 'basse_avant' if v & 0x10000 else 'ok'
    return {'temperature': round(int(t) / 1000) if t.isdigit() else None, 'tension': tension,
            'allumee': int(float(lire_fichier('/proc/uptime', '0').split()[0]))}


def regler_heure(ms):
    """Sans internet, le Pi ne sait pas l'heure (pas de pile) : on prend celle du telephone.
    Seulement si la station n'est pas a l'heure par internet et qu'elle a plus de 2 minutes d'ecart."""
    try:
        tel = float(ms) / 1000
    except (TypeError, ValueError):
        return False
    if not 1.7e9 < tel < 4.1e9 or abs(tel - time.time()) < 120:
        return False
    sync = subprocess.run(['timedatectl', 'show', '-p', 'NTPSynchronized', '--value'],
                          capture_output=True, text=True).stdout.strip()
    if sync == 'yes':
        return False
    # Le service a le droit de regler l'horloge (CAP_SYS_TIME, voir prometheus-admin.service)
    return subprocess.run(['date', '-s', '@%d' % tel], capture_output=True).returncode == 0


class Admin(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def repondre(self, code, donnees=None, cookie=None):
        corps = json.dumps(donnees or {}).encode()
        self.send_response(code)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Cache-Control', 'no-store')
        if cookie:
            self.send_header('Set-Cookie', cookie)
        self.send_header('Content-Length', str(len(corps)))
        self.end_headers()
        self.wfile.write(corps)

    def jeton(self):
        c = SimpleCookie(self.headers.get('Cookie', ''))
        return c['prometheus'].value if 'prometheus' in c else ''

    def connecte(self):
        j = self.jeton()
        return bool(j) and j in sessions()

    def ouvrir_session(self):
        s = sessions()
        j = secrets.token_urlsafe(32)
        s[j] = time.time() + DUREE
        ecrire(SESSIONS, json.dumps(s))
        return 'prometheus=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict' % (j, DUREE)

    def lire(self):
        n = int(self.headers.get('Content-Length') or 0)
        try:
            # 64 Ko au plus (le texte du panneau d'accueil) ; nginx limite deja les pages publiques a 4 Ko
            return json.loads(self.rfile.read(min(n, 65536)) or b'{}')
        except ValueError:
            return {}

    def do_GET(self):
        if self.path == '/api/messages':
            return self.repondre(200, {'messages': lire_messages(), 'maintenant': time.time(),
                                       'admin': self.connecte()})
        if self.path == '/api/panneau':
            return self.repondre(200, {'texte': lire_fichier(PANNEAU)})
        if self.path == '/api/reglages':
            return self.repondre(200, reglages())
        if self.path == '/api/registre':
            r = reglages()['registre']
            return self.repondre(200, {'fiches': [publique(f) for f in lire_liste(REGISTRE)], 'maintenant': time.time(),
                                       'admin': self.connecte(), 'active': r['active'], 'lieu': r['lieu']})
        if self.path == '/api/entraide':
            r = reglages()['entraide']
            return self.repondre(200, {'annonces': [publique(a) for a in entraide_valables(lire_liste(ENTRAIDE))],
                                       'maintenant': time.time(), 'admin': self.connecte(), 'active': r['active'],
                                       'categories': r['categories'], 'duree': r['duree']})
        if self.path == '/verif':
            self.repondre(200 if self.connecte() else 401)
        elif self.path == '/etat':
            self.repondre(200, {'defini': os.path.exists(MDP), 'connecte': self.connecte()})
        elif self.path == '/energie':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            self.repondre(200, energie())
        elif self.path == '/sante':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            self.repondre(200, sante())
        else:
            self.repondre(404)

    def do_POST(self):
        d = self.lire()
        ip = self.headers.get('X-Real-IP', '?')

        if self.path == '/api/messages':
            texte = ' '.join(str(d.get('texte', '')).split())[:500]
            nom = ' '.join(str(d.get('nom', '')).split())[:40]
            if not texte:
                return self.repondre(400, {'erreur': 'Message vide.'})
            if time.time() - DERNIER_MESSAGE.get(ip, 0) < 20:
                return self.repondre(429, {'erreur': 'Attendez quelques secondes avant le message suivant.'})
            DERNIER_MESSAGE[ip] = time.time()
            with VERROU:
                m = lire_messages()
                m.insert(0, {'id': secrets.token_hex(6), 'heure': time.time(), 'nom': nom, 'texte': texte})
                ecrire_public(MESSAGES, json.dumps(m[:MAX_MESSAGES], ensure_ascii=False))
            return self.repondre(200)

        if self.path == '/api/messages/effacer':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                m = [x for x in lire_messages() if x.get('id') != d.get('id')]
                ecrire_public(MESSAGES, json.dumps(m, ensure_ascii=False))
            return self.repondre(200)

        if self.path == '/api/messages/vider':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                ecrire_public(MESSAGES, '[]')
            return self.repondre(200)

        if self.path == '/api/heure':
            return self.repondre(200, {'regle': regler_heure(d.get('ms'))})

        # ----- Registre « sain et sauf / je cherche quelqu'un » et entraide « je cherche / je propose »
        if self.path in ('/api/registre', '/api/entraide'):
            fonction = self.path[5:]
            r = reglages()[fonction]
            if not r['active']:
                return self.repondre(403, {'erreur': 'Cette fonction est désactivée.'})
            def champ(nom, n):
                return ' '.join(str(d.get(nom, '')).split())[:n]
            if fonction == 'registre':
                fiche = {'type': d.get('type'), 'nom': champ('nom', 60), 'lieu': champ('lieu', 80) if r['lieu'] else '',
                         'message': champ('message', 300)}
                if fiche['type'] not in ('sauf', 'cherche') or len(fiche['nom']) < 2:
                    return self.repondre(400, {'erreur': 'Indiquez un nom.'})
                chemin = REGISTRE
            else:
                fiche = {'type': d.get('type'), 'categorie': d.get('categorie'), 'texte': champ('texte', 300),
                         'nom': champ('nom', 40), 'contact': champ('contact', 80)}
                if fiche['type'] not in ('cherche', 'propose') or fiche['categorie'] not in r['categories']:
                    return self.repondre(400, {'erreur': 'Réglage invalide.'})
                if not fiche['texte']:
                    return self.repondre(400, {'erreur': 'Message vide.'})
                chemin = ENTRAIDE
            if time.time() - DERNIER_ENVOI.get((ip, fonction), 0) < 20:
                return self.repondre(429, {'erreur': 'Attendez quelques secondes avant le message suivant.'})
            DERNIER_ENVOI[(ip, fonction)] = time.time()
            fiche.update({'id': secrets.token_hex(6), 'cle': secrets.token_urlsafe(16), 'heure': time.time()})
            with VERROU:
                liste = lire_liste(chemin)
                if fonction == 'entraide':
                    liste = entraide_valables(liste)   # les annonces perimees partent a cette occasion
                liste.insert(0, fiche)
                os.makedirs(COMMUNAUTE, exist_ok=True)
                ecrire_public(chemin, json.dumps(liste[:MAX_FICHES], ensure_ascii=False))
            return self.repondre(200, {'id': fiche['id'], 'cle': fiche['cle']})

        if self.path in ('/api/registre/effacer', '/api/entraide/effacer'):
            chemin = REGISTRE if 'registre' in self.path else ENTRAIDE
            admin = self.connecte()
            with VERROU:
                liste = lire_liste(chemin)
                garde = [f for f in liste if not (f.get('id') == d.get('id') and
                                                   (admin or hmac.compare_digest(str(f.get('cle', '')), str(d.get('cle', '')))))]
                if len(garde) == len(liste):
                    return self.repondre(403, {'erreur': 'Effacement refusé.'})
                ecrire_public(chemin, json.dumps(garde, ensure_ascii=False))
            return self.repondre(200)

        if self.path in ('/api/registre/vider', '/api/entraide/vider'):
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                ecrire_public(REGISTRE if 'registre' in self.path else ENTRAIDE, '[]')
            return self.repondre(200)

        echecs, quand = ESSAIS.get(ip, (0, 0))
        if echecs >= 5 and time.time() - quand < 60:
            return self.repondre(429, {'erreur': 'Trop d’essais. Attendez une minute.'})

        if self.path == '/premier':
            if os.path.exists(MDP):
                return self.repondre(403, {'erreur': 'Le mot de passe est déjà choisi.'})
            if len(d.get('nouveau', '')) < 4:
                return self.repondre(400, {'erreur': 'Au moins 4 caractères.'})
            ecrire(MDP, hacher(d['nouveau']))
            return self.repondre(200, {}, self.ouvrir_session())

        if self.path == '/connexion':
            if bon(d.get('mdp', '')):
                ESSAIS.pop(ip, None)
                return self.repondre(200, {}, self.ouvrir_session())
            ESSAIS[ip] = (echecs + 1, time.time())
            return self.repondre(401, {'erreur': 'Mot de passe incorrect.'})

        if self.path == '/changer':
            if not self.connecte() or not bon(d.get('ancien', '')):
                ESSAIS[ip] = (echecs + 1, time.time())
                return self.repondre(401, {'erreur': 'Ancien mot de passe incorrect.'})
            if len(d.get('nouveau', '')) < 4:
                return self.repondre(400, {'erreur': 'Au moins 4 caractères.'})
            ecrire(MDP, hacher(d['nouveau']))
            ecrire(SESSIONS, '{}')   # deconnecte tous les autres appareils
            return self.repondre(200, {}, self.ouvrir_session())

        if self.path == '/theme':
            nom = os.path.basename(str(d.get('nom', '')))
            source = os.path.join(THEMES, nom + '.css')
            if not self.connecte() or not os.path.isfile(source):
                return self.repondre(400, {'erreur': 'Couleurs inconnues.'})
            with open(THEME_ACTIF, 'w') as f:
                f.write(open(source).read())
            with open(THEME_CHOIX, 'w') as f:
                f.write(nom)
            return self.repondre(200)

        if self.path == '/wifi':
            nom = str(d.get('nom', '')).strip()
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            if not 1 <= len(nom.encode()) <= 32 or any(ord(c) < 32 for c in nom):
                return self.repondre(400, {'erreur': 'Entre 1 et 32 caractères.'})
            ecrire(os.path.join(DOSSIER, 'ssid-demande'), nom)
            return self.repondre(200)

        if self.path == '/reglages':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            with VERROU:
                s = regler(d.get('section'), d.get('valeurs'))
            if s is None:
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            return self.repondre(200, s)

        if self.path == '/panneau':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            texte = str(d.get('texte', '')).replace('\r\n', '\n')
            if len(texte) > 20000:
                return self.repondre(400, {'erreur': 'Texte trop long.'})
            ecrire_public(PANNEAU, texte)
            return self.repondre(200)

        if self.path == '/energie':
            if not self.connecte():
                return self.repondre(401, {'erreur': 'Connectez-vous d’abord.'})
            m = d.get('extinction')
            if m is not None and (type(m) is not int or not 0 <= m <= 1440):
                return self.repondre(400, {'erreur': 'Réglage invalide.'})
            if 'sobre' in d:
                ecrire(os.path.join(DOSSIER, 'sobre-demande'), 'oui' if d['sobre'] is True else 'non')
            if m is not None:
                ecrire_public(EXTINCTION, str(m))
                # Le compte repart de maintenant (le surveillant le tiendra a jour dans les 30 secondes)
                if m:
                    ecrire_public(EXTINCTION_RESTANT, str(m * 60))
                elif os.path.exists(EXTINCTION_RESTANT):
                    os.remove(EXTINCTION_RESTANT)
            return self.repondre(200, energie())

        self.repondre(404)


if __name__ == '__main__':
    os.makedirs(DOSSIER, mode=0o700, exist_ok=True)
    ThreadingHTTPServer(('127.0.0.1', 8091), Admin).serve_forever()
