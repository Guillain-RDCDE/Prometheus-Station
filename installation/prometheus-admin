def fusionner_radio():
    """Range dans le tableau ce que prometheus-radio a recu ou emis. A appeler sous VERROU."""
    recus = sorted(glob.glob(os.path.join(RADIO, 'recus', '*.json')))
    partis = sorted(glob.glob(os.path.join(RADIO, 'partis', '*.json')))
    if not recus and not partis:
        return
    m = lire_messages()
    for f in recus:
        try:
            r = json.load(open(f))
            m.insert(0, {'id': secrets.token_hex(6), 'heure': float(r['heure']), 'nom': str(r.get('nom', ''))[:40],
                         'texte': str(r['texte'])[:500], 'radio': 'recu'})
        except (OSError, ValueError, KeyError, TypeError):
            pass
    ids = set()
    for f in partis:
        try:
            ids.add(json.load(open(f)).get('id'))
        except (OSError, ValueError):
            pass
    for x in m:
        if x.get('id') in ids:
            x['radio'] = 'parti'
    m.sort(key=lambda x: -x.get('heure', 0))
    ecrire_public(MESSAGES, json.dumps(m[:MAX_MESSAGES], ensure_ascii=False))
    for f in recus + partis:
        try:
            os.remove(f)
        except OSError:
            pass


def annuler_radio(ids=None):
    """Retire de la file de la radio les messages pas encore partis (tous, ou ceux de la liste ids). Renvoie combien."""
    n = 0
    for f in glob.glob(os.path.join(RADIO, 'a-envoyer', '*.json')):
        if ids is None or os.path.basename(f)[:-5].split('-', 1)[-1] in ids:
            try:
                os.remove(f)
                n += 1
            except OSError:
                pass
    return n


