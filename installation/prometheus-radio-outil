def telecharger(url, attendu=None):
    req = urllib.request.Request(url, headers={'User-Agent': 'prometheus-station'})
    with urllib.request.urlopen(req, timeout=60) as r:
        donnees = r.read()
    if attendu and hashlib.sha256(donnees).hexdigest() != attendu:
        raise Echec('Fichier abîmé pendant le téléchargement : ' + url.rsplit('/', 1)[-1])
    return donnees


def github(depot):
    return json.loads(telecharger('https://api.github.com/repos/%s/releases?per_page=30' % depot))


def empreinte(asset):
    d = asset.get('digest') or ''
    return d[7:] if d.startswith('sha256:') else None


def manquants(reseau, d, puces):
    """Les motifs de MOTIFS[reseau] dont aucun fichier n'est encore dans le dossier d."""
    noms = os.listdir(d) if os.path.isdir(d) else []
    res = []
    for cle, motif in MOTIFS[reseau].items():
        for p in (puces if '{puce}' in motif else [None]):
            m = motif.replace('{puce}', p or '')
            if not any(re.match(m, n) for n in noms):
                res.append(m)
    return res


def action_chercher(_):
    puce = lire_json(RESEAU, {}).get('puce')
    puces = [puce] if puce else ['SX1276', 'SX1262']
    dire('== Recherche des dernières versions stables (internet)')
    nouveautes = []
    # Meshtastic : la derniere version qui n'est pas une « alpha » (pre-release)
    r = next(x for x in github('meshtastic/firmware') if not x['prerelease'] and not x['draft'])
    v = r['tag_name'].lstrip('v')
    d = os.path.join(LOGICIELS, 'meshtastic', v)
    manque = manquants('meshtastic', d, puces)
    if not manque:
        dire('   Meshtastic', v, ': déjà sur la station, complet')
    else:
        nouveau = not os.path.isdir(d)
        dire('   Meshtastic', v, ': téléchargement…' if nouveau else ': fichiers à compléter…')
        os.makedirs(d, exist_ok=True)
        for prefixe in ('firmware-esp32-', 'firmware-nrf52840-'):
            a = next(x for x in r['assets'] if x['name'].startswith(prefixe) and x['name'].endswith('.zip'))
            # on ne telecharge le gros paquet que s'il contient un fichier qui manque
            if prefixe == 'firmware-esp32-' and not any('tbeam' in m for m in manque):
                continue
            if prefixe == 'firmware-nrf52840-' and not any('t-echo' in m for m in manque):
                continue
            dire('     ', a['name'], '(%d Mo)' % (a['size'] // 1000000))
            z = zipfile.ZipFile(io.BytesIO(telecharger(a['browser_download_url'], empreinte(a))))
            for n in z.namelist():
                b = os.path.basename(n)
                if any(re.match(m, b) for m in manque) or re.match(r'^firmware-t-echo-inkhud-.*\.uf2$', b):
                    with open(os.path.join(d, b), 'wb') as f:
                        f.write(z.read(n))
                    dire('       gardé :', b)
        if nouveau:
            nouveautes.append('Meshtastic ' + v)
    # MeshCore : la derniere version « companion »
    r = next(x for x in github('meshcore-dev/MeshCore') if x['tag_name'].startswith('companion-v') and not x['prerelease'] and not x['draft'])
    v = r['tag_name'][len('companion-v'):]
    d = os.path.join(LOGICIELS, 'meshcore', v)
    manque = manquants('meshcore', d, puces)
    if not manque:
        dire('   MeshCore', v, ': déjà sur la station, complet')
    else:
        nouveau = not os.path.isdir(d)
        dire('   MeshCore', v, ': téléchargement…' if nouveau else ': fichiers à compléter…')
        os.makedirs(d, exist_ok=True)
        for a in r['assets']:
            if any(re.match(m, a['name']) for m in manque):
                with open(os.path.join(d, a['name']), 'wb') as f:
                    f.write(telecharger(a['browser_download_url'], empreinte(a)))
                dire('       gardé :', a['name'])
        if nouveau:
            nouveautes.append('MeshCore ' + v)
    dire('   nouvelles versions :', ', '.join(nouveautes) if nouveautes else 'aucune')
    # Atelier : catalogue des cartes et logiciels des cartes suivies (une panne ici n'empeche pas le reste)
    try:
        chercher_catalogue()
    except Exception as e:
        dire('!! Catalogue de l’atelier non mis à jour :', e)
    # On garde les deux dernieres versions de chaque reseau
    for reseau in ('meshtastic', 'meshcore'):
        for vieux in versions(reseau)[GARDER_VERSIONS:]:
            shutil.rmtree(os.path.join(LOGICIELS, reseau, vieux))
            dire('   ancienne version retirée :', reseau, vieux)


# ---------------------------------------------------------------- les T-Echo branches en USB
# Un T-Echo se reconnait a son numero de serie (le meme sous Meshtastic, MeshCore ou en mode mise a jour) ;
# le nom de son port, lui, change selon le logiciel :
#   ...TTGO_eink_<serie>    Meshtastic
#   ...NRF52_DK_<serie>     MeshCore (version « usb » ou « ble »)
#   ...T-Echo_v1_<serie>    son programme de demarrage (mode mise a jour), avec ou sans disque TECHOBOOT
DISQUE_MAJ = '/dev/disk/by-label/TECHOBOOT'     # JAMAIS un autre disque (15/10/2026 : « bootfs » est celui du Pi)
DETAILS_RADIOS = os.path.join(RADIO, 'radios.json')   # ce que la station sait des T-Echo vus (par numero de serie)
NOMS_VERSION = {'meshtastic': 'Meshtastic', 'meshtastic-inkhud': 'Meshtastic (InkHUD)', 'meshcore-ble': 'MeshCore (téléphone)',
                'meshcore-usb': 'MeshCore (station)'}


def radios_branchees():
    """Les radios en USB autres que celle de la station (les T-Echo)."""
    try:
        station = port_station()
    except Echec:
        station = None
    return [p for p in sorted(glob.glob('/dev/serial/by-id/*')) if p != station]


def serie_de(port):
    m = re.search(r'_([0-9A-Fa-f]{12,})-if\d+$', port)
    return m.group(1).upper() if m else None


def port_de(serie):
    for p in radios_branchees():
        if serie_de(p) == serie:
            return p
    return None


def genre_du_port(port):
    if 'TTGO_eink' in port:
        return 'meshtastic'
    if 'NRF52_DK' in port:
        return 'meshcore'
    if 'T-Echo_v1' in port:
        return 'demarrage'
    return 'inconnu'


async def meshcore_serie(port, attente=12):
    from meshcore import MeshCore
    try:
        return await asyncio.wait_for(MeshCore.create_serial(port, 115200, default_timeout=8), attente)
    except Exception:
        return None


def reconnaitre(port):
    """Ce qu'il y a dans le T-Echo : {serie, port, logiciel, nom, version}."""
    r = {'serie': serie_de(port), 'port': os.path.basename(port), 'logiciel': genre_du_port(port), 'nom': '', 'version': ''}
    if r['logiciel'] == 'meshtastic':
        code, sortie = mt('--info', montrer=False, delai=60, port=port)
        m = re.search(r'Owner: (.+?) \(', sortie)
        v = re.search(r'"firmwareVersion": "([^"]+)"', sortie)
        r.update(nom=m.group(1) if m else '', version=v.group(1) if v else '')
        if not m:
            r['logiciel'] = 'meshtastic-muet'
    elif r['logiciel'] == 'meshcore':
        async def lire():
            mc = await meshcore_serie(port)
            if not mc:
                return None
            try:
                from meshcore import EventType
                info = await mc.commands.send_device_query()
                return (mc.self_info or {}).get('name', ''), info.payload.get('ver', '') if info.type == EventType.DEVICE_INFO else ''
            finally:
                await mc.disconnect()
        lu = asyncio.run(lire())
        if lu:
            r.update(logiciel='meshcore-usb', nom=lu[0], version=lu[1].lstrip('v').split('-')[0])
        else:
            # La version « ble » ne repond pas par le cable : on ne peut pas la lire d'ici
            r['logiciel'] = 'meshcore-ble'
    return r


def noter_radio(r):
    tout = lire_json(DETAILS_RADIOS, {})
    tout[r['serie']] = dict(tout.get(r['serie'], {}), **{k: v for k, v in r.items() if v}, heure=time.time())
    ecrire_json(DETAILS_RADIOS, tout)


def action_detecter(_):
    branchees = radios_branchees()
    if not branchees:
        dire('   aucune radio branchée en USB à part celle de la station')
    for p in branchees:
        r = reconnaitre(p)
        noter_radio(r)
        dire('   %s : %s %s %s' % (r['port'], NOMS_VERSION.get(r['logiciel'], r['logiciel']), r['version'], r['nom']))


def attendre(test, secondes, pas=1):
    fin = time.time() + secondes
    while time.time() < fin:
        r = test()
        if r:
            return r
        time.sleep(pas)
    return None


def vers_demarrage(serie, logiciel):
    """Met le T-Echo dans son programme de demarrage (mode mise a jour). Sous Meshtastic : par une commande ;
    sous MeshCore : seulement a la main (double appui sur reset), la station attend."""
    def en_demarrage():
        p = port_de(serie)
        return (p and genre_du_port(p) == 'demarrage') or os.path.exists(DISQUE_MAJ)
    if en_demarrage():
        return
    if logiciel == 'meshtastic':
        dire('   passage en mode mise à jour…')
        mt('--enter-dfu', montrer=False, delai=60, port=port_de(serie))
        if attendre(en_demarrage, 40):
            return
    dire('== APPUYEZ DEUX FOIS RAPIDEMENT SUR LE BOUTON RESET DU T-ECHO (en haut à gauche) : son écran se fige')
    dire('   (la station attend 5 minutes au plus)')
    if not attendre(en_demarrage, 300):
        raise Echec('Le T-Echo n’est pas passé en mode mise à jour.')
    dire('   T-Echo en mode mise à jour')


def ecrire_t_echo(serie, uf2, paquet):
    """Installe un logiciel dans un T-Echo en mode mise a jour : copie du .uf2 sur son disque TECHOBOOT, ou, si le
    disque n'apparait pas, installation par le port serie avec le paquet .zip (adafruit-nrfutil)."""
    if attendre(lambda: os.path.exists(DISQUE_MAJ), 15):
        point = '/run/prometheus-uf2'
        os.makedirs(point, exist_ok=True)
        if subprocess.run(['mount', DISQUE_MAJ, point]).returncode != 0:
            raise Echec('Impossible d’ouvrir le disque du T-Echo.')
        try:
            dire('   copie de', os.path.basename(uf2), 'sur le disque du T-Echo')
            shutil.copyfile(uf2, os.path.join(point, os.path.basename(uf2)))
            os.sync()
        finally:
            subprocess.run(['umount', point], capture_output=True)
    else:
        p = port_de(serie)
        if not p or genre_du_port(p) != 'demarrage':
            raise Echec('Le T-Echo n’est pas en mode mise à jour.')
        dire('   pas de disque : installation par le port série (', os.path.basename(paquet), ')')
        code, _ = lancer([os.path.join(BIN, 'adafruit-nrfutil'), 'dfu', 'serial', '--package', paquet, '-p', p,
                          '-b', '115200', '--singlebank'], delai=300)
        if code != 0:
            raise Echec('L’installation par le port série a échoué.')
    dire('   écrit ; le T-Echo redémarre')
    # il revient avec un nouveau port (Meshtastic ou MeshCore)
    if not attendre(lambda: (port_de(serie) and genre_du_port(port_de(serie)) not in ('demarrage', 'inconnu')), 90, 2):
        raise Echec('Le T-Echo ne revient pas après l’installation.')
    time.sleep(10)


def fichiers_t_echo(cible):
    if cible == 'meshtastic':
        return fichier_logiciel('meshtastic', 't-echo'), fichier_logiciel('meshtastic', 't-echo-zip')[0]
    if cible == 'meshtastic-inkhud':
        return fichier_logiciel('meshtastic', 't-echo-inkhud'), fichier_logiciel('meshtastic', 't-echo-inkhud-zip')[0]
    v = 'ble' if cible == 'meshcore-ble' else 'usb'
    return fichier_logiciel('meshcore', 't-echo-' + v), fichier_logiciel('meshcore', 't-echo-%s-zip' % v)[0]


async def meshcore_serie_regler(port, sauvegarde, nom):
    """Version « usb » : remet l'identite et les reglages MeshCore sauvegardes (ou ceux de depart), puis
    renvoie ce qu'il faut garder (identite comprise)."""
    mc = await meshcore_serie(port, 20)
    if not mc:
        raise Echec('Le T-Echo ne répond pas sous MeshCore.')
    try:
        if os.path.exists(sauvegarde):
            dire('== Remise des réglages MeshCore de ce T-Echo (identité, contacts, canaux)')
            s = json.load(open(sauvegarde))
        else:
            dire('== Premiers réglages MeshCore (réglage européen conseillé)')
            s = dict(MESHCORE_EU, nom=nom)
        await meshcore_ecrire(mc, s)
        await mc.commands.reboot()
    finally:
        await mc.disconnect()
    time.sleep(12)
    mc = await meshcore_serie(port_de(serie_de(port)) or port, 20)
    if not mc:
        raise Echec('Le T-Echo ne répond plus sous MeshCore après ses réglages.')
    try:
        lu = await meshcore_lire(mc)
        dire('   le T-Echo s’appelle :', lu['nom'], '— %s MHz, %s kHz, SF%s, CR%s' % (lu['freq'], lu['bw'], lu['sf'], lu['cr']))
        await mc.commands.send_advert(flood=True)
        return lu
    finally:
        await mc.disconnect()


def action_t_echo(texte):
    """{radio: nom du port, cible: meshtastic | meshtastic-inkhud | meshcore-ble | meshcore-usb | maj}
    Meshtastic et Meshtastic (InkHUD) sont le meme reseau, avec les memes reglages : seule l'interface de
    l'ecran change. La station note laquelle a chaque T-Echo (radios.json, « interface »)."""
    try:
        r = json.loads(texte)
        port = '/dev/serial/by-id/' + os.path.basename(str(r['radio']))
        cible = str(r['cible'])
        assert cible in ('meshtastic', 'meshtastic-inkhud', 'meshcore-ble', 'meshcore-usb', 'maj')
    except (ValueError, KeyError, TypeError, AssertionError):
        raise Echec('Réglage invalide.')
    if port not in radios_branchees():
        raise Echec('Cette radio n’est plus branchée.')
    serie = serie_de(port)
    if not serie:
        raise Echec('Radio inconnue (pas de numéro de série).')
    avant = lire_json(DETAILS_RADIOS, {}).get(serie, {})
    actuel = reconnaitre(port)
    depart = actuel['logiciel']
    if depart == 'demarrage':
        # Deja en mode mise a jour (reset appuye avant de lancer) : on part de ce qu'il avait juste avant
        depart = avant.get('logiciel', 'demarrage')
        actuel.update(nom=avant.get('nom', ''))
        dire('   T-Echo déjà en mode mise à jour (avant : %s)' % NOMS_VERSION.get(depart, 'inconnu'))
    else:
        noter_radio(actuel)
    if depart in ('meshtastic-muet', 'inconnu'):
        raise Echec('Ce T-Echo ne répond pas : débranchez-le, rebranchez-le et réessayez.')
    if cible == 'maj':
        cible = depart if depart != 'demarrage' else 'meshtastic'
        if cible == 'meshtastic' and avant.get('interface') == 'inkhud':
            cible = 'meshtastic-inkhud'          # une mise a jour garde l'interface choisie
    meshtastic_cible = cible.startswith('meshtastic')
    dire('== T-Echo %s : %s → %s' % (serie[-6:], NOMS_VERSION.get(depart, 'mode mise à jour'), NOMS_VERSION[cible]))
    ici = lambda: port_de(serie)
    sauve_mt = 't-echo-%s-meshtastic' % serie
    sauve_mc = os.path.join(SAUVEGARDES, 't-echo-%s-meshcore-dernier.json' % serie)
    nom = actuel['nom'] or 'T-Echo ' + serie[-4:]

    # 1. Garder ce qui peut l'etre du logiciel actuel (impossible s'il est deja en mode mise a jour :
    #    on garde alors la derniere sauvegarde)
    if actuel['logiciel'] == 'demarrage':
        dire('   (déjà en mode mise à jour : la dernière sauvegarde de ce T-Echo sera utilisée)')
    elif depart == 'meshtastic':
        sauvegarder_meshtastic(port, sauve_mt)
    elif depart == 'meshcore-usb':
        async def garder():
            mc = await meshcore_serie(port, 20)
            if not mc:
                return None
            try:
                return await meshcore_lire(mc)
            finally:
                await mc.disconnect()
        s = asyncio.run(garder())
        if s:
            ranger_sauvegarde('t-echo-%s-meshcore.json' % serie, json.dumps(s, ensure_ascii=False, indent=1))
            dire('   réglages MeshCore gardés (identité comprise)')
    elif depart == 'meshcore-ble':
        dire('   (version « téléphone » : la station ne peut pas la lire par le câble ; son identité MeshCore,',
             'si elle a été gardée lors de son installation, sera remise)')

    # 2. Installer. Vers MeshCore depuis autre chose, on passe toujours par la version « usb » : c'est elle qui
    #    permet a la station de poser l'identite et les reglages ; la version « ble » les reprend telle quelle.
    etapes = []
    if meshtastic_cible:
        etapes = [cible]
    elif cible == 'meshcore-usb' or depart not in ('meshcore-usb', 'meshcore-ble'):
        etapes = ['meshcore-usb'] + (['meshcore-ble'] if cible == 'meshcore-ble' else [])
    else:
        etapes = [cible]          # usb <-> ble, ou mise a jour de la meme version : la memoire MeshCore reste
    logiciel = depart
    for etape in etapes:
        (uf2, version), paquet = fichiers_t_echo(etape)
        dire('== Installation de %s %s' % (NOMS_VERSION[etape], version))
        vers_demarrage(serie, logiciel)
        ecrire_t_echo(serie, uf2, paquet)
        logiciel = etape
        if etape == 'meshcore-usb' and (len(etapes) > 1 or depart not in ('meshcore-usb', 'meshcore-ble')):
            s = asyncio.run(meshcore_serie_regler(ici(), sauve_mc, nom))
            ranger_sauvegarde('t-echo-%s-meshcore.json' % serie, json.dumps(s, ensure_ascii=False, indent=1))
            dire('   réglages MeshCore gardés (identité comprise)')

    # 3. Retour sous Meshtastic depuis MeshCore : effacer ce qui reste de MeshCore, puis remettre ses reglages
    # (Logiciel d'avant inconnu, T-Echo arrive deja en mode mise a jour : on n'efface jamais une radio dont la
    #  station n'a pas de sauvegarde ; vu le 19/10/2026 avec le T-Echo blanc)
    if meshtastic_cible and depart not in ('meshtastic', 'demarrage'):
        dire('== Remise à zéro de Meshtastic (efface ce qui reste de MeshCore)')
        mt('--factory-reset-device', montrer=False, delai=60, port=ici())
        time.sleep(20)
        try:
            attendre_meshtastic(essais=4, port=ici, delai=25)   # souvent muet ensuite : on demande vite un reset
        except Echec:
            dire('== APPUYEZ UNE FOIS SUR LE BOUTON RESET DU T-ECHO (il ne répond plus après la remise à zéro)')
            if not attendre(lambda: ici() and mt('--info', montrer=False, delai=40, port=ici())[0] == 0, 300, 5):
                raise Echec('Le T-Echo ne répond pas sous Meshtastic.')
        restaurer_meshtastic(port=ici, nom=sauve_mt)
    if meshtastic_cible:
        dire('   le T-Echo répond :', attendre_meshtastic(port=ici))
    fin = reconnaitre(ici())
    if meshtastic_cible:
        fin['interface'] = 'inkhud' if cible == 'meshtastic-inkhud' else 'standard'
    noter_radio(fin)
    dire('== Le T-Echo est sous', NOMS_VERSION.get(cible if meshtastic_cible else fin['logiciel'], fin['logiciel']),
         fin['version'], fin['nom'])


